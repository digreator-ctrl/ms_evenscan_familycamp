  <script>
    import { DATA_WILAYAH, LIST_PROVINSI } from "../data/wilayah";

    const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:8787";

    interface AnggotaItem {
      nama: string;
      peran: string;
      jenis_kelamin: string;
      usia: number | null;
      ukuran_kaos: string;
      catatan_medis: string;
      beda_domisili?: boolean;
      provinsi?: string;
      kota?: string;
    }

    interface PaketBundleItem {
      id: string;
      nama: string;
      harga: number;
      fasilitas: string[];
    }

    let currentStep = 1;

    // Katalog paket & satuan diisi dari API admin (fallback bawaan bila API gagal).
    let PAKET_BUNDLES: PaketBundleItem[] = [
      {
        id: "addon_paket_a",
        nama: "Paket A",
        harga: 120000,
        fasilitas: [
          "1 Tenda Dome",
          "4 Matras Spon",
          "4 Sleeping Bag Hangat",
          "1 Lampu Tenda LED",
        ],
      },
      {
        id: "addon_paket_b",
        nama: "Paket B",
        harga: 110000,
        fasilitas: [
          "1 Tenda Dome",
          "3 Matras Spon",
          "3 Sleeping Bag Hangat",
          "1 Lampu Tenda LED",
        ],
      },
      {
        id: "addon_paket_c",
        nama: "Paket C",
        harga: 100000,
        fasilitas: [
          "1 Tenda Dome",
          "2 Matras Spon",
          "2 Sleeping Bag Hangat",
          "1 Lampu Tenda LED",
        ],
      },
    ];

    let selectedPaketQty: { [addonId: string]: number } = {};

    let anggotaData: AnggotaItem[] = [
      {
        nama: "",
        peran: "",
        jenis_kelamin: "Ikhwan",
        usia: null,
        ukuran_kaos: "-",
        catatan_medis: "",
        beda_domisili: false,
        provinsi: "",
        kota: "",
      },
    ];

    function getLockedGenderForPeran(
      peran: string,
    ): "Ikhwan" | "Akhwat" | null {
      if (["Ayah", "Suami", "Kakek", "Paman"].includes(peran)) return "Ikhwan";
      if (["Ibu", "Istri", "Nenek", "Bibi"].includes(peran)) return "Akhwat";
      return null; // Anak, Saudara Kandung, Sepupu, Peserta -> bebas pilih
    }

    let toastTimeout: any = null;
    function showFloatingToast(message: string, isError = true) {
      const toast = document.getElementById("floatingToast");
      const msgEl = document.getElementById("floatingToastMsg");
      const iconEl = document.getElementById("floatingToastIcon");
      if (!toast || !msgEl || !iconEl) return;

      if (toastTimeout) {
        clearTimeout(toastTimeout);
      }

      msgEl.textContent = message;
      if (isError) {
        iconEl.className =
          "w-5 h-5 shrink-0 text-rose-400 flex items-center justify-center";
        iconEl.innerHTML = `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>`;
      } else {
        iconEl.className =
          "w-5 h-5 shrink-0 text-emerald-400 flex items-center justify-center";
        iconEl.innerHTML = `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>`;
      }

      toast.classList.remove("opacity-0", "-translate-y-4", "scale-95");
      toast.classList.add("opacity-100", "translate-y-0", "scale-100");

      toastTimeout = setTimeout(() => {
        toast.classList.remove("opacity-100", "translate-y-0", "scale-100");
        toast.classList.add("opacity-0", "-translate-y-4", "scale-95");
      }, 3500);
    }

    function markInvalid(element: HTMLElement | null) {
      if (!element) return;
      element.classList.remove(
        "border-slate-300",
        "focus:border-primary-600",
        "focus:ring-primary-500/20",
      );
      element.classList.add(
        "!border-rose-500",
        "!ring-2",
        "!ring-rose-200",
        "bg-rose-50/30",
      );
    }

    function clearInvalid(element: HTMLElement | null) {
      if (!element) return;
      element.classList.remove(
        "!border-rose-500",
        "!ring-2",
        "!ring-rose-200",
        "bg-rose-50/30",
      );
      element.classList.add(
        "border-slate-300",
        "focus:border-primary-600",
        "focus:ring-primary-500/20",
      );
    }

    function bindClearOnInput(element: HTMLElement | null) {
      if (!element) return;
      const handler = () => {
        clearInvalid(element);
        element.removeEventListener("input", handler);
        element.removeEventListener("change", handler);
      };
      element.addEventListener("input", handler);
      element.addEventListener("change", handler);
    }

    async function initFamilyCampForm() {
      const form = document.getElementById("formFamilyCamp");
      if (!form) return;
      if (form.dataset.initialized === "true") return;
      form.dataset.initialized = "true";

      checkQuotaStatus();
      await fetchAddonCatalog();
      setupWilayahSelector();
      setupStepNavigation();
      renderAnggotaForms();
      setupAddonInteractions();
      setupFinalSubmit();
    }

    function setupWilayahSelector() {
      const picProvinsiInput = document.getElementById(
        "pic_provinsi",
      ) as HTMLInputElement | null;
      const picKotaInput = document.getElementById(
        "pic_kota",
      ) as HTMLInputElement | null;
      const listKota = document.getElementById(
        "listKota",
      ) as HTMLDataListElement | null;

      if (!picProvinsiInput || !picKotaInput) return;

      // Isi saran kota berdasarkan provinsi yang diketik (bila cocok dengan data wilayah).
      const refreshKotaSuggestions = () => {
        if (!listKota) return;
        const prov = picProvinsiInput.value.trim();
        const kotaList = DATA_WILAYAH[prov] || [];
        listKota.innerHTML = kotaList
          .map((kota) => `<option value="${kota}"></option>`)
          .join("");
      };

      // Saran awal: gabungan semua kota agar peserta tetap bisa memilih meski provinsi belum pas.
      if (listKota && !listKota.childElementCount) {
        const allKota = new Set<string>();
        Object.values(DATA_WILAYAH).forEach((arr) =>
          (arr as string[]).forEach((k) => allKota.add(k)),
        );
        listKota.innerHTML = Array.from(allKota)
          .sort()
          .map((kota) => `<option value="${kota}"></option>`)
          .join("");
      }

      picProvinsiInput.addEventListener("input", () => {
        clearInvalid(picProvinsiInput);
        refreshKotaSuggestions();
      });

      picKotaInput.addEventListener("input", () => {
        clearInvalid(picKotaInput);
      });
    }

    async function checkQuotaStatus() {
      try {
        const res = await fetch(`${API_URL}/api/peserta/config`);
        const config = await res.json();
        if (config && config.pendaftaran_buka === false) {
          const banner = document.getElementById("closedBanner");
          const form = document.getElementById("formFamilyCamp");
          const wizard = document.getElementById("wizardHeader");
          if (banner) banner.classList.remove("hidden");
          if (form) form.classList.add("hidden");
          if (wizard) wizard.classList.add("hidden");
        }
      } catch (err) {}
    }

    async function fetchAddonCatalog() {
      try {
        const res = await fetch(`${API_URL}/api/peserta/addon-items`);
        const json = await res.json();
        if (res.ok && Array.isArray(json.data) && json.data.length > 0) {
          const paket = json.data
            .filter((item: any) => item.kategori === "paket")
            .map((item: any) => ({
              id: item.id,
              nama: item.nama,
              harga: item.harga,
              fasilitas: Array.isArray(item.fasilitas) ? item.fasilitas : [],
            }));

          // Gunakan katalog dari API bila tersedia (paket dipertahankan jika API tak mengirim paket).
          if (paket.length > 0) PAKET_BUNDLES = paket;
        }
      } catch (err) {
        console.warn("Gagal load addon items:", err);
      }
      renderAddonsCatalog();
    }

    function renderAddonsCatalog() {
      const list = document.getElementById("listPaketBundles");
      if (!list) return;

      if (PAKET_BUNDLES.length === 0) {
        list.innerHTML = `<tr><td colspan="3" class="px-3 py-4 text-center text-slate-400 text-xs italic">Belum ada paket tenda tersedia.</td></tr>`;
        return;
      }

      list.innerHTML = PAKET_BUNDLES.map((item) => {
        const qty = selectedPaketQty[item.id] || 0;
        const fasilitasHtml =
          item.fasilitas && item.fasilitas.length > 0
            ? `<div class="text-[10px] text-slate-500 mt-1">${item.fasilitas.join(" • ")}</div>`
            : "";
        return `
          <tr class="bg-white">
            <td class="px-3 py-2.5">
              <span class="font-extrabold text-slate-900 text-xs">${item.nama}</span>
              ${fasilitasHtml}
            </td>
            <td class="px-3 py-2.5 text-right whitespace-nowrap align-top">
              <span class="font-black text-primary-700 font-mono text-xs">Rp ${item.harga.toLocaleString("id-ID")}</span>
            </td>
            <td class="px-3 py-2.5 align-top">
              <div class="flex items-center justify-center gap-1.5">
                <button
                  type="button"
                  class="btn-paket-dec w-7 h-7 rounded-lg bg-white border border-slate-300 text-slate-700 font-bold hover:bg-slate-100 flex items-center justify-center transition active:scale-95 cursor-pointer disabled:opacity-30 disabled:cursor-not-allowed"
                  data-id="${item.id}"
                  ${qty === 0 ? "disabled" : ""}
                >-</button>
                <span class="w-6 text-center font-bold text-xs font-mono paket-qty-text" data-id="${item.id}">${qty}</span>
                <button
                  type="button"
                  class="btn-paket-inc w-7 h-7 rounded-lg bg-primary-600 text-white font-bold hover:bg-primary-700 flex items-center justify-center transition active:scale-95 cursor-pointer"
                  data-id="${item.id}"
                >+</button>
              </div>
            </td>
          </tr>
        `;
      }).join("");

      list.querySelectorAll(".btn-paket-dec").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          const id = (e.currentTarget as HTMLElement).getAttribute("data-id");
          if (!id) return;
          const current = selectedPaketQty[id] || 0;
          if (current > 0) {
            selectedPaketQty[id] = current - 1;
            updatePaketQtyDisplay(id);
            calcTotalSementara();
          }
        });
      });

      list.querySelectorAll(".btn-paket-inc").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          const id = (e.currentTarget as HTMLElement).getAttribute("data-id");
          if (!id) return;
          const current = selectedPaketQty[id] || 0;
          selectedPaketQty[id] = current + 1;
          updatePaketQtyDisplay(id);
          calcTotalSementara();
        });
      });
    }

    function updatePaketQtyDisplay(id: string) {
      const el = document.querySelector(`.paket-qty-text[data-id="${id}"]`);
      if (el) el.textContent = String(selectedPaketQty[id] || 0);
      const decBtn = document.querySelector(
        `.btn-paket-dec[data-id="${id}"]`,
      ) as HTMLButtonElement | null;
      if (decBtn) {
        decBtn.disabled = (selectedPaketQty[id] || 0) <= 0;
      }
    }

    function checkKeluargaConstraint(): boolean {
      const tipe = getSelectedTipe();
      const noticeMinKeluarga = document.getElementById("noticeMinKeluarga");
      const btnNextStep2 = document.getElementById(
        "btnNextStep2",
      ) as HTMLButtonElement | null;

      if (tipe === "keluarga" && anggotaData.length < 2) {
        if (noticeMinKeluarga) noticeMinKeluarga.classList.remove("hidden");
        if (btnNextStep2) {
          btnNextStep2.classList.add("opacity-40", "cursor-not-allowed");
          btnNextStep2.setAttribute(
            "title",
            "Kategori Keluarga minimal 2 peserta",
          );
        }
        return false;
      } else {
        if (noticeMinKeluarga) noticeMinKeluarga.classList.add("hidden");
        if (btnNextStep2) {
          btnNextStep2.classList.remove("opacity-40", "cursor-not-allowed");
          btnNextStep2.removeAttribute("title");
        }
        return true;
      }
    }

    function setupStepNavigation() {
      const btnNextStep1 = document.getElementById("btnNextStep1");
      const btnNextStep2 = document.getElementById("btnNextStep2");
      const btnPrevStep2 = document.getElementById("btnPrevStep2");
      const btnNextStep3 = document.getElementById("btnNextStep3");
      const btnPrevStep3 = document.getElementById("btnPrevStep3");
      const btnPrevStep4 = document.getElementById("btnPrevStep4");

      const picNamaInput = document.getElementById(
        "pic_nama",
      ) as HTMLInputElement | null;
      const picWaInput = document.getElementById(
        "pic_whatsapp",
      ) as HTMLInputElement | null;
      const picProvinsiSelect = document.getElementById(
        "pic_provinsi",
      ) as HTMLInputElement | null;
      const picKotaSelect = document.getElementById(
        "pic_kota",
      ) as HTMLInputElement | null;

      if (picProvinsiSelect) {
        picProvinsiSelect.addEventListener("input", () =>
          clearInvalid(picProvinsiSelect),
        );
      }
      if (picKotaSelect) {
        picKotaSelect.addEventListener("input", () =>
          clearInvalid(picKotaSelect),
        );
      }

      // Filter ketat WhatsApp: Hanya bisa input angka & maksimal 15 digit
      if (picWaInput) {
        picWaInput.addEventListener("input", () => {
          const raw = picWaInput.value;
          const clean = raw.replace(/\D/g, "").slice(0, 15);
          if (raw !== clean) {
            picWaInput.value = clean;
          }
        });

        picWaInput.addEventListener("keydown", (e) => {
          if (
            [
              "Backspace",
              "Delete",
              "Tab",
              "Escape",
              "Enter",
              "ArrowLeft",
              "ArrowRight",
              "ArrowUp",
              "ArrowDown",
              "Home",
              "End",
            ].includes(e.key) ||
            e.ctrlKey ||
            e.metaKey
          ) {
            return;
          }
          if (!/^[0-9]$/.test(e.key)) {
            e.preventDefault();
          }
        });

        picWaInput.addEventListener("paste", (e) => {
          e.preventDefault();
          const pasteData =
            (e.clipboardData || (window as any).clipboardData)?.getData(
              "text",
            ) || "";
          const clean = pasteData.replace(/\D/g, "").slice(0, 15);
          const start = picWaInput.selectionStart || 0;
          const end = picWaInput.selectionEnd || 0;
          const oldVal = picWaInput.value;
          picWaInput.value = (
            oldVal.slice(0, start) +
            clean +
            oldVal.slice(end)
          ).slice(0, 15);
          picWaInput.dispatchEvent(new Event("input"));
        });
      }

      if (btnNextStep1) {
        btnNextStep1.onclick = async () => {
          const picNama = (picNamaInput?.value || "").trim();
          const rawWa = picWaInput?.value || "";
          const cleanWa = rawWa.replace(/\D/g, "");
          const picProvinsi = (picProvinsiSelect?.value || "").trim();
          const picKota = (picKotaSelect?.value || "").trim();

          let hasError = false;
          let firstInvalid: HTMLElement | null = null;

          // Validasi Kota/Kabupaten
          if (!picKota) {
            markInvalid(picKotaSelect);
            firstInvalid = picKotaSelect;
            hasError = true;
          } else {
            clearInvalid(picKotaSelect);
          }

          // Validasi Provinsi
          if (!picProvinsi) {
            markInvalid(picProvinsiSelect);
            firstInvalid = picProvinsiSelect;
            hasError = true;
          } else {
            clearInvalid(picProvinsiSelect);
          }

          // Validasi WhatsApp: Wajib angka, min 10 digit, max 15 digit
          if (!cleanWa || cleanWa.length < 10 || cleanWa.length > 15) {
            markInvalid(picWaInput);
            if (picWaInput) bindClearOnInput(picWaInput);
            firstInvalid = picWaInput;
            hasError = true;
          } else {
            clearInvalid(picWaInput);
          }

          // Validasi Nama PIC: Wajib minimal 2 huruf
          if (!picNama || picNama.length < 2) {
            markInvalid(picNamaInput);
            if (picNamaInput) bindClearOnInput(picNamaInput);
            firstInvalid = picNamaInput; // Urutan fokus prioritas Nama PIC di atas
            hasError = true;
          } else {
            clearInvalid(picNamaInput);
          }

          if (hasError) {
            if (firstInvalid) {
              firstInvalid.focus();
              firstInvalid.scrollIntoView({
                behavior: "smooth",
                block: "center",
              });
            }

            if (
              (!picNama || picNama.length < 2) &&
              (!cleanWa || cleanWa.length < 10)
            ) {
              showFloatingToast("Mohon lengkapi kolom yang ditandai merah.");
            } else if (!picNama || picNama.length < 2) {
              showFloatingToast("Mohon lengkapi Nama Lengkap Penanggung Jawab.");
            } else if (cleanWa.length < 10) {
              showFloatingToast("Nomor WhatsApp minimal 10 digit angka.");
            } else if (cleanWa.length > 15) {
              showFloatingToast("Nomor WhatsApp maksimal 15 digit angka.");
            } else if (!picProvinsi || !picKota) {
              showFloatingToast(
                "Mohon lengkapi Provinsi dan Kota/Kabupaten domisili.",
              );
            } else {
              showFloatingToast("Mohon lengkapi kolom yang ditandai merah.");
            }
            return;
          }

          // Validasi ke backend: nomor WhatsApp tidak boleh sudah dipakai pendaftaran aktif
          const btnEl = btnNextStep1 as HTMLButtonElement;
          const prevBtnHtml = btnEl.innerHTML;
          btnEl.disabled = true;
          btnEl.innerHTML = "Memeriksa nomor...";
          try {
            const res = await fetch(
              `${API_URL}/api/peserta/cek-wa?wa=${encodeURIComponent(cleanWa)}`,
            );
            const json = await res.json().catch(() => ({}));
            if (res.ok && json.terdaftar) {
              markInvalid(picWaInput);
              if (picWaInput) {
                bindClearOnInput(picWaInput);
                picWaInput.focus();
                picWaInput.scrollIntoView({
                  behavior: "smooth",
                  block: "center",
                });
              }
              showFloatingToast(
                "Nomor WhatsApp sudah pernah digunakan untuk mendaftar. Gunakan nomor lain.",
              );
              return;
            }
          } catch (err) {
            // Abaikan bila pengecekan gagal karena jaringan; server tetap memvalidasi saat submit.
          } finally {
            btnEl.disabled = false;
            btnEl.innerHTML = prevBtnHtml;
          }

          // Peserta #1 = PIC: nama selalu mengikuti data PIC dan tidak bisa diubah di langkah biodata
          if (anggotaData[0]) {
            anggotaData[0].nama = picNama;
          }

          goToStep(2);
          renderAnggotaForms();
          checkKeluargaConstraint();
        };
      }

      if (btnPrevStep2) {
        btnPrevStep2.onclick = () => goToStep(1);
      }

      if (btnNextStep2) {
        btnNextStep2.onclick = () => {
          syncAnggotaFromDOM();

          // Cek constraint minimal 2 peserta untuk kategori keluarga
          if (!checkKeluargaConstraint()) {
            const noticeMinKeluarga =
              document.getElementById("noticeMinKeluarga");
            if (noticeMinKeluarga) {
              noticeMinKeluarga.scrollIntoView({
                behavior: "smooth",
                block: "center",
              });
            }
            showFloatingToast(
              "Kategori Keluarga minimal 2 orang peserta. Tambah anggota atau pindah ke Non-Keluarga.",
            );
            return;
          }

          const cards = document.querySelectorAll(".anggota-card");
          let hasError = false;
          let firstInvalid: HTMLElement | null = null;
          const tipe = getSelectedTipe();

          cards.forEach((card) => {
            const inputNama = card.querySelector(
              ".input-nama",
            ) as HTMLInputElement | null;
            if (inputNama) {
              const val = inputNama.value.trim();
              if (!val || val.length < 2) {
                markInvalid(inputNama);
                bindClearOnInput(inputNama);
                if (!firstInvalid) firstInvalid = inputNama;
                hasError = true;
              } else {
                clearInvalid(inputNama);
              }
            }

            if (tipe === "keluarga") {
              const selectPeran = card.querySelector(
                ".select-peran",
              ) as HTMLSelectElement | null;
              if (selectPeran) {
                if (!selectPeran.value) {
                  markInvalid(selectPeran);
                  bindClearOnInput(selectPeran);
                  if (!firstInvalid) firstInvalid = selectPeran;
                  hasError = true;
                } else {
                  clearInvalid(selectPeran);
                }
              }
            }

            const inputUsia = card.querySelector(
              ".input-usia",
            ) as HTMLInputElement | null;
            if (inputUsia) {
              const val = inputUsia.value.trim();
              if (val === "" || isNaN(Number(val)) || Number(val) < 0) {
                markInvalid(inputUsia);
                bindClearOnInput(inputUsia);
                if (!firstInvalid) firstInvalid = inputUsia;
                hasError = true;
              } else {
                clearInvalid(inputUsia);
              }
            }

            const cbDomisili = card.querySelector(
              ".cb-beda-domisili",
            ) as HTMLInputElement | null;
            if (cbDomisili && cbDomisili.checked) {
              const selectProv = card.querySelector(
                ".select-provinsi-anggota",
              ) as HTMLSelectElement | null;
              const selectKota = card.querySelector(
                ".select-kota-anggota",
              ) as HTMLSelectElement | null;

              if (selectProv && !selectProv.value) {
                markInvalid(selectProv);
                bindClearOnInput(selectProv);
                if (!firstInvalid) firstInvalid = selectProv;
                hasError = true;
              } else if (selectProv) {
                clearInvalid(selectProv);
              }

              if (selectKota && !selectKota.value) {
                markInvalid(selectKota);
                bindClearOnInput(selectKota);
                if (!firstInvalid) firstInvalid = selectKota;
                hasError = true;
              } else if (selectKota) {
                clearInvalid(selectKota);
              }
            }
          });

          if (hasError) {
            if (firstInvalid) {
              const el = firstInvalid as HTMLElement;
              el.focus();
              el.scrollIntoView({
                behavior: "smooth",
                block: "center",
              });
            }
            showFloatingToast("Mohon lengkapi kolom yang ditandai merah.");
            return;
          }

          updateStep3Summary();
          goToStep(3);
        };
      }

      if (btnPrevStep3) {
        btnPrevStep3.onclick = () => goToStep(2);
      }

      if (btnNextStep3) {
        btnNextStep3.onclick = () => {
          updateStep4Review();
          goToStep(4);
        };
      }

      if (btnPrevStep4) {
        btnPrevStep4.onclick = () => goToStep(3);
      }

      // Tombol pindah ke Non-Keluarga dari notif constraint
      const btnSwitch = document.getElementById("btnSwitchNonKeluarga");
      if (btnSwitch) {
        btnSwitch.onclick = () => {
          const radioNonKeluarga = document.querySelector(
            'input[name="tipe_pendaftaran"][value="non_keluarga"]',
          ) as HTMLInputElement | null;
          if (radioNonKeluarga) {
            radioNonKeluarga.checked = true;
            radioNonKeluarga.dispatchEvent(new Event("change"));
            showFloatingToast(
              "Kategori berhasil diubah ke Non-Keluarga.",
              false,
            );
          }
        };
      }

      // Radio tipe change (Keluarga vs Non-Keluarga)
      const radioTipe = document.querySelectorAll(
        'input[name="tipe_pendaftaran"]',
      );
      radioTipe.forEach((r) => {
        r.addEventListener("change", () => {
          const tipe = getSelectedTipe();
          if (tipe === "non_keluarga") {
            if (anggotaData.length > 1) {
              anggotaData[0].peran = "Ketua Rombongan";
              for (let i = 1; i < anggotaData.length; i++)
                anggotaData[i].peran = "Peserta";
            } else if (anggotaData[0]) {
              anggotaData[0].peran = "Peserta";
            }
          } else {
            anggotaData.forEach((a) => {
              if (a.peran === "Peserta" || a.peran === "Ketua Rombongan")
                a.peran = "";
            });
          }
          renderAnggotaForms();
          checkKeluargaConstraint();
        });
      });

      // Tombol tambah anggota
      const btnAdd = document.getElementById("btnAddAnggota");
      if (btnAdd) {
        btnAdd.onclick = (e) => {
          e.preventDefault();
          syncAnggotaFromDOM();
          const tipe = getSelectedTipe();
          const peranBaru = tipe === "keluarga" ? "" : "Peserta";
          const jkBaru = "Ikhwan";

          if (tipe === "non_keluarga") {
            anggotaData[0].peran = "Ketua Rombongan";
          }

          anggotaData.push({
            nama: "",
            peran: peranBaru,
            jenis_kelamin: jkBaru,
            usia: null,
            ukuran_kaos: "-",
            catatan_medis: "",
            beda_domisili: false,
            provinsi: "",
            kota: "",
          });
          renderAnggotaForms();
          checkKeluargaConstraint();
        };
      }
    }

    function getSelectedTipe(): "keluarga" | "non_keluarga" {
      const el = document.querySelector(
        'input[name="tipe_pendaftaran"]:checked',
      ) as HTMLInputElement | null;
      return el && el.value === "non_keluarga" ? "non_keluarga" : "keluarga";
    }

    function goToStep(step: number) {
      currentStep = step;
      for (let i = 1; i <= 4; i++) {
        const content = document.getElementById(`stepContent${i}`);
        const tab = document.getElementById(`stepTab${i}`);
        if (content && tab) {
          if (i === step) {
            content.classList.remove("hidden");
            tab.className =
              "step-tab active py-2 px-1 rounded-xl transition font-extrabold text-[11px] sm:text-xs text-primary-800 bg-primary-50 border border-primary-200";
          } else if (i < step) {
            content.classList.add("hidden");
            tab.className =
              "step-tab py-2 px-1 rounded-xl transition font-bold text-[11px] sm:text-xs text-emerald-700 bg-emerald-50/60 border border-emerald-200";
          } else {
            content.classList.add("hidden");
            tab.className =
              "step-tab py-2 px-1 rounded-xl transition font-semibold text-[11px] sm:text-xs text-slate-400";
          }
        }
      }
      window.scrollTo({ top: 100, behavior: "smooth" });
    }

    function syncAnggotaFromDOM() {
      const cards = document.querySelectorAll(".anggota-card");
      cards.forEach((card, idx) => {
        if (!anggotaData[idx]) return;
        const inputNama = card.querySelector(
          ".input-nama",
        ) as HTMLInputElement | null;
        const selectPeran = card.querySelector(
          ".select-peran",
        ) as HTMLSelectElement | null;
        const inputJk = card.querySelector(
          'input[name^="jk_"]:checked',
        ) as HTMLInputElement | null;
        const inputUsia = card.querySelector(
          ".input-usia",
        ) as HTMLInputElement | null;
        const inputMedis = card.querySelector(
          ".input-medis",
        ) as HTMLInputElement | null;

        if (inputNama) anggotaData[idx].nama = inputNama.value.trim();
        if (selectPeran) {
          const tipe = getSelectedTipe();
          if (tipe === "keluarga") {
            anggotaData[idx].peran = selectPeran.value;
            const locked = getLockedGenderForPeran(selectPeran.value);
            if (locked) {
              anggotaData[idx].jenis_kelamin = locked;
            }
          } else {
            anggotaData[idx].peran =
              idx === 0 && anggotaData.length > 1
                ? "Ketua Rombongan"
                : "Peserta";
          }
        }
        if (inputJk && !getLockedGenderForPeran(anggotaData[idx].peran)) {
          anggotaData[idx].jenis_kelamin = inputJk.value;
        }
        if (inputUsia)
          anggotaData[idx].usia = inputUsia.value
            ? parseInt(inputUsia.value, 10)
            : null;
        anggotaData[idx].ukuran_kaos = "-";
        if (inputMedis)
          anggotaData[idx].catatan_medis = inputMedis.value.trim();

        const cbDomisili = card.querySelector(
          ".cb-beda-domisili",
        ) as HTMLInputElement | null;
        const selectProvinsi = card.querySelector(
          ".select-provinsi-anggota",
        ) as HTMLSelectElement | null;
        const selectKota = card.querySelector(
          ".select-kota-anggota",
        ) as HTMLSelectElement | null;

        if (cbDomisili) {
          anggotaData[idx].beda_domisili = cbDomisili.checked;
          if (cbDomisili.checked) {
            if (selectProvinsi)
              anggotaData[idx].provinsi = selectProvinsi.value;
            if (selectKota) anggotaData[idx].kota = selectKota.value;
          } else {
            anggotaData[idx].provinsi = "";
            anggotaData[idx].kota = "";
          }
        }
      });
    }

    function renderAnggotaForms() {
      const container = document.getElementById("anggotaContainer");
      if (!container) return;

      const tipe = getSelectedTipe();

      container.innerHTML = anggotaData
        .map((a, idx) => {
          const lockedGender =
            tipe === "keluarga" ? getLockedGenderForPeran(a.peran) : null;
          if (lockedGender) {
            a.jenis_kelamin = lockedGender;
          }

          if (tipe === "non_keluarga") {
            a.peran =
              idx === 0 && anggotaData.length > 1
                ? "Ketua Rombongan"
                : "Peserta";
          }

          return `
          <div class="anggota-card bg-slate-50/80 rounded-2xl p-4 sm:p-5 border border-slate-200 space-y-4" data-index="${idx}">
            <div class="flex items-center justify-between pb-3 border-b border-slate-200">
              <div class="card-header-left flex items-center gap-2 flex-wrap">
                <span class="w-6 h-6 rounded-lg bg-primary-100 text-primary-800 font-mono font-bold text-xs flex items-center justify-center">${idx + 1}</span>
                <span class="font-extrabold text-xs sm:text-sm text-slate-800">Peserta #${idx + 1}</span>
                ${idx === 0 && tipe === "non_keluarga" && anggotaData.length > 1 ? `<span class="px-2 py-0.5 bg-primary-100 text-primary-800 rounded text-[10px] font-bold">Ketua Rombongan</span>` : ""}
              </div>
              ${
                idx > 0
                  ? `
                <button type="button" class="btn-hapus-anggota text-xs text-rose-600 hover:text-rose-800 font-bold transition cursor-pointer" data-index="${idx}">
                  Hapus ✕
                </button>
              `
                  : `
                <span class="text-[10px] text-slate-400 font-semibold italic" title="Peserta #1 adalah penanggung jawab pendaftaran">Penanggung Jawab</span>
              `
              }
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
              <!-- Nama Lengkap -->
              <div>
                <label class="block text-[11px] font-bold text-slate-700 mb-1">
                  Nama Lengkap <span class="text-rose-500">*</span>
                </label>
                ${
                  idx === 0
                    ? `
                <input
                  type="text"
                  readonly
                  value="${(document.getElementById("pic_nama") as HTMLInputElement | null)?.value.trim() || a.nama}"
                  placeholder="Nama Peserta"
                  class="input-nama w-full border border-slate-200 bg-slate-100 text-slate-700 font-semibold rounded-xl px-3.5 py-2.5 text-xs cursor-not-allowed select-none"
                />
                `
                    : `
                <input
                  type="text"
                  required
                  value="${a.nama}"
                  placeholder="Nama Peserta"
                  class="input-nama w-full border border-slate-300 rounded-xl px-3.5 py-2.5 text-xs bg-white focus:ring-2 focus:ring-primary-500/20 focus:border-primary-600 outline-none transition"
                />
                `
                }
              </div>

              <!-- Peran / Status -->
              <div>
                <label class="block text-[11px] font-bold text-slate-700 mb-1">
                  Peran / Status <span class="text-rose-500">*</span>
                </label>
                ${
                  tipe === "keluarga"
                    ? `
                  <select class="select-peran w-full border border-slate-300 rounded-xl px-3.5 py-2.5 text-xs bg-white focus:ring-2 focus:ring-primary-500/20 focus:border-primary-600 outline-none transition font-bold ${!a.peran ? "text-slate-400" : "text-slate-800"} cursor-pointer">
                    <option value="" disabled ${!a.peran ? "selected" : ""}>-</option>
                    <option value="Ayah" ${a.peran === "Ayah" ? "selected" : ""}>Ayah</option>
                    <option value="Ibu" ${a.peran === "Ibu" ? "selected" : ""}>Ibu</option>
                    <option value="Suami" ${a.peran === "Suami" ? "selected" : ""}>Suami</option>
                    <option value="Istri" ${a.peran === "Istri" ? "selected" : ""}>Istri</option>
                    <option value="Anak" ${a.peran === "Anak" ? "selected" : ""}>Anak</option>
                    <option value="Kakek" ${a.peran === "Kakek" ? "selected" : ""}>Kakek</option>
                    <option value="Nenek" ${a.peran === "Nenek" ? "selected" : ""}>Nenek</option>
                    <option value="Paman" ${a.peran === "Paman" ? "selected" : ""}>Paman</option>
                    <option value="Bibi" ${a.peran === "Bibi" ? "selected" : ""}>Bibi</option>
                    <option value="Saudara Kandung" ${a.peran === "Saudara Kandung" ? "selected" : ""}>Saudara Kandung</option>
                    <option value="Sepupu" ${a.peran === "Sepupu" ? "selected" : ""}>Sepupu</option>
                  </select>
                `
                    : `
                  <input
                    type="text"
                    readonly
                    value="${idx === 0 && anggotaData.length > 1 ? "Ketua Rombongan" : "Peserta"}"
                    class="select-peran w-full border ${idx === 0 && anggotaData.length > 1 ? "border-primary-300 bg-primary-50 text-primary-900 font-extrabold" : "border-slate-200 bg-slate-100 text-slate-700 font-bold"} rounded-xl px-3.5 py-2.5 text-xs cursor-not-allowed select-none transition"
                  />
                `
                }
              </div>

              <!-- Jenis Kelamin -->
              <div>
                <label class="block text-[11px] font-bold text-slate-700 mb-1">
                  Jenis Kelamin <span class="text-rose-500">*</span>
                  ${lockedGender ? '<span class="text-[10px] text-primary-600 font-semibold ml-1">(Terkunci sesuai peran)</span>' : ""}
                </label>
                <div class="grid grid-cols-2 gap-2">
                  <label class="${lockedGender === "Akhwat" ? "opacity-40 cursor-not-allowed" : "cursor-pointer"}">
                    <input
                      type="radio"
                      name="jk_${idx}"
                      value="Ikhwan"
                      ${a.jenis_kelamin === "Ikhwan" ? "checked" : ""}
                      ${lockedGender === "Akhwat" ? "disabled" : ""}
                      class="radio-jk peer sr-only"
                      data-index="${idx}"
                    />
                    <div class="text-center py-2.5 px-3 rounded-xl border border-slate-200 bg-white font-bold text-xs peer-checked:bg-primary-600 peer-checked:text-white peer-checked:border-primary-600 peer-disabled:bg-slate-100 peer-disabled:text-slate-400 peer-disabled:border-slate-200 transition shadow-2xs">
                      IKHWAN
                    </div>
                  </label>
                  <label class="${lockedGender === "Ikhwan" ? "opacity-40 cursor-not-allowed" : "cursor-pointer"}">
                    <input
                      type="radio"
                      name="jk_${idx}"
                      value="Akhwat"
                      ${a.jenis_kelamin === "Akhwat" ? "checked" : ""}
                      ${lockedGender === "Ikhwan" ? "disabled" : ""}
                      class="radio-jk peer sr-only"
                      data-index="${idx}"
                    />
                    <div class="text-center py-2.5 px-3 rounded-xl border border-slate-200 bg-white font-bold text-xs peer-checked:bg-primary-600 peer-checked:text-white peer-checked:border-primary-600 peer-disabled:bg-slate-100 peer-disabled:text-slate-400 peer-disabled:border-slate-200 transition shadow-2xs">
                      AKHWAT
                    </div>
                  </label>
                </div>
              </div>

              <!-- Usia: Angka Besar, Jelas & Tidak Samar -->
              <div>
                <label class="block text-[11px] font-bold text-slate-700 mb-1">
                  Usia (Tahun) <span class="text-rose-500">*</span>
                </label>
                <input
                  type="number"
                  min="0"
                  max="100"
                  value="${a.usia !== null && a.usia !== undefined ? a.usia : ""}"
                  placeholder="-"
                  class="input-usia w-full border border-slate-300 rounded-xl px-4 py-2.5 text-base font-black text-slate-900 bg-white focus:ring-2 focus:ring-primary-500/20 focus:border-primary-600 outline-none transition font-mono placeholder:text-slate-400 placeholder:font-bold placeholder:text-base"
                />
              </div>

              <!-- Catatan Medis & Obat yang Sering Digunakan/Dikonsumsi -->
              <div class="sm:col-span-2">
                <label class="block text-[11px] font-bold text-slate-700 mb-1">
                  Catatan Medis, Alergi & Obat yang Sering Dikonsumsi <span class="text-slate-400 font-normal">(Opsional)</span>
                </label>
                <input
                  type="text"
                  value="${a.catatan_medis}"
                  placeholder="Contoh: Asma dingin (bawa inhaler salbutamol), alergi seafood, obat rutin maag/darah tinggi, dll."
                  class="input-medis w-full border border-slate-300 rounded-xl px-3.5 py-2.5 text-xs bg-white focus:ring-2 focus:ring-primary-500/20 focus:border-primary-600 outline-none transition text-slate-800"
                />
              </div>

              ${
                idx > 0 && tipe === "non_keluarga"
                  ? `
                <!-- Opsi Beda Domisili Khusus Non-Keluarga (Smart Inherit) -->
                <div class="sm:col-span-2 pt-2 border-t border-slate-200/80 space-y-2.5">
                  <label class="flex items-start gap-2.5 cursor-pointer select-none">
                    <input
                      type="checkbox"
                      class="cb-beda-domisili mt-0.5 rounded border-slate-300 text-primary-600 focus:ring-primary-500 cursor-pointer"
                      data-index="${idx}"
                      ${a.beda_domisili ? "checked" : ""}
                    />
                    <div>
                      <span class="text-xs font-bold text-slate-800 block">Asal kota / domisili berbeda dengan Penanggung Jawab?</span>
                      <span class="text-[10px] text-slate-400 block">Default: mengikuti domisili Penanggung Jawab.</span>
                    </div>
                  </label>

                  <div class="container-domisili-anggota ${a.beda_domisili ? "" : "hidden"} grid grid-cols-1 sm:grid-cols-2 gap-3 p-3 bg-white rounded-xl border border-slate-200" data-index="${idx}">
                    <div>
                      <label class="block text-[11px] font-bold text-slate-700 mb-1">
                        Provinsi Asal <span class="text-rose-500">*</span>
                      </label>
                      <select class="select-provinsi-anggota w-full border border-slate-300 rounded-xl px-3 py-2 text-xs bg-white focus:ring-2 focus:ring-primary-500/20 focus:border-primary-600 outline-none transition font-medium cursor-pointer" data-index="${idx}">
                        <option value="" disabled ${!a.provinsi ? "selected" : ""}>Pilih Provinsi...</option>
                        ${LIST_PROVINSI.map((p) => `<option value="${p}" ${a.provinsi === p ? "selected" : ""}>${p}</option>`).join("")}
                      </select>
                    </div>

                    <div>
                      <label class="block text-[11px] font-bold text-slate-700 mb-1">
                        Kota / Kabupaten <span class="text-rose-500">*</span>
                      </label>
                      <select class="select-kota-anggota w-full border border-slate-300 rounded-xl px-3 py-2 text-xs bg-white focus:ring-2 focus:ring-primary-500/20 focus:border-primary-600 outline-none transition font-medium cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed" data-index="${idx}" ${!a.provinsi ? "disabled" : ""}>
                        <option value="" disabled ${!a.kota ? "selected" : ""}>${a.provinsi ? "Pilih Kota / Kabupaten..." : "Pilih Provinsi dahulu..."}</option>
                        ${a.provinsi && DATA_WILAYAH[a.provinsi] ? DATA_WILAYAH[a.provinsi].map((k) => `<option value="${k}" ${a.kota === k ? "selected" : ""}>${k}</option>`).join("") : ""}
                      </select>
                    </div>
                  </div>
                </div>
              `
                  : ""
              }
            </div>
          </div>
        `;
        })
        .join("");

      // Pasang event listener tombol hapus
      container.querySelectorAll(".btn-hapus-anggota").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          syncAnggotaFromDOM();
          const target = e.currentTarget as HTMLElement;
          const idx = parseInt(target.getAttribute("data-index") || "0", 10);
          if (anggotaData.length > 1) {
            anggotaData.splice(idx, 1);
            const tipe = getSelectedTipe();
            if (tipe === "non_keluarga") {
              if (anggotaData.length === 1) {
                anggotaData[0].peran = "Peserta";
              } else {
                anggotaData[0].peran = "Ketua Rombongan";
                for (let i = 1; i < anggotaData.length; i++)
                  anggotaData[i].peran = "Peserta";
              }
            }
            renderAnggotaForms();
            checkKeluargaConstraint();
          }
        });
      });

      // Event listener ganti peran -> otomatis sesuaikan dan kunci gender
      container.querySelectorAll(".select-peran").forEach((selectEl) => {
        selectEl.addEventListener("change", (e) => {
          syncAnggotaFromDOM();
          const target = e.currentTarget as HTMLSelectElement;
          clearInvalid(target);
          const card = target.closest(".anggota-card");
          const idx = parseInt(card?.getAttribute("data-index") || "0", 10);
          const chosenPeran = target.value;
          const locked = getLockedGenderForPeran(chosenPeran);
          if (locked) {
            anggotaData[idx].jenis_kelamin = locked;
          }
          renderAnggotaForms();
        });
      });

      // Event listener radio jenis kelamin (untuk peran yang fleksibel)
      container.querySelectorAll(".radio-jk").forEach((radio) => {
        radio.addEventListener("change", (e) => {
          const target = e.currentTarget as HTMLInputElement;
          const idx = parseInt(target.getAttribute("data-index") || "0", 10);
          if (anggotaData[idx]) {
            anggotaData[idx].jenis_kelamin = target.value;
          }
        });
      });

      // Event listener input usia: hanya bersihkan status invalid saat mengetik
      container.querySelectorAll(".input-usia").forEach((inputEl) => {
        inputEl.addEventListener("input", () => {
          clearInvalid(inputEl as HTMLElement);
        });
      });

      // Pasang event listener input agar border merah langsung hilang saat mulai mengetik
      container.querySelectorAll(".input-nama").forEach((inp) => {
        inp.addEventListener("input", (e) => {
          clearInvalid(e.currentTarget as HTMLElement);
        });
      });

      // Event listener checkbox beda domisili (Non-Keluarga)
      container.querySelectorAll(".cb-beda-domisili").forEach((cb) => {
        cb.addEventListener("change", (e) => {
          const target = e.currentTarget as HTMLInputElement;
          const idx = parseInt(target.getAttribute("data-index") || "0", 10);
          if (!anggotaData[idx]) return;

          anggotaData[idx].beda_domisili = target.checked;
          const card = target.closest(".anggota-card");
          const domisiliContainer = card?.querySelector(
            ".container-domisili-anggota",
          );
          if (domisiliContainer) {
            if (target.checked) {
              domisiliContainer.classList.remove("hidden");
            } else {
              domisiliContainer.classList.add("hidden");
              anggotaData[idx].provinsi = "";
              anggotaData[idx].kota = "";
              const provSelect = domisiliContainer.querySelector(
                ".select-provinsi-anggota",
              ) as HTMLSelectElement | null;
              const kotaSelect = domisiliContainer.querySelector(
                ".select-kota-anggota",
              ) as HTMLSelectElement | null;
              if (provSelect) {
                provSelect.value = "";
                clearInvalid(provSelect);
              }
              if (kotaSelect) {
                kotaSelect.value = "";
                kotaSelect.disabled = true;
                kotaSelect.innerHTML =
                  '<option value="" disabled selected>Pilih Provinsi dahulu...</option>';
                clearInvalid(kotaSelect);
              }
            }
          }
        });
      });

      // Event listener select provinsi anggota
      container
        .querySelectorAll(".select-provinsi-anggota")
        .forEach((provEl) => {
          provEl.addEventListener("change", (e) => {
            const target = e.currentTarget as HTMLSelectElement;
            const idx = parseInt(target.getAttribute("data-index") || "0", 10);
            if (!anggotaData[idx]) return;

            clearInvalid(target);
            anggotaData[idx].provinsi = target.value;
            anggotaData[idx].kota = "";

            const card = target.closest(".anggota-card");
            const kotaEl = card?.querySelector(
              ".select-kota-anggota",
            ) as HTMLSelectElement | null;
            if (kotaEl) {
              clearInvalid(kotaEl);
              const kotaList = DATA_WILAYAH[target.value] || [];
              kotaEl.disabled = false;
              kotaEl.innerHTML = `
              <option value="" disabled selected>Pilih Kota / Kabupaten...</option>
              ${kotaList.map((k) => `<option value="${k}">${k}</option>`).join("")}
            `;
            }
          });
        });

      // Event listener select kota anggota
      container.querySelectorAll(".select-kota-anggota").forEach((kotaEl) => {
        kotaEl.addEventListener("change", (e) => {
          const target = e.currentTarget as HTMLSelectElement;
          const idx = parseInt(target.getAttribute("data-index") || "0", 10);
          if (anggotaData[idx]) {
            anggotaData[idx].kota = target.value;
          }
          clearInvalid(target);
        });
      });

      checkKeluargaConstraint();
    }

    function setupAddonInteractions() {
      const radioSewa = document.querySelectorAll('input[name="opt_sewa"]');
      const containerAddons = document.getElementById("containerAddons");

      radioSewa.forEach((r) => {
        r.addEventListener("change", () => {
          const isYa =
            (
              document.querySelector(
                'input[name="opt_sewa"]:checked',
              ) as HTMLInputElement
            )?.value === "ya";
          if (containerAddons) {
            if (isYa) {
              containerAddons.classList.remove("hidden");
            } else {
              containerAddons.classList.add("hidden");
              selectedPaketQty = {};
              renderAddonsCatalog();
            }
          }
          calcTotalSementara();
        });
      });
    }

    function hitungRincianBiayaWajib() {
      let dewasaCount = 0;
      let anakCount = 0;
      let balitaGratisCount = 0;
      let subtotalWajib = 0;

      for (const a of anggotaData) {
        const u =
          a.usia !== null && a.usia !== undefined && !isNaN(Number(a.usia))
            ? Number(a.usia)
            : null;
        if (u === null || u >= 11) {
          dewasaCount++;
          subtotalWajib += 200000;
        } else if (u >= 6 && u <= 10) {
          anakCount++;
          subtotalWajib += 100000;
        } else {
          // u <= 5 th (1-5 th): gratis tanpa fasilitas
          balitaGratisCount++;
        }
      }

      return {
        dewasaCount,
        anakCount,
        balitaGratisCount,
        totalBerbayar: dewasaCount + anakCount,
        subtotalWajib,
      };
    }

    function getAnggotaBerbayarCount(): number {
      return hitungRincianBiayaWajib().totalBerbayar;
    }

    function updateStep3Summary() {
      const rincian = hitungRincianBiayaWajib();

      const txtBadge = document.getElementById("txtTotalBerbayarBadge");
      if (txtBadge) {
        const parts: string[] = [];
        if (rincian.dewasaCount > 0) parts.push(`${rincian.dewasaCount} Dewasa`);
        if (rincian.anakCount > 0) parts.push(`${rincian.anakCount} Anak`);
        if (rincian.balitaGratisCount > 0) parts.push(`${rincian.balitaGratisCount} Balita (Gratis)`);
        txtBadge.textContent = parts.length > 0 ? parts.join(" • ") : "0 Peserta";
      }

      const txtSubtotalWajib = document.getElementById("txtSubtotalWajibStep3");
      if (txtSubtotalWajib)
        txtSubtotalWajib.textContent = `Rp ${rincian.subtotalWajib.toLocaleString("id-ID")}`;

      calcTotalSementara();
    }

    function calcTotalSementara(): number {
      const rincian = hitungRincianBiayaWajib();
      const subtotalWajib = rincian.subtotalWajib;

      let subtotalAddon = 0;
      const isYa =
        (
          document.querySelector(
            'input[name="opt_sewa"]:checked',
          ) as HTMLInputElement
        )?.value === "ya";

      if (isYa) {
        for (const paket of PAKET_BUNDLES) {
          const qty = selectedPaketQty[paket.id] || 0;
          if (qty > 0) {
            subtotalAddon += paket.harga * qty;
          }
        }
      }

      const total = subtotalWajib + subtotalAddon;
      const el = document.getElementById("txtTotalSementara");
      if (el) el.textContent = `Rp ${total.toLocaleString("id-ID")}`;

      return total;
    }

    function updateStep4Review() {
      const tipe = getSelectedTipe();
      const picNama = (
        document.getElementById("pic_nama") as HTMLInputElement
      ).value.trim();
      const picWa = (
        document.getElementById("pic_whatsapp") as HTMLInputElement
      ).value.trim();
      const picProvinsi =
        (document.getElementById("pic_provinsi") as HTMLInputElement)?.value.trim() ||
        "";
      const picKota =
        (document.getElementById("pic_kota") as HTMLInputElement)?.value.trim() || "";

      const rekapTipe = document.getElementById("rekapTipe");
      if (rekapTipe)
        rekapTipe.textContent =
          tipe === "keluarga"
            ? "Pendaftaran Keluarga"
            : "Pendaftaran Rombongan / Non-Keluarga";

      const rekapPicNama = document.getElementById("rekapPicNama");
      if (rekapPicNama) rekapPicNama.textContent = picNama;

      const rekapPicWa = document.getElementById("rekapPicWa");
      if (rekapPicWa) rekapPicWa.textContent = `WA: ${picWa}`;

      const rekapPicDomisili = document.getElementById("rekapPicDomisili");
      if (rekapPicDomisili) {
        rekapPicDomisili.textContent =
          picKota && picProvinsi
            ? `${picKota}, ${picProvinsi}`
            : picKota || picProvinsi || "-";
      }

      const rekapJmlAnggota = document.getElementById("rekapJmlAnggota");
      if (rekapJmlAnggota)
        rekapJmlAnggota.textContent = String(anggotaData.length);

      const rekapAnggotaList = document.getElementById("rekapAnggotaList");
      if (rekapAnggotaList) {
        rekapAnggotaList.innerHTML = anggotaData
          .map((a, idx) => {
            const u =
              a.usia !== null && a.usia !== undefined && !isNaN(Number(a.usia))
                ? Number(a.usia)
                : null;
            let statusBiayaText = "Rp 200.000";
            let statusBiayaClass = "text-slate-700";
            if (u !== null && u <= 5) {
              statusBiayaText = "Rp 0";
              statusBiayaClass = "text-emerald-600";
            } else if (u !== null && u >= 6 && u <= 10) {
              statusBiayaText = "Rp 100.000";
              statusBiayaClass = "text-amber-700";
            }
            const customDomisili =
              a.beda_domisili && a.kota && a.provinsi
                ? `📍 Asal: ${a.kota}, ${a.provinsi}`
                : "";
            return `
            <li class="pt-1.5 flex justify-between items-center text-xs">
              <div>
                <span class="font-bold text-slate-800">${idx + 1}. ${a.nama}</span>
                <span class="text-[10px] text-slate-500">(${a.peran || "-"} • ${a.jenis_kelamin}${a.usia !== null && a.usia !== undefined ? " • " + a.usia + " th" : ""})</span>
                ${customDomisili ? `<span class="block text-[10px] text-primary-700 font-semibold mt-0.5">${customDomisili}</span>` : ""}
              </div>
              <span class="font-bold font-mono ${statusBiayaClass}">
                ${statusBiayaText}
              </span>
            </li>
          `;
          })
          .join("");
      }

      const rincian = hitungRincianBiayaWajib();
      const rekapHitungWajib = document.getElementById("rekapHitungWajib");
      if (rekapHitungWajib) rekapHitungWajib.textContent = String(rincian.totalBerbayar);

      const rekapBiayaWajib = document.getElementById("rekapBiayaWajib");
      if (rekapBiayaWajib)
        rekapBiayaWajib.textContent = `Rp ${rincian.subtotalWajib.toLocaleString("id-ID")}`;

      const rekapGrandTotal = document.getElementById("rekapGrandTotal");
      if (rekapGrandTotal)
        rekapGrandTotal.textContent = `Rp ${calcTotalSementara().toLocaleString("id-ID")}`;

      const rekapAddonsList = document.getElementById("rekapAddonsList");
      if (rekapAddonsList) {
        const isYa =
          (
            document.querySelector(
              'input[name="opt_sewa"]:checked',
            ) as HTMLInputElement
          )?.value === "ya";
        const itemsToReview: { nama: string; qty: number; subtotal: number }[] =
          [];

        if (isYa) {
          for (const paket of PAKET_BUNDLES) {
            const qty = selectedPaketQty[paket.id] || 0;
            if (qty > 0) {
              itemsToReview.push({
                nama: `${paket.nama}${paket.fasilitas && paket.fasilitas.length > 0 ? ` (${paket.fasilitas.join(", ")})` : ""}`,
                qty,
                subtotal: paket.harga * qty,
              });
            }
          }
        }

        if (itemsToReview.length === 0) {
          rekapAddonsList.innerHTML = `<span class="text-slate-400 text-[11px] italic">Tidak ada sewa perlengkapan tambahan.</span>`;
        } else {
          rekapAddonsList.innerHTML = itemsToReview
            .map(
              (it) => `
            <div class="flex justify-between text-slate-600 text-xs">
              <span>${it.nama}${it.qty > 1 ? ` (x${it.qty})` : ""}:</span>
              <span class="font-bold text-slate-800 font-mono">Rp ${it.subtotal.toLocaleString("id-ID")}</span>
            </div>
          `,
            )
            .join("");
        }
      }
    }

    function setupFinalSubmit() {
      const form = document.getElementById(
        "formFamilyCamp",
      ) as HTMLFormElement | null;
      const btnFinalSubmit = document.getElementById(
        "btnFinalSubmit",
      ) as HTMLButtonElement | null;
      const submitError = document.getElementById("submitError");

      if (!form) return;

      form.onsubmit = async (e) => {
        e.preventDefault();
        syncAnggotaFromDOM();

        if (submitError) submitError.classList.add("hidden");

        const picNamaInput = document.getElementById(
          "pic_nama",
        ) as HTMLInputElement | null;
        const picWaInput = document.getElementById(
          "pic_whatsapp",
        ) as HTMLInputElement | null;
        const picProvinsiSelect = document.getElementById(
          "pic_provinsi",
        ) as HTMLInputElement | null;
        const picKotaSelect = document.getElementById(
          "pic_kota",
        ) as HTMLInputElement | null;

        const picNama = (picNamaInput?.value || "").trim();
        const picWa = (picWaInput?.value || "").replace(/\D/g, "");
        const picEmail = (
          document.getElementById("pic_email") as HTMLInputElement
        ).value.trim();
        const picProvinsi = (picProvinsiSelect?.value || "").trim();
        const picKota = (picKotaSelect?.value || "").trim();

        // Validasi Step 1
        if (
          !picNama ||
          picNama.length < 2 ||
          picWa.length < 10 ||
          picWa.length > 15 ||
          !picProvinsi ||
          !picKota
        ) {
          goToStep(1);
          const btnNextStep1 = document.getElementById("btnNextStep1");
          btnNextStep1?.click();
          return;
        }

        const tipe = getSelectedTipe();

        // Validasi constraint keluarga: minimal 2 peserta
        if (tipe === "keluarga" && anggotaData.length < 2) {
          goToStep(2);
          checkKeluargaConstraint();
          showFloatingToast("Kategori Keluarga minimal 2 orang peserta.");
          return;
        }

        // Validasi Step 2
        let hasInvalidAnggota = false;
        for (let i = 0; i < anggotaData.length; i++) {
          if (!anggotaData[i].nama || anggotaData[i].nama.trim().length < 2) {
            hasInvalidAnggota = true;
            break;
          }
          if (tipe === "keluarga" && !anggotaData[i].peran) {
            hasInvalidAnggota = true;
            break;
          }
          if (
            anggotaData[i].usia === null ||
            isNaN(Number(anggotaData[i].usia)) ||
            Number(anggotaData[i].usia) < 0
          ) {
            hasInvalidAnggota = true;
            break;
          }
          if (
            anggotaData[i].beda_domisili &&
            (!anggotaData[i].provinsi || !anggotaData[i].kota)
          ) {
            hasInvalidAnggota = true;
            break;
          }
        }
        if (hasInvalidAnggota) {
          goToStep(2);
          const btnNextStep2 = document.getElementById("btnNextStep2");
          btnNextStep2?.click();
          return;
        }

        if (btnFinalSubmit) {
          btnFinalSubmit.disabled = true;
          btnFinalSubmit.textContent = "Memproses Pendaftaran...";
          btnFinalSubmit.className =
            "flex-1 sm:flex-none text-center px-4 sm:px-7 py-2.5 sm:py-3.5 bg-slate-400 text-white font-bold text-xs sm:text-sm rounded-xl transition cursor-wait";
        }

        // Siapkan array addon
        const addonsPayload: { addon_id: string; qty: number }[] = [];
        const isYa =
          (
            document.querySelector(
              'input[name="opt_sewa"]:checked',
            ) as HTMLInputElement
          )?.value === "ya";

        if (isYa) {
          for (const paket of PAKET_BUNDLES) {
            const qty = selectedPaketQty[paket.id] || 0;
            if (qty > 0) {
              addonsPayload.push({ addon_id: paket.id, qty });
            }
          }
        }

        const payload = {
          tipe,
          pic_nama: picNama,
          pic_whatsapp: picWa,
          pic_email: picEmail,
          pic_provinsi: picProvinsi,
          pic_kota: picKota,
          anggota: anggotaData,
          addons: addonsPayload,
        };

        try {
          const res = await fetch(`${API_URL}/api/peserta/daftar-grup`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });

          const json = await res.json();
          if (!res.ok) {
            throw new Error(json.error || "Gagal menyimpan data pendaftaran");
          }

          // Sukses! Redirect langsung ke halaman konfirmasi pembayaran
          if (json.payment_url) {
            window.location.href = json.payment_url;
          } else if (json.payment_token) {
            window.location.href = `/pembayaran?token=${encodeURIComponent(json.payment_token)}`;
          } else {
            showFloatingToast("Pendaftaran berhasil disimpan!", false);
            setTimeout(() => {
              window.location.href = "/status";
            }, 1000);
          }
        } catch (err: any) {
          const errMsg =
            err.message || "Terjadi kesalahan sistem saat mengirim data.";
          showFloatingToast(errMsg, true);
          if (submitError) {
            submitError.textContent = errMsg;
            submitError.classList.remove("hidden");
          }
          if (btnFinalSubmit) {
            btnFinalSubmit.disabled = false;
            btnFinalSubmit.textContent = "Proses Pendaftaran & Buat Invoice →";
            btnFinalSubmit.className =
              "flex-1 sm:flex-none text-center px-4 sm:px-7 py-2.5 sm:py-3.5 bg-primary-600 hover:bg-primary-700 text-white font-bold text-xs sm:text-sm rounded-xl transition shadow-md active:scale-95 cursor-pointer";
          }
        }
      };
    }

    document.addEventListener("astro:page-load", initFamilyCampForm);
  </script>
</Layout>
