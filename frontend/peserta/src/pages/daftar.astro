---
import Layout from '../layouts/Layout.astro';
import { LIST_PROVINSI } from '../data/wilayah';
---

<Layout title="Formulir Pendaftaran Family Camp">
  <!-- Floating Toast Alert (Pop-up melayang, otomatis hilang, tanpa tombol close) -->
  <div
    id="floatingToast"
    class="fixed top-5 left-1/2 -translate-x-1/2 z-[9999] pointer-events-none transition-all duration-300 opacity-0 -translate-y-4 scale-95 flex items-center gap-3 px-4 py-3 bg-slate-900/95 text-white text-xs sm:text-sm font-medium rounded-2xl shadow-2xl border border-slate-700/60 backdrop-blur-md max-w-[92vw] sm:max-w-md w-max"
    role="alert"
    aria-live="polite"
  >
    <div id="floatingToastIcon" class="w-5 h-5 shrink-0 text-rose-400 flex items-center justify-center">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
    </div>
    <span id="floatingToastMsg" class="leading-snug text-slate-100 font-semibold"></span>
  </div>

  <section class="py-10 px-4">
    <div class="max-w-2xl mx-auto space-y-6">

      <!-- Header Acara -->
      <div class="text-center space-y-2">
        <span class="inline-flex items-center gap-1.5 px-3.5 py-1 bg-emerald-100 text-emerald-800 rounded-full text-xs font-bold uppercase tracking-wider">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <span>Pendaftaran Resmi Family Camp</span>
        </span>
        <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
          Formulir Peserta Family Camp
        </h1>
        <p class="text-slate-500 text-xs sm:text-sm max-w-lg mx-auto leading-relaxed">
          Pendaftaran keluarga maupun kelompok/perorangan dengan paket wajib dan opsi perlengkapan tambahan.
        </p>
      </div>

      <!-- Closed Banner (jika pendaftaran ditutup admin) -->
      <div id="closedBanner" class="hidden p-4 rounded-2xl bg-amber-50 border border-amber-200 text-amber-900 flex items-start gap-3">
        <svg class="w-5 h-5 shrink-0 text-amber-600 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <div>
          <h3 class="font-bold text-sm">Pendaftaran Sedang Ditutup</h3>
          <p class="text-xs text-amber-800 mt-0.5">Mohon maaf, kuota pendaftaran Family Camp saat ini sedang ditutup oleh panitia.</p>
          <a href="/" class="inline-block mt-2 text-xs font-bold text-primary-700 hover:underline">← Kembali ke Beranda</a>
        </div>
      </div>

      <!-- Wizard Step Indicator -->
      <div id="wizardHeader" class="bg-white rounded-2xl p-3 sm:p-4 border border-slate-200/90 shadow-xs">
        <div class="grid grid-cols-4 gap-1.5 sm:gap-2 text-center">
          <div id="stepTab1" class="step-tab active py-2 px-1 rounded-xl transition font-bold text-[11px] sm:text-xs">
            <span class="block text-[10px] sm:text-[11px] text-primary-600 font-mono">1</span>
            <span>Tipe & PIC</span>
          </div>
          <div id="stepTab2" class="step-tab py-2 px-1 rounded-xl transition font-semibold text-[11px] sm:text-xs text-slate-400">
            <span class="block text-[10px] sm:text-[11px] font-mono">2</span>
            <span>Biodata</span>
          </div>
          <div id="stepTab3" class="step-tab py-2 px-1 rounded-xl transition font-semibold text-[11px] sm:text-xs text-slate-400">
            <span class="block text-[10px] sm:text-[11px] font-mono">3</span>
            <span>Paket & Sewa</span>
          </div>
          <div id="stepTab4" class="step-tab py-2 px-1 rounded-xl transition font-semibold text-[11px] sm:text-xs text-slate-400">
            <span class="block text-[10px] sm:text-[11px] font-mono">4</span>
            <span>Ringkasan</span>
          </div>
        </div>
      </div>

      <!-- Form Card Multi-Step -->
      <form id="formFamilyCamp" novalidate class="bg-white rounded-3xl p-5 sm:p-8 border border-slate-200/90 shadow-sm space-y-6">

        <!-- ======================================================== -->
        <!-- STEP 1: PILIH TIPE PENDAFTARAN & KONTAK PIC               -->
        <!-- ======================================================== -->
        <div id="stepContent1" class="step-content space-y-5">
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1.5">
              Pilih Kategori Pendaftaran <span class="text-rose-500">*</span>
            </label>
            <!-- Kontrol Segmented Ringkas, Clean & Hemat Ruang di Mobile -->
            <div class="grid grid-cols-2 gap-1.5 p-1 bg-slate-100 rounded-xl border border-slate-200/80">
              <!-- Pilihan Keluarga -->
              <label class="cursor-pointer">
                <input type="radio" name="tipe_pendaftaran" value="keluarga" checked class="peer sr-only" />
                <div class="py-2.5 px-3 rounded-lg flex items-center justify-center gap-2 font-bold text-xs sm:text-sm text-slate-600 transition peer-checked:bg-white peer-checked:text-primary-700 peer-checked:shadow-xs border border-transparent peer-checked:border-slate-200/60">
                  <svg class="w-4 h-4 shrink-0 text-slate-400 peer-checked:text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                  </svg>
                  <span>Keluarga</span>
                </div>
              </label>

              <!-- Pilihan Non-Keluarga -->
              <label class="cursor-pointer">
                <input type="radio" name="tipe_pendaftaran" value="non_keluarga" class="peer sr-only" />
                <div class="py-2.5 px-3 rounded-lg flex items-center justify-center gap-2 font-bold text-xs sm:text-sm text-slate-600 transition peer-checked:bg-white peer-checked:text-primary-700 peer-checked:shadow-xs border border-transparent peer-checked:border-slate-200/60">
                  <svg class="w-4 h-4 shrink-0 text-slate-400 peer-checked:text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                  </svg>
                  <span class="truncate">Non-Keluarga</span>
                </div>
              </label>
            </div>
            <p class="text-[11px] text-slate-400 mt-1.5">
              Pilih <span class="font-medium text-slate-600">Keluarga</span> untuk ayah, ibu & anak, atau <span class="font-medium text-slate-600">Non-Keluarga</span> untuk perorangan/rombongan.
            </p>
          </div>

          <!-- Data Kontak Penanggung Jawab (PIC) -->
          <div class="pt-4 border-t border-slate-100 space-y-4">
            <div>
              <h3 class="text-sm font-extrabold text-slate-900">Kontak Penanggung Jawab (PIC)</h3>
              <p class="text-xs text-slate-500">Nomor ini akan menerima invoice pembayaran & link tiket QR resmi.</p>
            </div>

            <div>
              <label for="pic_nama" class="block text-xs font-bold text-slate-700 mb-1">
                Nama Lengkap PIC <span class="text-rose-500">*</span>
              </label>
              <input
                type="text"
                id="pic_nama"
                name="pic_nama"
                required
                placeholder="Contoh: Budi Santoso"
                class="w-full border border-slate-300 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-primary-500/20 focus:border-primary-600 outline-none transition"
              />
            </div>

            <div>
              <label for="pic_whatsapp" class="block text-xs font-bold text-slate-700 mb-1">
                Nomor WhatsApp Aktif PIC <span class="text-rose-500">*</span>
              </label>
              <input
                type="tel"
                id="pic_whatsapp"
                name="pic_whatsapp"
                required
                inputmode="numeric"
                maxlength="15"
                placeholder="Contoh: 081234567890"
                class="w-full border border-slate-300 rounded-xl px-4 py-3 text-sm font-mono focus:ring-2 focus:ring-primary-500/20 focus:border-primary-600 outline-none transition"
              />
              <p class="text-[11px] text-slate-400 mt-1">Hanya angka, 10 - 15 digit (untuk invoice & link tiket QR).</p>
            </div>

            <div>
              <label for="pic_email" class="block text-xs font-bold text-slate-700 mb-1">
                Alamat Email <span class="text-slate-400 font-normal">(Opsional)</span>
              </label>
              <input
                type="email"
                id="pic_email"
                name="pic_email"
                placeholder="nama@email.com"
                class="w-full border border-slate-300 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-primary-500/20 focus:border-primary-600 outline-none transition"
              />
            </div>

            <!-- Domisili Asal (Provinsi & Kota/Kabupaten) -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
              <div>
                <label for="pic_provinsi" class="block text-xs font-bold text-slate-700 mb-1">
                  Provinsi Asal <span class="text-rose-500">*</span>
                </label>
                <select
                  id="pic_provinsi"
                  name="pic_provinsi"
                  required
                  class="w-full border border-slate-300 rounded-xl px-3.5 py-3 text-xs sm:text-sm bg-white focus:ring-2 focus:ring-primary-500/20 focus:border-primary-600 outline-none transition text-slate-800 font-medium cursor-pointer"
                >
                  <option value="" disabled selected>Pilih Provinsi...</option>
                  {LIST_PROVINSI.map((prov) => (
                    <option value={prov}>{prov}</option>
                  ))}
                </select>
              </div>

              <div>
                <label for="pic_kota" class="block text-xs font-bold text-slate-700 mb-1">
                  Kota / Kabupaten <span class="text-rose-500">*</span>
                </label>
                <select
                  id="pic_kota"
                  name="pic_kota"
                  required
                  disabled
                  class="w-full border border-slate-300 rounded-xl px-3.5 py-3 text-xs sm:text-sm bg-slate-50 focus:bg-white focus:ring-2 focus:ring-primary-500/20 focus:border-primary-600 outline-none transition text-slate-800 font-medium cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
                >
                  <option value="" disabled selected>Pilih Provinsi terlebih dahulu...</option>
                </select>
              </div>
            </div>
          </div>

          <div class="pt-2 flex justify-end">
            <button
              type="button"
              id="btnNextStep1"
              class="px-6 py-3 bg-primary-600 hover:bg-primary-700 text-white font-bold text-xs sm:text-sm rounded-xl transition shadow-xs active:scale-95 cursor-pointer"
            >
              Lanjut ke Biodata Anggota →
            </button>
          </div>
        </div>

        <!-- ======================================================== -->
        <!-- STEP 2: BIODATA DINAMIS SETIAP ANGGOTA                    -->
        <!-- ======================================================== -->
        <div id="stepContent2" class="step-content hidden space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <div>
              <h2 class="text-base font-extrabold text-slate-900 mb-0.5">2. Biodata Seluruh Peserta</h2>
              <p class="text-xs text-slate-500">Lengkapi data diri setiap anggota yang ikut dalam acara.</p>
            </div>
            <button
              type="button"
              id="btnAddAnggota"
              class="self-start sm:self-auto inline-flex items-center gap-1.5 px-3.5 py-2 bg-primary-50 hover:bg-primary-100 text-primary-700 border border-primary-200 rounded-xl text-xs font-bold transition active:scale-95 cursor-pointer"
            >
              <span>+ Tambah Anggota</span>
            </button>
          </div>

          <!-- Container Kartu-kartu Anggota Dinamis -->
          <div id="anggotaContainer" class="space-y-4">
            <!-- Rendered via JS -->
          </div>

          <!-- Alert Khusus Balita -->
          <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-950 text-xs flex items-start gap-3">
            <svg class="w-5 h-5 shrink-0 text-emerald-600 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <div>
              <span class="font-bold block">Kebijakan Anak & Balita:</span>
              <p class="text-[11px] text-emerald-800 mt-0.5 leading-relaxed">
                Anak balita di bawah usia <b>3 tahun</b> mendapatkan tiket <b>GRATIS</b> (tidak dikenakan biaya wajib). Anak usia 3 tahun ke atas dikenakan paket penuh Rp 200.000 dengan fasilitas lengkap.
              </p>
            </div>
          </div>

          <!-- Notice Khusus Kategori Keluarga Minimal 2 Orang -->
          <div id="noticeMinKeluarga" class="hidden p-4 rounded-2xl bg-amber-50 border border-amber-200 text-amber-950 text-xs flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-xs">
            <div class="flex items-start sm:items-center gap-2.5">
              <svg class="w-5 h-5 shrink-0 text-amber-600 mt-0.5 sm:mt-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              <div>
                <span class="font-extrabold block text-amber-900">Kategori Keluarga Minimal 2 Peserta</span>
                <p class="text-[11px] text-amber-800 mt-0.5 leading-relaxed">
                  Pendaftaran <b>Keluarga</b> minimal terdiri dari 2 orang (misal: Ayah &amp; Ibu, atau Orang Tua &amp; Anak). Silakan tambah anggota, atau beralih ke kategori Non-Keluarga jika mendaftar perorangan/sendiri.
                </p>
              </div>
            </div>
            <button
              type="button"
              id="btnSwitchNonKeluarga"
              class="self-start sm:self-center px-3.5 py-2 bg-amber-200 hover:bg-amber-300 text-amber-950 font-bold rounded-xl text-xs transition cursor-pointer shrink-0 active:scale-95 whitespace-nowrap"
            >
              Pindah ke Non-Keluarga →
            </button>
          </div>

          <div class="pt-2 flex items-center justify-between">
            <button
              type="button"
              id="btnPrevStep2"
              class="px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-xl transition"
            >
              ← Kembali
            </button>
            <button
              type="button"
              id="btnNextStep2"
              class="px-6 py-3 bg-primary-600 hover:bg-primary-700 text-white font-bold text-xs sm:text-sm rounded-xl transition shadow-xs active:scale-95 cursor-pointer"
            >
              Lanjut ke Pilihan Paket →
            </button>
          </div>
        </div>

        <!-- ======================================================== -->
        <!-- STEP 3: PAKET WAJIB & SEWA ADD-ON                         -->
        <!-- ======================================================== -->
        <div id="stepContent3" class="step-content hidden space-y-6">
          <div>
            <h2 class="text-base font-extrabold text-slate-900 mb-1">3. Paket & Perlengkapan Acara</h2>
            <p class="text-xs text-slate-500">Pilih fasilitas wajib dan perlengkapan sewa tambahan jika diperlukan.</p>
          </div>

          <!-- Card Paket Wajib -->
          <div class="p-5 sm:p-6 rounded-2xl bg-gradient-to-br from-primary-900 to-slate-900 text-white space-y-4 shadow-sm">
            <div class="flex items-start justify-between gap-3">
              <div>
                <span class="inline-block px-2.5 py-0.5 bg-white/20 text-white rounded text-[10px] font-black uppercase tracking-wider mb-1">
                  Paket Pendaftaran Wajib
                </span>
                <h3 class="text-lg font-black text-amber-300">Rp 200.000 <span class="text-xs text-white/70 font-normal">/ orang</span></h3>
              </div>
              <div class="text-right">
                <span class="text-[10px] text-slate-300 uppercase tracking-wider block">Peserta Berbayar</span>
                <span class="text-lg font-black text-white font-mono" id="txtTotalBerbayarBadge">0 Orang</span>
              </div>
            </div>

            <!-- Fasilitas yang Didapat -->
            <div class="pt-3 border-t border-white/10 space-y-2 text-xs">
              <span class="font-bold text-slate-200 block text-[11px] uppercase tracking-wider">Fasilitas yang Didapatkan:</span>
              <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-[11px] text-slate-300">
                <li class="flex items-center gap-1.5"><span class="text-emerald-400 font-bold">✓</span><span>Majelis Ilmu</span></li>
                <li class="flex items-center gap-1.5"><span class="text-emerald-400 font-bold">✓</span><span>Makan 3x + Air Mineral</span></li>
                <li class="flex items-center gap-1.5"><span class="text-emerald-400 font-bold">✓</span><span>Berkumpul Bersama</span></li>
                <li class="flex items-center gap-1.5"><span class="text-emerald-400 font-bold">✓</span><span>BBQ & Sosis Bakar</span></li>
                <li class="flex items-center gap-1.5"><span class="text-emerald-400 font-bold">✓</span><span>Teman-Teman Shalih</span></li>
                <li class="flex items-center gap-1.5"><span class="text-emerald-400 font-bold">✓</span><span>Snack</span></li>
                <li class="flex items-center gap-1.5"><span class="text-emerald-400 font-bold">✓</span><span>Games Edukatif & Seru</span></li>
                <li class="flex items-center gap-1.5"><span class="text-emerald-400 font-bold">✓</span><span>Kopi & Teh</span></li>
                <li class="flex items-center gap-1.5"><span class="text-emerald-400 font-bold">✓</span><span>Doorprize Menarik</span></li>
                <li class="flex items-center gap-1.5"><span class="text-emerald-400 font-bold">✓</span><span>Kamar Mandi</span></li>
                <li class="flex items-center gap-1.5 sm:col-span-2"><span class="text-emerald-400 font-bold">✓</span><span>Area Parkir</span></li>
              </ul>
            </div>

            <!-- Kalkulasi Subtotal Wajib -->
            <div class="pt-3 border-t border-white/10 flex justify-between items-center text-xs">
              <span class="text-slate-300">Subtotal Biaya Wajib:</span>
              <span class="text-base font-black text-amber-300 font-mono" id="txtSubtotalWajibStep3">Rp 0</span>
            </div>
          </div>

          <!-- Pertanyaan Opsi Sewa Add-on -->
          <div class="space-y-3 pt-2">
            <div>
              <h3 class="text-sm font-extrabold text-slate-900">Opsi Sewa Perlengkapan Tambahan</h3>
              <p class="text-xs text-slate-500 mt-0.5">Pilih "Hanya Paket Wajib" jika Anda membawa tenda sendiri dari rumah.</p>
            </div>

            <div class="grid grid-cols-2 gap-1.5 p-1 bg-slate-100 rounded-xl border border-slate-200/80">
              <label class="cursor-pointer">
                <input type="radio" name="opt_sewa" value="tidak" checked class="peer sr-only" />
                <div class="py-2.5 px-3 rounded-lg flex items-center justify-center gap-1.5 font-bold text-xs sm:text-sm text-slate-600 transition peer-checked:bg-white peer-checked:text-primary-700 peer-checked:shadow-xs border border-transparent peer-checked:border-slate-200/60">
                  <svg class="w-4 h-4 shrink-0 text-slate-400 peer-checked:text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  <span class="truncate">Hanya Paket Wajib</span>
                </div>
              </label>

              <label class="cursor-pointer">
                <input type="radio" name="opt_sewa" value="ya" class="peer sr-only" />
                <div class="py-2.5 px-3 rounded-lg flex items-center justify-center gap-1.5 font-bold text-xs sm:text-sm text-slate-600 transition peer-checked:bg-white peer-checked:text-primary-700 peer-checked:shadow-xs border border-transparent peer-checked:border-slate-200/60">
                  <svg class="w-4 h-4 shrink-0 text-slate-400 peer-checked:text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                  </svg>
                  <span class="truncate">+ Sewa Perlengkapan</span>
                </div>
              </label>
            </div>
          </div>

          <!-- Katalog Add-on Dinamis (Tampil saat pilih "ya") -->
          <div id="containerAddons" class="hidden space-y-3 pt-2">
            <div class="flex items-center justify-between">
              <h4 class="text-xs font-bold text-slate-700 uppercase tracking-wider">Katalog Perlengkapan Sewa</h4>
              <span class="text-[10px] text-slate-400">Pilih jumlah item sesuai kebutuhan</span>
            </div>

            <div id="listAddonsCards" class="space-y-2.5">
              <!-- Rendered via JS dari endpoint /api/peserta/addon-items -->
            </div>
          </div>

          <!-- Total Biaya Floating Box -->
          <div class="p-4 rounded-2xl bg-slate-100 border border-slate-200/90 flex justify-between items-center text-xs">
            <div>
              <span class="text-slate-500 font-semibold block">Total Sementara (Wajib + Sewa):</span>
            </div>
            <span class="text-lg font-black text-slate-900 font-mono" id="txtTotalSementara">Rp 0</span>
          </div>

          <div class="pt-2 flex items-center justify-between">
            <button
              type="button"
              id="btnPrevStep3"
              class="px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-xl transition"
            >
              ← Kembali
            </button>
            <button
              type="button"
              id="btnNextStep3"
              class="px-6 py-3 bg-primary-600 hover:bg-primary-700 text-white font-bold text-xs sm:text-sm rounded-xl transition shadow-xs active:scale-95 cursor-pointer"
            >
              Lihat Ringkasan & Konfirmasi →
            </button>
          </div>
        </div>

        <!-- ======================================================== -->
        <!-- STEP 4: RINGKASAN & SUBMIT PENDAFTARAN                    -->
        <!-- ======================================================== -->
        <div id="stepContent4" class="step-content hidden space-y-6">
          <div>
            <h2 class="text-base font-extrabold text-slate-900 mb-1">4. Ringkasan Pendaftaran</h2>
            <p class="text-xs text-slate-500">Periksa kembali data diri dan paket sebelum melanjutkan ke pembayaran.</p>
          </div>

          <!-- Card Rekapitulasi Data -->
          <div class="rounded-2xl border border-slate-200 bg-slate-50/70 p-5 space-y-4 text-xs">
            <div class="flex justify-between items-center pb-3 border-b border-slate-200">
              <div>
                <span class="text-[10px] text-slate-400 uppercase tracking-wider block font-bold">Kategori</span>
                <span class="font-extrabold text-slate-900 text-sm" id="rekapTipe">-</span>
              </div>
              <div class="text-right">
                <span class="text-[10px] text-slate-400 uppercase tracking-wider block font-bold">PIC Pendaftaran</span>
                <span class="font-bold text-slate-800" id="rekapPicNama">-</span>
                <span class="text-[11px] text-slate-500 block font-mono" id="rekapPicWa">-</span>
                <span class="text-[10px] text-slate-400 block font-medium" id="rekapPicDomisili">-</span>
              </div>
            </div>

            <!-- Rekap Anggota -->
            <div>
              <span class="text-[10px] text-slate-400 uppercase tracking-wider font-bold block mb-1.5">Daftar Anggota (<span id="rekapJmlAnggota">0</span> Peserta):</span>
              <ul id="rekapAnggotaList" class="space-y-1.5 divide-y divide-slate-100 bg-white p-3 rounded-xl border border-slate-200">
                <!-- Dinamis via JS -->
              </ul>
            </div>

            <!-- Rekap Biaya -->
            <div class="pt-2 border-t border-slate-200 space-y-2">
              <div class="flex justify-between text-slate-600">
                <span>Biaya Paket Wajib (<span id="rekapHitungWajib">0</span> x Rp 200.000):</span>
                <span class="font-bold text-slate-900" id="rekapBiayaWajib">Rp 0</span>
              </div>

              <div id="rekapAddonsList" class="space-y-1 pl-3 border-l-2 border-slate-200">
                <!-- Dinamis via JS -->
              </div>
            </div>
          </div>

          <div class="p-4 rounded-2xl bg-amber-50 border border-amber-200 text-amber-950 text-xs flex items-start gap-3">
            <svg class="w-5 h-5 shrink-0 text-amber-600 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <div>
              <span class="font-bold block">Setelah Klik Daftar:</span>
              <p class="text-[11px] text-amber-800 mt-0.5 leading-relaxed">
                Anda akan langsung dialihkan ke halaman konfirmasi pembayaran yang memuat rekening bank panitia, total nominal transfer, tombol kirim bukti transfer, serta tombol simpan link ke WhatsApp Anda.
              </p>
            </div>
          </div>

          <!-- Alert Error Submit -->
          <div id="submitError" class="hidden p-3.5 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs font-bold"></div>

          <div class="pt-2 flex items-center justify-between">
            <button
              type="button"
              id="btnPrevStep4"
              class="px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-xl transition"
            >
              ← Kembali
            </button>
            <button
              type="submit"
              id="btnFinalSubmit"
              class="px-7 py-3.5 bg-primary-600 hover:bg-primary-700 text-white font-extrabold text-sm rounded-xl transition shadow-md active:scale-95 cursor-pointer"
            >
              Daftar & Lanjut ke Pembayaran →
            </button>
          </div>
        </div>

      </form>

    </div>
  </section>

  <script>
    import { DATA_WILAYAH } from '../data/wilayah';

    const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:8787';

    interface AnggotaItem {
      nama: string;
      peran: string;
      jenis_kelamin: string;
      usia: number | null;
      ukuran_kaos: string;
      catatan_medis: string;
      beda_domisili?: boolean;
      provinsi?: string;
      kota?: string;
    }

    interface AddonItem {
      id: string;
      nama: string;
      deskripsi: string;
      harga: number;
      stok: number;
      aktif: number;
      urutan: number;
    }

    let currentStep = 1;
    let catalogAddons: AddonItem[] = [];
    let selectedAddonQty: { [addonId: string]: number } = {};

    let anggotaData: AnggotaItem[] = [
      { nama: '', peran: 'Ayah', jenis_kelamin: 'Ikhwan', usia: 35, ukuran_kaos: '-', catatan_medis: '', beda_domisili: false, provinsi: '', kota: '' }
    ];

    function getLockedGenderForPeran(peran: string): 'Ikhwan' | 'Akhwat' | null {
      if (['Ayah', 'Kakek', 'Paman'].includes(peran)) return 'Ikhwan';
      if (['Ibu', 'Nenek', 'Bibi'].includes(peran)) return 'Akhwat';
      return null; // Anak, Saudara Kandung, Sepupu, Peserta -> bebas pilih
    }

    let toastTimeout: any = null;
    function showFloatingToast(message: string, isError = true) {
      const toast = document.getElementById('floatingToast');
      const msgEl = document.getElementById('floatingToastMsg');
      const iconEl = document.getElementById('floatingToastIcon');
      if (!toast || !msgEl || !iconEl) return;

      if (toastTimeout) {
        clearTimeout(toastTimeout);
      }

      msgEl.textContent = message;
      if (isError) {
        iconEl.className = 'w-5 h-5 shrink-0 text-rose-400 flex items-center justify-center';
        iconEl.innerHTML = `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>`;
      } else {
        iconEl.className = 'w-5 h-5 shrink-0 text-emerald-400 flex items-center justify-center';
        iconEl.innerHTML = `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>`;
      }

      toast.classList.remove('opacity-0', '-translate-y-4', 'scale-95');
      toast.classList.add('opacity-100', 'translate-y-0', 'scale-100');

      toastTimeout = setTimeout(() => {
        toast.classList.remove('opacity-100', 'translate-y-0', 'scale-100');
        toast.classList.add('opacity-0', '-translate-y-4', 'scale-95');
      }, 3500);
    }

    function markInvalid(element: HTMLElement | null) {
      if (!element) return;
      element.classList.remove('border-slate-300', 'focus:border-primary-600', 'focus:ring-primary-500/20');
      element.classList.add('!border-rose-500', '!ring-2', '!ring-rose-200', 'bg-rose-50/30');
    }

    function clearInvalid(element: HTMLElement | null) {
      if (!element) return;
      element.classList.remove('!border-rose-500', '!ring-2', '!ring-rose-200', 'bg-rose-50/30');
      element.classList.add('border-slate-300', 'focus:border-primary-600', 'focus:ring-primary-500/20');
    }

    function bindClearOnInput(element: HTMLInputElement) {
      const handler = () => {
        clearInvalid(element);
        element.removeEventListener('input', handler);
        element.removeEventListener('change', handler);
      };
      element.addEventListener('input', handler);
      element.addEventListener('change', handler);
    }

    async function initFamilyCampForm() {
      const form = document.getElementById('formFamilyCamp');
      if (!form) return;
      if (form.dataset.initialized === 'true') return;
      form.dataset.initialized = 'true';

      checkQuotaStatus();
      await fetchAddonCatalog();
      setupWilayahSelector();
      setupStepNavigation();
      renderAnggotaForms();
      setupAddonInteractions();
      setupFinalSubmit();
    }

    function setupWilayahSelector() {
      const picProvinsiSelect = document.getElementById('pic_provinsi') as HTMLSelectElement | null;
      const picKotaSelect = document.getElementById('pic_kota') as HTMLSelectElement | null;

      if (!picProvinsiSelect || !picKotaSelect) return;

      picProvinsiSelect.addEventListener('change', () => {
        clearInvalid(picProvinsiSelect);
        const prov = picProvinsiSelect.value;
        const kotaList = DATA_WILAYAH[prov] || [];

        if (kotaList.length === 0) {
          picKotaSelect.innerHTML = '<option value="" disabled selected>Pilih Provinsi terlebih dahulu...</option>';
          picKotaSelect.disabled = true;
          picKotaSelect.classList.add('bg-slate-50', 'disabled:opacity-50', 'disabled:cursor-not-allowed');
        } else {
          picKotaSelect.disabled = false;
          picKotaSelect.classList.remove('bg-slate-50', 'disabled:opacity-50', 'disabled:cursor-not-allowed');
          picKotaSelect.innerHTML = `
            <option value="" disabled selected>Pilih Kota / Kabupaten...</option>
            ${kotaList.map((kota) => `<option value="${kota}">${kota}</option>`).join('')}
          `;
        }
        clearInvalid(picKotaSelect);
      });

      picKotaSelect.addEventListener('change', () => {
        clearInvalid(picKotaSelect);
      });
    }

    async function checkQuotaStatus() {
      try {
        const res = await fetch(`${API_URL}/api/peserta/config`);
        const config = await res.json();
        if (config && config.pendaftaran_buka === false) {
          const banner = document.getElementById('closedBanner');
          const form = document.getElementById('formFamilyCamp');
          const wizard = document.getElementById('wizardHeader');
          if (banner) banner.classList.remove('hidden');
          if (form) form.classList.add('hidden');
          if (wizard) wizard.classList.add('hidden');
        }
      } catch (err) {}
    }

    async function fetchAddonCatalog() {
      try {
        const res = await fetch(`${API_URL}/api/peserta/addon-items`);
        const json = await res.json();
        if (res.ok && Array.isArray(json.data)) {
          catalogAddons = json.data;
          renderAddonsCatalog();
        }
      } catch (err) {
        console.warn('Gagal load addon items:', err);
      }
    }

    function checkKeluargaConstraint(): boolean {
      const tipe = getSelectedTipe();
      const noticeMinKeluarga = document.getElementById('noticeMinKeluarga');
      const btnNextStep2 = document.getElementById('btnNextStep2') as HTMLButtonElement | null;

      if (tipe === 'keluarga' && anggotaData.length < 2) {
        if (noticeMinKeluarga) noticeMinKeluarga.classList.remove('hidden');
        if (btnNextStep2) {
          btnNextStep2.classList.add('opacity-40', 'cursor-not-allowed');
          btnNextStep2.setAttribute('title', 'Kategori Keluarga minimal 2 peserta');
        }
        return false;
      } else {
        if (noticeMinKeluarga) noticeMinKeluarga.classList.add('hidden');
        if (btnNextStep2) {
          btnNextStep2.classList.remove('opacity-40', 'cursor-not-allowed');
          btnNextStep2.removeAttribute('title');
        }
        return true;
      }
    }

    function setupStepNavigation() {
      const btnNextStep1 = document.getElementById('btnNextStep1');
      const btnNextStep2 = document.getElementById('btnNextStep2');
      const btnPrevStep2 = document.getElementById('btnPrevStep2');
      const btnNextStep3 = document.getElementById('btnNextStep3');
      const btnPrevStep3 = document.getElementById('btnPrevStep3');
      const btnPrevStep4 = document.getElementById('btnPrevStep4');

      const picNamaInput = document.getElementById('pic_nama') as HTMLInputElement | null;
      const picWaInput = document.getElementById('pic_whatsapp') as HTMLInputElement | null;
      const picProvinsiSelect = document.getElementById('pic_provinsi') as HTMLSelectElement | null;
      const picKotaSelect = document.getElementById('pic_kota') as HTMLSelectElement | null;

      if (picProvinsiSelect) {
        picProvinsiSelect.addEventListener('change', () => clearInvalid(picProvinsiSelect));
      }
      if (picKotaSelect) {
        picKotaSelect.addEventListener('change', () => clearInvalid(picKotaSelect));
      }

      // Filter ketat WhatsApp: Hanya bisa input angka & maksimal 15 digit
      if (picWaInput) {
        picWaInput.addEventListener('input', () => {
          const raw = picWaInput.value;
          const clean = raw.replace(/\D/g, '').slice(0, 15);
          if (raw !== clean) {
            picWaInput.value = clean;
          }
        });

        picWaInput.addEventListener('keydown', (e) => {
          if (
            ['Backspace', 'Delete', 'Tab', 'Escape', 'Enter', 'ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'Home', 'End'].includes(e.key) ||
            e.ctrlKey || e.metaKey
          ) {
            return;
          }
          if (!/^[0-9]$/.test(e.key)) {
            e.preventDefault();
          }
        });

        picWaInput.addEventListener('paste', (e) => {
          e.preventDefault();
          const pasteData = (e.clipboardData || (window as any).clipboardData)?.getData('text') || '';
          const clean = pasteData.replace(/\D/g, '').slice(0, 15);
          const start = picWaInput.selectionStart || 0;
          const end = picWaInput.selectionEnd || 0;
          const oldVal = picWaInput.value;
          picWaInput.value = (oldVal.slice(0, start) + clean + oldVal.slice(end)).slice(0, 15);
          picWaInput.dispatchEvent(new Event('input'));
        });
      }

      if (btnNextStep1) {
        btnNextStep1.onclick = () => {
          const picNama = (picNamaInput?.value || '').trim();
          const rawWa = picWaInput?.value || '';
          const cleanWa = rawWa.replace(/\D/g, '');
          const picProvinsi = (picProvinsiSelect?.value || '').trim();
          const picKota = (picKotaSelect?.value || '').trim();

          let hasError = false;
          let firstInvalid: HTMLElement | null = null;

          // Validasi Kota/Kabupaten
          if (!picKota) {
            markInvalid(picKotaSelect);
            firstInvalid = picKotaSelect;
            hasError = true;
          } else {
            clearInvalid(picKotaSelect);
          }

          // Validasi Provinsi
          if (!picProvinsi) {
            markInvalid(picProvinsiSelect);
            firstInvalid = picProvinsiSelect;
            hasError = true;
          } else {
            clearInvalid(picProvinsiSelect);
          }

          // Validasi WhatsApp: Wajib angka, min 10 digit, max 15 digit
          if (!cleanWa || cleanWa.length < 10 || cleanWa.length > 15) {
            markInvalid(picWaInput);
            if (picWaInput) bindClearOnInput(picWaInput);
            firstInvalid = picWaInput;
            hasError = true;
          } else {
            clearInvalid(picWaInput);
          }

          // Validasi Nama PIC: Wajib minimal 2 huruf
          if (!picNama || picNama.length < 2) {
            markInvalid(picNamaInput);
            if (picNamaInput) bindClearOnInput(picNamaInput);
            firstInvalid = picNamaInput; // Urutan fokus prioritas Nama PIC di atas
            hasError = true;
          } else {
            clearInvalid(picNamaInput);
          }

          if (hasError) {
            if (firstInvalid) {
              firstInvalid.focus();
              firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }

            if ((!picNama || picNama.length < 2) && (!cleanWa || cleanWa.length < 10)) {
              showFloatingToast('Mohon lengkapi kolom yang ditandai merah.');
            } else if (!picNama || picNama.length < 2) {
              showFloatingToast('Mohon lengkapi Nama Lengkap PIC.');
            } else if (cleanWa.length < 10) {
              showFloatingToast('Nomor WhatsApp minimal 10 digit angka.');
            } else if (cleanWa.length > 15) {
              showFloatingToast('Nomor WhatsApp maksimal 15 digit angka.');
            } else if (!picProvinsi || !picKota) {
              showFloatingToast('Mohon lengkapi Provinsi dan Kota/Kabupaten domisili.');
            } else {
              showFloatingToast('Mohon lengkapi kolom yang ditandai merah.');
            }
            return;
          }

          // Set nama anggota pertama otomatis sama dengan PIC jika masih kosong
          if (anggotaData[0] && !anggotaData[0].nama) {
            anggotaData[0].nama = picNama;
            renderAnggotaForms();
          }

          goToStep(2);
          checkKeluargaConstraint();
        };
      }

      if (btnPrevStep2) {
        btnPrevStep2.onclick = () => goToStep(1);
      }

      if (btnNextStep2) {
        btnNextStep2.onclick = () => {
          syncAnggotaFromDOM();

          // Cek constraint minimal 2 peserta untuk kategori keluarga
          if (!checkKeluargaConstraint()) {
            const noticeMinKeluarga = document.getElementById('noticeMinKeluarga');
            if (noticeMinKeluarga) {
              noticeMinKeluarga.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
            showFloatingToast('Kategori Keluarga minimal 2 orang peserta. Tambah anggota atau pindah ke Non-Keluarga.');
            return;
          }

          const cards = document.querySelectorAll('.anggota-card');
          let hasError = false;
          let firstInvalid: HTMLElement | null = null;

          cards.forEach((card) => {
            const inputNama = card.querySelector('.input-nama') as HTMLInputElement | null;
            if (inputNama) {
              const val = inputNama.value.trim();
              if (!val || val.length < 2) {
                markInvalid(inputNama);
                bindClearOnInput(inputNama);
                if (!firstInvalid) firstInvalid = inputNama;
                hasError = true;
              } else {
                clearInvalid(inputNama);
              }
            }

            const cbDomisili = card.querySelector('.cb-beda-domisili') as HTMLInputElement | null;
            if (cbDomisili && cbDomisili.checked) {
              const selectProv = card.querySelector('.select-provinsi-anggota') as HTMLSelectElement | null;
              const selectKota = card.querySelector('.select-kota-anggota') as HTMLSelectElement | null;

              if (selectProv && !selectProv.value) {
                markInvalid(selectProv);
                if (!firstInvalid) firstInvalid = selectProv;
                hasError = true;
              } else if (selectProv) {
                clearInvalid(selectProv);
              }

              if (selectKota && !selectKota.value) {
                markInvalid(selectKota);
                if (!firstInvalid) firstInvalid = selectKota;
                hasError = true;
              } else if (selectKota) {
                clearInvalid(selectKota);
              }
            }
          });

          if (hasError) {
            if (firstInvalid) {
              firstInvalid.focus();
              firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
            showFloatingToast('Mohon lengkapi kolom yang ditandai merah.');
            return;
          }

          updateStep3Summary();
          goToStep(3);
        };
      }

      if (btnPrevStep3) {
        btnPrevStep3.onclick = () => goToStep(2);
      }

      if (btnNextStep3) {
        btnNextStep3.onclick = () => {
          updateStep4Review();
          goToStep(4);
        };
      }

      if (btnPrevStep4) {
        btnPrevStep4.onclick = () => goToStep(3);
      }

      // Tombol pindah ke Non-Keluarga dari notif constraint
      const btnSwitch = document.getElementById('btnSwitchNonKeluarga');
      if (btnSwitch) {
        btnSwitch.onclick = () => {
          const radioNonKeluarga = document.querySelector('input[name="tipe_pendaftaran"][value="non_keluarga"]') as HTMLInputElement | null;
          if (radioNonKeluarga) {
            radioNonKeluarga.checked = true;
            radioNonKeluarga.dispatchEvent(new Event('change'));
            showFloatingToast('Kategori berhasil diubah ke Non-Keluarga.', false);
          }
        };
      }

      // Radio tipe change (Keluarga vs Non-Keluarga)
      const radioTipe = document.querySelectorAll('input[name="tipe_pendaftaran"]');
      radioTipe.forEach((r) => {
        r.addEventListener('change', () => {
          const tipe = getSelectedTipe();
          if (tipe === 'non_keluarga') {
            anggotaData.forEach((a) => (a.peran = 'Peserta'));
          } else {
            if (anggotaData[0]) anggotaData[0].peran = 'Ayah';
            if (anggotaData[1]) anggotaData[1].peran = 'Ibu';
            for (let i = 2; i < anggotaData.length; i++) {
              anggotaData[i].peran = 'Anak';
            }
          }
          renderAnggotaForms();
          checkKeluargaConstraint();
        });
      });

      // Tombol tambah anggota
      const btnAdd = document.getElementById('btnAddAnggota');
      if (btnAdd) {
        btnAdd.onclick = (e) => {
          e.preventDefault();
          syncAnggotaFromDOM();
          const tipe = getSelectedTipe();
          let peranBaru = 'Peserta';
          let jkBaru = 'Ikhwan';

          if (tipe === 'keluarga') {
            if (anggotaData.length === 1) {
              peranBaru = 'Ibu';
              jkBaru = 'Akhwat';
            } else {
              peranBaru = 'Anak';
              jkBaru = 'Ikhwan';
            }
          }

          anggotaData.push({
            nama: '',
            peran: peranBaru,
            jenis_kelamin: jkBaru,
            usia: 10,
            ukuran_kaos: '-',
            catatan_medis: '',
            beda_domisili: false,
            provinsi: '',
            kota: '',
          });
          renderAnggotaForms();
          checkKeluargaConstraint();
        };
      }
    }

    function getSelectedTipe(): 'keluarga' | 'non_keluarga' {
      const el = document.querySelector('input[name="tipe_pendaftaran"]:checked') as HTMLInputElement | null;
      return el && el.value === 'non_keluarga' ? 'non_keluarga' : 'keluarga';
    }

    function goToStep(step: number) {
      currentStep = step;
      for (let i = 1; i <= 4; i++) {
        const content = document.getElementById(`stepContent${i}`);
        const tab = document.getElementById(`stepTab${i}`);
        if (content && tab) {
          if (i === step) {
            content.classList.remove('hidden');
            tab.className = 'step-tab active py-2 px-1 rounded-xl transition font-extrabold text-[11px] sm:text-xs text-primary-800 bg-primary-50 border border-primary-200';
          } else if (i < step) {
            content.classList.add('hidden');
            tab.className = 'step-tab py-2 px-1 rounded-xl transition font-bold text-[11px] sm:text-xs text-emerald-700 bg-emerald-50/60 border border-emerald-200';
          } else {
            content.classList.add('hidden');
            tab.className = 'step-tab py-2 px-1 rounded-xl transition font-semibold text-[11px] sm:text-xs text-slate-400';
          }
        }
      }
      window.scrollTo({ top: 100, behavior: 'smooth' });
    }

    function syncAnggotaFromDOM() {
      const cards = document.querySelectorAll('.anggota-card');
      cards.forEach((card, idx) => {
        if (!anggotaData[idx]) return;
        const inputNama = card.querySelector('.input-nama') as HTMLInputElement | null;
        const selectPeran = card.querySelector('.select-peran') as HTMLSelectElement | null;
        const inputJk = card.querySelector('input[name^="jk_"]:checked') as HTMLInputElement | null;
        const inputUsia = card.querySelector('.input-usia') as HTMLInputElement | null;
        const inputMedis = card.querySelector('.input-medis') as HTMLInputElement | null;

        if (inputNama) anggotaData[idx].nama = inputNama.value.trim();
        if (selectPeran) {
          anggotaData[idx].peran = selectPeran.value;
          const locked = getLockedGenderForPeran(selectPeran.value);
          if (locked) {
            anggotaData[idx].jenis_kelamin = locked;
          }
        }
        if (inputJk && !getLockedGenderForPeran(anggotaData[idx].peran)) {
          anggotaData[idx].jenis_kelamin = inputJk.value;
        }
        if (inputUsia) anggotaData[idx].usia = inputUsia.value ? parseInt(inputUsia.value, 10) : null;
        anggotaData[idx].ukuran_kaos = '-';
        if (inputMedis) anggotaData[idx].catatan_medis = inputMedis.value.trim();

        const cbDomisili = card.querySelector('.cb-beda-domisili') as HTMLInputElement | null;
        const selectProvinsi = card.querySelector('.select-provinsi-anggota') as HTMLSelectElement | null;
        const selectKota = card.querySelector('.select-kota-anggota') as HTMLSelectElement | null;

        if (cbDomisili) {
          anggotaData[idx].beda_domisili = cbDomisili.checked;
          if (cbDomisili.checked) {
            if (selectProvinsi) anggotaData[idx].provinsi = selectProvinsi.value;
            if (selectKota) anggotaData[idx].kota = selectKota.value;
          } else {
            anggotaData[idx].provinsi = '';
            anggotaData[idx].kota = '';
          }
        }
      });
    }

    function renderAnggotaForms() {
      const container = document.getElementById('anggotaContainer');
      if (!container) return;

      const tipe = getSelectedTipe();

      container.innerHTML = anggotaData.map((a, idx) => {
        const isBalita = a.usia !== null && a.usia < 3;
        const lockedGender = tipe === 'keluarga' ? getLockedGenderForPeran(a.peran) : null;
        if (lockedGender) {
          a.jenis_kelamin = lockedGender;
        }

        return `
          <div class="anggota-card bg-slate-50/80 rounded-2xl p-4 sm:p-5 border border-slate-200 space-y-4" data-index="${idx}">
            <div class="flex items-center justify-between pb-3 border-b border-slate-200">
              <div class="card-header-left flex items-center gap-2">
                <span class="w-6 h-6 rounded-lg bg-primary-100 text-primary-800 font-mono font-bold text-xs flex items-center justify-center">${idx + 1}</span>
                <span class="font-extrabold text-xs sm:text-sm text-slate-800">Peserta #${idx + 1}</span>
                ${isBalita ? `<span class="badge-balita px-2 py-0.5 bg-emerald-100 text-emerald-800 rounded text-[10px] font-bold">Balita (Gratis)</span>` : ''}
              </div>
              ${anggotaData.length > 1 ? `
                <button type="button" class="btn-hapus-anggota text-xs text-rose-600 hover:text-rose-800 font-bold transition cursor-pointer" data-index="${idx}">
                  Hapus ✕
                </button>
              ` : ''}
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
              <!-- Nama Lengkap -->
              <div>
                <label class="block text-[11px] font-bold text-slate-700 mb-1">
                  Nama Lengkap <span class="text-rose-500">*</span>
                </label>
                <input
                  type="text"
                  required
                  value="${a.nama}"
                  placeholder="Nama Peserta"
                  class="input-nama w-full border border-slate-300 rounded-xl px-3.5 py-2.5 text-xs bg-white focus:ring-2 focus:ring-primary-500/20 focus:border-primary-600 outline-none transition"
                />
              </div>

              <!-- Peran / Status -->
              <div>
                <label class="block text-[11px] font-bold text-slate-700 mb-1">
                  Peran / Status <span class="text-rose-500">*</span>
                </label>
                ${tipe === 'keluarga' ? `
                  <select class="select-peran w-full border border-slate-300 rounded-xl px-3.5 py-2.5 text-xs bg-white focus:ring-2 focus:ring-primary-500/20 focus:border-primary-600 outline-none transition font-bold text-slate-800 cursor-pointer">
                    <option value="Ayah" ${a.peran === 'Ayah' ? 'selected' : ''}>Ayah</option>
                    <option value="Ibu" ${a.peran === 'Ibu' ? 'selected' : ''}>Ibu</option>
                    <option value="Anak" ${a.peran === 'Anak' ? 'selected' : ''}>Anak</option>
                    <option value="Kakek" ${a.peran === 'Kakek' ? 'selected' : ''}>Kakek</option>
                    <option value="Nenek" ${a.peran === 'Nenek' ? 'selected' : ''}>Nenek</option>
                    <option value="Paman" ${a.peran === 'Paman' ? 'selected' : ''}>Paman</option>
                    <option value="Bibi" ${a.peran === 'Bibi' ? 'selected' : ''}>Bibi</option>
                    <option value="Saudara Kandung" ${a.peran === 'Saudara Kandung' ? 'selected' : ''}>Saudara Kandung</option>
                    <option value="Sepupu" ${a.peran === 'Sepupu' ? 'selected' : ''}>Sepupu</option>
                  </select>
                ` : `
                  <input type="text" readonly value="Peserta" class="select-peran w-full border border-slate-200 rounded-xl px-3.5 py-2.5 text-xs bg-slate-100 text-slate-600 font-bold cursor-not-allowed" />
                `}
              </div>

              <!-- Jenis Kelamin -->
              <div>
                <label class="block text-[11px] font-bold text-slate-700 mb-1">
                  Jenis Kelamin <span class="text-rose-500">*</span>
                  ${lockedGender ? '<span class="text-[10px] text-primary-600 font-semibold ml-1">(Terkunci sesuai peran)</span>' : ''}
                </label>
                <div class="grid grid-cols-2 gap-2">
                  <label class="${lockedGender === 'Akhwat' ? 'opacity-40 cursor-not-allowed' : 'cursor-pointer'}">
                    <input
                      type="radio"
                      name="jk_${idx}"
                      value="Ikhwan"
                      ${a.jenis_kelamin === 'Ikhwan' ? 'checked' : ''}
                      ${lockedGender === 'Akhwat' ? 'disabled' : ''}
                      class="radio-jk peer sr-only"
                      data-index="${idx}"
                    />
                    <div class="text-center py-2.5 px-3 rounded-xl border border-slate-200 bg-white font-bold text-xs peer-checked:bg-primary-600 peer-checked:text-white peer-checked:border-primary-600 peer-disabled:bg-slate-100 peer-disabled:text-slate-400 peer-disabled:border-slate-200 transition shadow-2xs">
                      IKHWAN
                    </div>
                  </label>
                  <label class="${lockedGender === 'Ikhwan' ? 'opacity-40 cursor-not-allowed' : 'cursor-pointer'}">
                    <input
                      type="radio"
                      name="jk_${idx}"
                      value="Akhwat"
                      ${a.jenis_kelamin === 'Akhwat' ? 'checked' : ''}
                      ${lockedGender === 'Ikhwan' ? 'disabled' : ''}
                      class="radio-jk peer sr-only"
                      data-index="${idx}"
                    />
                    <div class="text-center py-2.5 px-3 rounded-xl border border-slate-200 bg-white font-bold text-xs peer-checked:bg-primary-600 peer-checked:text-white peer-checked:border-primary-600 peer-disabled:bg-slate-100 peer-disabled:text-slate-400 peer-disabled:border-slate-200 transition shadow-2xs">
                      AKHWAT
                    </div>
                  </label>
                </div>
              </div>

              <!-- Usia: Angka Besar, Jelas & Tidak Samar -->
              <div>
                <label class="block text-[11px] font-bold text-slate-700 mb-1">
                  Usia (Tahun) <span class="text-[10px] text-slate-400 font-normal">(Balita &lt; 3 th gratis)</span>
                </label>
                <input
                  type="number"
                  min="0"
                  max="100"
                  value="${a.usia !== null ? a.usia : ''}"
                  placeholder="Contoh: 7"
                  class="input-usia w-full border border-slate-300 rounded-xl px-4 py-2.5 text-base font-black text-slate-900 bg-white focus:ring-2 focus:ring-primary-500/20 focus:border-primary-600 outline-none transition font-mono placeholder:text-slate-300 placeholder:font-normal placeholder:text-xs"
                />
              </div>

              <!-- Catatan Medis & Obat yang Sering Digunakan/Dikonsumsi -->
              <div class="sm:col-span-2">
                <label class="block text-[11px] font-bold text-slate-700 mb-1">
                  Catatan Medis, Alergi & Obat yang Sering Dikonsumsi <span class="text-slate-400 font-normal">(Opsional)</span>
                </label>
                <input
                  type="text"
                  value="${a.catatan_medis}"
                  placeholder="Contoh: Asma dingin (bawa inhaler salbutamol), alergi seafood, obat rutin maag/darah tinggi, dll."
                  class="input-medis w-full border border-slate-300 rounded-xl px-3.5 py-2.5 text-xs bg-white focus:ring-2 focus:ring-primary-500/20 focus:border-primary-600 outline-none transition text-slate-800"
                />
              </div>

              ${idx > 0 && tipe === 'non_keluarga' ? `
                <!-- Opsi Beda Domisili Khusus Non-Keluarga (Smart Inherit) -->
                <div class="sm:col-span-2 pt-2 border-t border-slate-200/80 space-y-2.5">
                  <label class="flex items-start gap-2.5 cursor-pointer select-none">
                    <input
                      type="checkbox"
                      class="cb-beda-domisili mt-0.5 rounded border-slate-300 text-primary-600 focus:ring-primary-500 cursor-pointer"
                      data-index="${idx}"
                      ${a.beda_domisili ? 'checked' : ''}
                    />
                    <div>
                      <span class="text-xs font-bold text-slate-800 block">Asal kota / domisili berbeda dengan PIC?</span>
                      <span class="text-[10px] text-slate-400 block">Default: mengikuti domisili PIC.</span>
                    </div>
                  </label>

                  <div class="container-domisili-anggota ${a.beda_domisili ? '' : 'hidden'} grid grid-cols-1 sm:grid-cols-2 gap-3 p-3 bg-white rounded-xl border border-slate-200" data-index="${idx}">
                    <div>
                      <label class="block text-[11px] font-bold text-slate-700 mb-1">
                        Provinsi Asal <span class="text-rose-500">*</span>
                      </label>
                      <select class="select-provinsi-anggota w-full border border-slate-300 rounded-xl px-3 py-2 text-xs bg-white focus:ring-2 focus:ring-primary-500/20 focus:border-primary-600 outline-none transition font-medium cursor-pointer" data-index="${idx}">
                        <option value="" disabled ${!a.provinsi ? 'selected' : ''}>Pilih Provinsi...</option>
                        ${LIST_PROVINSI.map((p) => `<option value="${p}" ${a.provinsi === p ? 'selected' : ''}>${p}</option>`).join('')}
                      </select>
                    </div>

                    <div>
                      <label class="block text-[11px] font-bold text-slate-700 mb-1">
                        Kota / Kabupaten <span class="text-rose-500">*</span>
                      </label>
                      <select class="select-kota-anggota w-full border border-slate-300 rounded-xl px-3 py-2 text-xs bg-white focus:ring-2 focus:ring-primary-500/20 focus:border-primary-600 outline-none transition font-medium cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed" data-index="${idx}" ${!a.provinsi ? 'disabled' : ''}>
                        <option value="" disabled ${!a.kota ? 'selected' : ''}>${a.provinsi ? 'Pilih Kota / Kabupaten...' : 'Pilih Provinsi dahulu...'}</option>
                        ${a.provinsi && DATA_WILAYAH[a.provinsi] ? DATA_WILAYAH[a.provinsi].map((k) => `<option value="${k}" ${a.kota === k ? 'selected' : ''}>${k}</option>`).join('') : ''}
                      </select>
                    </div>
                  </div>
                </div>
              ` : ''}
            </div>
          </div>
        `;
      }).join('');

      // Pasang event listener tombol hapus
      container.querySelectorAll('.btn-hapus-anggota').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          syncAnggotaFromDOM();
          const target = e.currentTarget as HTMLElement;
          const idx = parseInt(target.getAttribute('data-index') || '0', 10);
          if (anggotaData.length > 1) {
            anggotaData.splice(idx, 1);
            renderAnggotaForms();
            checkKeluargaConstraint();
          }
        });
      });

      // Event listener ganti peran -> otomatis sesuaikan dan kunci gender
      container.querySelectorAll('.select-peran').forEach((selectEl) => {
        selectEl.addEventListener('change', (e) => {
          syncAnggotaFromDOM();
          const target = e.currentTarget as HTMLSelectElement;
          const card = target.closest('.anggota-card');
          const idx = parseInt(card?.getAttribute('data-index') || '0', 10);
          const chosenPeran = target.value;
          const locked = getLockedGenderForPeran(chosenPeran);
          if (locked) {
            anggotaData[idx].jenis_kelamin = locked;
          }
          renderAnggotaForms();
        });
      });

      // Event listener radio jenis kelamin (untuk peran yang fleksibel)
      container.querySelectorAll('.radio-jk').forEach((radio) => {
        radio.addEventListener('change', (e) => {
          const target = e.currentTarget as HTMLInputElement;
          const idx = parseInt(target.getAttribute('data-index') || '0', 10);
          if (anggotaData[idx]) {
            anggotaData[idx].jenis_kelamin = target.value;
          }
        });
      });

      // Event listener input usia: update preview & badge balita secara realtime
      container.querySelectorAll('.input-usia').forEach((inputEl) => {
        inputEl.addEventListener('input', () => {
          syncAnggotaFromDOM();
          const card = (inputEl as HTMLElement).closest('.anggota-card');
          const idx = parseInt(card?.getAttribute('data-index') || '0', 10);
          const usiaVal = anggotaData[idx]?.usia;
          const badgeEl = card?.querySelector('.badge-balita');
          if (usiaVal !== null && usiaVal < 3) {
            if (!badgeEl) {
              const headerLeft = card?.querySelector('.card-header-left');
              if (headerLeft) {
                const span = document.createElement('span');
                span.className = 'badge-balita px-2 py-0.5 bg-emerald-100 text-emerald-800 rounded text-[10px] font-bold';
                span.textContent = 'Balita (Gratis)';
                headerLeft.appendChild(span);
              }
            }
          } else {
            if (badgeEl) badgeEl.remove();
          }
        });
      });

      // Pasang event listener input agar border merah langsung hilang saat mulai mengetik
      container.querySelectorAll('.input-nama').forEach((inp) => {
        inp.addEventListener('input', (e) => {
          clearInvalid(e.currentTarget as HTMLElement);
        });
      });

      // Event listener checkbox beda domisili (Non-Keluarga)
      container.querySelectorAll('.cb-beda-domisili').forEach((cb) => {
        cb.addEventListener('change', (e) => {
          const target = e.currentTarget as HTMLInputElement;
          const idx = parseInt(target.getAttribute('data-index') || '0', 10);
          if (!anggotaData[idx]) return;

          anggotaData[idx].beda_domisili = target.checked;
          const card = target.closest('.anggota-card');
          const domisiliContainer = card?.querySelector('.container-domisili-anggota');
          if (domisiliContainer) {
            if (target.checked) {
              domisiliContainer.classList.remove('hidden');
            } else {
              domisiliContainer.classList.add('hidden');
              anggotaData[idx].provinsi = '';
              anggotaData[idx].kota = '';
              const provSelect = domisiliContainer.querySelector('.select-provinsi-anggota') as HTMLSelectElement | null;
              const kotaSelect = domisiliContainer.querySelector('.select-kota-anggota') as HTMLSelectElement | null;
              if (provSelect) {
                provSelect.value = '';
                clearInvalid(provSelect);
              }
              if (kotaSelect) {
                kotaSelect.value = '';
                kotaSelect.disabled = true;
                kotaSelect.innerHTML = '<option value="" disabled selected>Pilih Provinsi dahulu...</option>';
                clearInvalid(kotaSelect);
              }
            }
          }
        });
      });

      // Event listener select provinsi anggota
      container.querySelectorAll('.select-provinsi-anggota').forEach((provEl) => {
        provEl.addEventListener('change', (e) => {
          const target = e.currentTarget as HTMLSelectElement;
          const idx = parseInt(target.getAttribute('data-index') || '0', 10);
          if (!anggotaData[idx]) return;

          clearInvalid(target);
          anggotaData[idx].provinsi = target.value;
          anggotaData[idx].kota = '';

          const card = target.closest('.anggota-card');
          const kotaEl = card?.querySelector('.select-kota-anggota') as HTMLSelectElement | null;
          if (kotaEl) {
            clearInvalid(kotaEl);
            const kotaList = DATA_WILAYAH[target.value] || [];
            kotaEl.disabled = false;
            kotaEl.innerHTML = `
              <option value="" disabled selected>Pilih Kota / Kabupaten...</option>
              ${kotaList.map((k) => `<option value="${k}">${k}</option>`).join('')}
            `;
          }
        });
      });

      // Event listener select kota anggota
      container.querySelectorAll('.select-kota-anggota').forEach((kotaEl) => {
        kotaEl.addEventListener('change', (e) => {
          const target = e.currentTarget as HTMLSelectElement;
          const idx = parseInt(target.getAttribute('data-index') || '0', 10);
          if (anggotaData[idx]) {
            anggotaData[idx].kota = target.value;
          }
          clearInvalid(target);
        });
      });

      checkKeluargaConstraint();
    }

    function setupAddonInteractions() {
      const radioSewa = document.querySelectorAll('input[name="opt_sewa"]');
      const containerAddons = document.getElementById('containerAddons');

      radioSewa.forEach((r) => {
        r.addEventListener('change', () => {
          const isYa = (document.querySelector('input[name="opt_sewa"]:checked') as HTMLInputElement)?.value === 'ya';
          if (containerAddons) {
            if (isYa) {
              containerAddons.classList.remove('hidden');
            } else {
              containerAddons.classList.add('hidden');
              selectedAddonQty = {};
              renderAddonsCatalog();
            }
          }
          calcTotalSementara();
        });
      });
    }

    function renderAddonsCatalog() {
      const list = document.getElementById('listAddonsCards');
      if (!list) return;

      if (catalogAddons.length === 0) {
        list.innerHTML = `<div class="p-4 bg-slate-50 text-slate-400 text-xs rounded-xl text-center">Belum ada item sewa tersedia.</div>`;
        return;
      }

      list.innerHTML = catalogAddons.map((item) => {
        const qty = selectedAddonQty[item.id] || 0;
        return `
          <div class="p-3.5 sm:p-4 rounded-2xl border border-slate-200 bg-slate-50/60 flex items-center justify-between gap-3">
            <div class="space-y-0.5">
              <h5 class="text-xs font-extrabold text-slate-900">${item.nama}</h5>
              <p class="text-[11px] text-slate-500">${item.deskripsi || ''}</p>
              <span class="text-xs font-black text-primary-700 font-mono block">Rp ${item.harga.toLocaleString('id-ID')} <span class="text-[10px] font-normal text-slate-400">/ unit</span></span>
            </div>

            <div class="flex items-center gap-2 shrink-0">
              <button
                type="button"
                class="btn-addon-dec w-8 h-8 rounded-lg bg-white border border-slate-300 text-slate-700 font-bold hover:bg-slate-100 flex items-center justify-center transition active:scale-95 cursor-pointer"
                data-id="${item.id}"
              >-</button>
              <span class="w-8 text-center font-bold text-xs font-mono addon-qty-text" data-id="${item.id}">${qty}</span>
              <button
                type="button"
                class="btn-addon-inc w-8 h-8 rounded-lg bg-primary-600 text-white font-bold hover:bg-primary-700 flex items-center justify-center transition active:scale-95 cursor-pointer"
                data-id="${item.id}"
              >+</button>
            </div>
          </div>
        `;
      }).join('');

      // Bind inc / dec buttons
      list.querySelectorAll('.btn-addon-dec').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
          if (!id) return;
          const current = selectedAddonQty[id] || 0;
          if (current > 0) {
            selectedAddonQty[id] = current - 1;
            updateAddonQtyDisplay(id);
            calcTotalSementara();
          }
        });
      });

      list.querySelectorAll('.btn-addon-inc').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          const id = (e.currentTarget as HTMLElement).getAttribute('data-id');
          if (!id) return;
          const current = selectedAddonQty[id] || 0;
          selectedAddonQty[id] = current + 1;
          updateAddonQtyDisplay(id);
          calcTotalSementara();
        });
      });
    }

    function updateAddonQtyDisplay(id: string) {
      const el = document.querySelector(`.addon-qty-text[data-id="${id}"]`);
      if (el) el.textContent = String(selectedAddonQty[id] || 0);
    }

    function getAnggotaBerbayarCount(): number {
      return anggotaData.filter((a) => a.usia === null || a.usia >= 3).length;
    }

    function updateStep3Summary() {
      const berbayar = getAnggotaBerbayarCount();
      const subtotalWajib = berbayar * 200000;

      const txtBadge = document.getElementById('txtTotalBerbayarBadge');
      if (txtBadge) txtBadge.textContent = `${berbayar} Orang`;

      const txtSubtotalWajib = document.getElementById('txtSubtotalWajibStep3');
      if (txtSubtotalWajib) txtSubtotalWajib.textContent = `Rp ${subtotalWajib.toLocaleString('id-ID')}`;

      calcTotalSementara();
    }

    function calcTotalSementara(): number {
      const berbayar = getAnggotaBerbayarCount();
      const subtotalWajib = berbayar * 200000;

      let subtotalAddon = 0;
      for (const item of catalogAddons) {
        const qty = selectedAddonQty[item.id] || 0;
        subtotalAddon += item.harga * qty;
      }

      const total = subtotalWajib + subtotalAddon;
      const el = document.getElementById('txtTotalSementara');
      if (el) el.textContent = `Rp ${total.toLocaleString('id-ID')}`;

      return total;
    }

    function updateStep4Review() {
      const tipe = getSelectedTipe();
      const picNama = (document.getElementById('pic_nama') as HTMLInputElement).value.trim();
      const picWa = (document.getElementById('pic_whatsapp') as HTMLInputElement).value.trim();
      const picProvinsi = (document.getElementById('pic_provinsi') as HTMLSelectElement)?.value || '';
      const picKota = (document.getElementById('pic_kota') as HTMLSelectElement)?.value || '';

      const rekapTipe = document.getElementById('rekapTipe');
      if (rekapTipe) rekapTipe.textContent = tipe === 'keluarga' ? 'Pendaftaran Keluarga' : 'Pendaftaran Rombongan / Non-Keluarga';

      const rekapPicNama = document.getElementById('rekapPicNama');
      if (rekapPicNama) rekapPicNama.textContent = picNama;

      const rekapPicWa = document.getElementById('rekapPicWa');
      if (rekapPicWa) rekapPicWa.textContent = `WA: ${picWa}`;

      const rekapPicDomisili = document.getElementById('rekapPicDomisili');
      if (rekapPicDomisili) {
        rekapPicDomisili.textContent = picKota && picProvinsi ? `${picKota}, ${picProvinsi}` : (picKota || picProvinsi || '-');
      }

      const rekapJmlAnggota = document.getElementById('rekapJmlAnggota');
      if (rekapJmlAnggota) rekapJmlAnggota.textContent = String(anggotaData.length);

      const rekapAnggotaList = document.getElementById('rekapAnggotaList');
      if (rekapAnggotaList) {
        rekapAnggotaList.innerHTML = anggotaData.map((a, idx) => {
          const isBalita = a.usia !== null && a.usia < 3;
          const customDomisili = a.beda_domisili && a.kota && a.provinsi ? `📍 Asal: ${a.kota}, ${a.provinsi}` : '';
          return `
            <li class="pt-1.5 flex justify-between items-center text-xs">
              <div>
                <span class="font-bold text-slate-800">${idx + 1}. ${a.nama}</span>
                <span class="text-[10px] text-slate-500">(${a.peran} • ${a.jenis_kelamin}${a.usia ? ' • ' + a.usia + ' th' : ''})</span>
                ${customDomisili ? `<span class="block text-[10px] text-primary-700 font-semibold mt-0.5">${customDomisili}</span>` : ''}
              </div>
              <span class="font-bold font-mono ${isBalita ? 'text-emerald-600' : 'text-slate-700'}">
                ${isBalita ? 'GRATIS (Balita)' : 'Rp 200.000'}
              </span>
            </li>
          `;
        }).join('');
      }

      const berbayar = getAnggotaBerbayarCount();
      const biayaWajib = berbayar * 200000;

      const rekapHitungWajib = document.getElementById('rekapHitungWajib');
      if (rekapHitungWajib) rekapHitungWajib.textContent = String(berbayar);

      const rekapBiayaWajib = document.getElementById('rekapBiayaWajib');
      if (rekapBiayaWajib) rekapBiayaWajib.textContent = `Rp ${biayaWajib.toLocaleString('id-ID')}`;

      const rekapAddonsList = document.getElementById('rekapAddonsList');
      if (rekapAddonsList) {
        const chosen = catalogAddons.filter((it) => (selectedAddonQty[it.id] || 0) > 0);
        if (chosen.length === 0) {
          rekapAddonsList.innerHTML = `<span class="text-slate-400 text-[11px] italic">Tidak ada sewa perlengkapan tambahan.</span>`;
        } else {
          rekapAddonsList.innerHTML = chosen.map((it) => {
            const qty = selectedAddonQty[it.id] || 0;
            const sub = it.harga * qty;
            return `
              <div class="flex justify-between text-slate-600 text-xs">
                <span>${it.nama} (x${qty}):</span>
                <span class="font-bold text-slate-800 font-mono">Rp ${sub.toLocaleString('id-ID')}</span>
              </div>
            `;
          }).join('');
        }
      }
    }

    function setupFinalSubmit() {
      const form = document.getElementById('formFamilyCamp') as HTMLFormElement | null;
      const btnFinalSubmit = document.getElementById('btnFinalSubmit') as HTMLButtonElement | null;
      const submitError = document.getElementById('submitError');

      if (!form) return;

      form.onsubmit = async (e) => {
        e.preventDefault();
        syncAnggotaFromDOM();

        if (submitError) submitError.classList.add('hidden');

        const picNamaInput = document.getElementById('pic_nama') as HTMLInputElement | null;
        const picWaInput = document.getElementById('pic_whatsapp') as HTMLInputElement | null;
        const picProvinsiSelect = document.getElementById('pic_provinsi') as HTMLSelectElement | null;
        const picKotaSelect = document.getElementById('pic_kota') as HTMLSelectElement | null;

        const picNama = (picNamaInput?.value || '').trim();
        const picWa = (picWaInput?.value || '').replace(/\D/g, '');
        const picEmail = (document.getElementById('pic_email') as HTMLInputElement).value.trim();
        const picProvinsi = (picProvinsiSelect?.value || '').trim();
        const picKota = (picKotaSelect?.value || '').trim();

        // Validasi Step 1
        if (!picNama || picNama.length < 2 || picWa.length < 10 || picWa.length > 15 || !picProvinsi || !picKota) {
          goToStep(1);
          const btnNextStep1 = document.getElementById('btnNextStep1');
          btnNextStep1?.click();
          return;
        }

        const tipe = getSelectedTipe();

        // Validasi constraint keluarga: minimal 2 peserta
        if (tipe === 'keluarga' && anggotaData.length < 2) {
          goToStep(2);
          checkKeluargaConstraint();
          showFloatingToast('Kategori Keluarga minimal 2 orang peserta.');
          return;
        }

        // Validasi Step 2
        let hasInvalidAnggota = false;
        for (let i = 0; i < anggotaData.length; i++) {
          if (!anggotaData[i].nama || anggotaData[i].nama.trim().length < 2) {
            hasInvalidAnggota = true;
            break;
          }
          if (anggotaData[i].beda_domisili && (!anggotaData[i].provinsi || !anggotaData[i].kota)) {
            hasInvalidAnggota = true;
            break;
          }
        }
        if (hasInvalidAnggota) {
          goToStep(2);
          const btnNextStep2 = document.getElementById('btnNextStep2');
          btnNextStep2?.click();
          return;
        }

        if (btnFinalSubmit) {
          btnFinalSubmit.disabled = true;
          btnFinalSubmit.textContent = 'Memproses Pendaftaran...';
          btnFinalSubmit.className = 'px-7 py-3.5 bg-slate-400 text-white font-extrabold text-sm rounded-xl transition cursor-wait';
        }

        // Siapkan array addon
        const addonsPayload: { addon_id: string; qty: number }[] = [];
        for (const item of catalogAddons) {
          const qty = selectedAddonQty[item.id] || 0;
          if (qty > 0) {
            addonsPayload.push({ addon_id: item.id, qty });
          }
        }

        const payload = {
          tipe,
          pic_nama: picNama,
          pic_whatsapp: picWa,
          pic_email: picEmail,
          pic_provinsi: picProvinsi,
          pic_kota: picKota,
          anggota: anggotaData,
          addons: addonsPayload,
        };

        try {
          const res = await fetch(`${API_URL}/api/peserta/daftar-grup`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });

          const json = await res.json();
          if (!res.ok) {
            throw new Error(json.error || 'Gagal menyimpan data pendaftaran');
          }

          // Sukses! Redirect langsung ke halaman konfirmasi pembayaran
          if (json.payment_url) {
            window.location.href = json.payment_url;
          } else if (json.payment_token) {
            window.location.href = `/pembayaran?token=${encodeURIComponent(json.payment_token)}`;
          } else {
            showFloatingToast('Pendaftaran berhasil disimpan!', false);
            setTimeout(() => {
              window.location.href = '/status';
            }, 1000);
          }
        } catch (err: any) {
          const errMsg = err.message || 'Terjadi kesalahan sistem saat mengirim data.';
          showFloatingToast(errMsg, true);
          if (submitError) {
            submitError.textContent = errMsg;
            submitError.classList.remove('hidden');
          }
          if (btnFinalSubmit) {
            btnFinalSubmit.disabled = false;
            btnFinalSubmit.textContent = 'Daftar & Lanjut ke Pembayaran →';
            btnFinalSubmit.className = 'px-7 py-3.5 bg-primary-600 hover:bg-primary-700 text-white font-extrabold text-sm rounded-xl transition shadow-md active:scale-95 cursor-pointer';
          }
        }
      };
    }

    document.addEventListener('astro:page-load', initFamilyCampForm);
  </script>
</Layout>
