---
import Layout from "../layouts/Layout.astro";
import { LIST_PROVINSI } from "../data/wilayah";
---

<Layout title="Formulir Pendaftaran Family Camp">
  <!-- Floating Toast Alert (Pop-up melayang, otomatis hilang, tanpa tombol close) -->
  <div
    id="floatingToast"
    class="fixed top-5 left-1/2 -translate-x-1/2 z-[9999] pointer-events-none transition-all duration-300 opacity-0 -translate-y-4 scale-95 flex items-center gap-3 px-4 py-3 bg-slate-900/95 text-white text-xs sm:text-sm font-medium rounded-2xl shadow-2xl border border-slate-700/60 backdrop-blur-md max-w-[92vw] sm:max-w-md w-max"
    role="alert"
    aria-live="polite"
  >
    <div
      id="floatingToastIcon"
      class="w-5 h-5 shrink-0 text-rose-400 flex items-center justify-center"
    >
      <svg
        class="w-5 h-5"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
        />
      </svg>
    </div>
    <span
      id="floatingToastMsg"
      class="leading-snug text-slate-100 font-semibold"
    ></span>
  </div>

  <section class="py-10 px-4">
    <div class="max-w-2xl mx-auto space-y-6">
      <!-- Header Acara -->
      <div class="text-center space-y-2">
        <span class="inline-flex items-center gap-1.5 px-3.5 py-1 bg-emerald-100 text-emerald-800 rounded-full text-xs font-bold uppercase tracking-wider">
          <svg
            class="w-3.5 h-3.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
            />
          </svg>
          <span>Pendaftaran Resmi Family Camp</span>
        </span>
        <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
          Formulir Peserta Family Camp
        </h1>
        <p class="text-slate-500 text-xs sm:text-sm max-w-lg mx-auto leading-relaxed">
          Pendaftaran keluarga maupun kelompok/perorangan dengan paket wajib dan
          opsi perlengkapan tambahan.
        </p>
      </div>

      <!-- Closed Banner (jika pendaftaran ditutup admin) -->
      <div
        id="closedBanner"
        class="hidden p-4 rounded-2xl bg-amber-50 border border-amber-200 text-amber-900 flex items-start gap-3"
      >
        <svg
          class="w-5 h-5 shrink-0 text-amber-600 mt-0.5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
          />
        </svg>
        <div>
          <h3 class="font-bold text-sm">Pendaftaran Sedang Ditutup</h3>
          <p class="text-xs text-amber-800 mt-0.5">
            Mohon maaf, kuota pendaftaran Family Camp saat ini sedang ditutup
            oleh panitia.
          </p>
          <a
            href="/"
            class="inline-block mt-2 text-xs font-bold text-primary-700 hover:underline"
          >
            ← Kembali ke Beranda
          </a>
        </div>
      </div>

      <!-- Wizard Step Indicator -->
      <div
        id="wizardHeader"
        class="bg-white rounded-2xl p-3 sm:p-4 border border-slate-200/90 shadow-xs"
      >
        <div class="grid grid-cols-4 gap-1.5 sm:gap-2 text-center">
          <div
            id="stepTab1"
            class="step-tab active py-2 px-1 rounded-xl transition font-bold text-[11px] sm:text-xs"
          >
            <span class="block text-[10px] sm:text-[11px] text-primary-600 font-mono">
              1
            </span>
            <span>Tipe & Kontak</span>
          </div>
          <div
            id="stepTab2"
            class="step-tab py-2 px-1 rounded-xl transition font-semibold text-[11px] sm:text-xs text-slate-400"
          >
            <span class="block text-[10px] sm:text-[11px] font-mono">2</span>
            <span>Biodata</span>
          </div>
          <div
            id="stepTab3"
            class="step-tab py-2 px-1 rounded-xl transition font-semibold text-[11px] sm:text-xs text-slate-400"
          >
            <span class="block text-[10px] sm:text-[11px] font-mono">3</span>
            <span>Paket &amp; Sewa</span>
          </div>
          <div
            id="stepTab4"
            class="step-tab py-2 px-1 rounded-xl transition font-semibold text-[11px] sm:text-xs text-slate-400"
          >
            <span class="block text-[10px] sm:text-[11px] font-mono">4</span>
            <span>Pembayaran</span>
          </div>
        </div>
      </div>

      <!-- Form Card Multi-Step -->
      <form
        id="formFamilyCamp"
        novalidate
        class="bg-white rounded-3xl p-5 sm:p-8 border border-slate-200/90 shadow-sm space-y-6"
      >
        <!-- ======================================================== -->
        <!-- STEP 1: PILIH TIPE PENDAFTARAN & KONTAK PIC               -->
        <!-- ======================================================== -->
        <div id="stepContent1" class="step-content space-y-5">
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1.5">
              Pilih Kategori Pendaftaran <span class="text-rose-500">*</span>
            </label>
            <!-- Kontrol Segmented Ringkas, Clean & Hemat Ruang di Mobile -->
            <div class="grid grid-cols-2 gap-1.5 p-1 bg-slate-100 rounded-xl border border-slate-200/80">
              <!-- Pilihan Keluarga -->
              <label class="cursor-pointer">
                <input
                  type="radio"
                  name="tipe_pendaftaran"
                  value="keluarga"
                  checked
                  class="peer sr-only"
                />
                <div class="py-2.5 px-3 rounded-lg flex items-center justify-center gap-2 font-bold text-xs sm:text-sm text-slate-600 transition border border-transparent hover:bg-slate-50 hover:border-slate-200 peer-checked:bg-primary-600 peer-checked:text-white peer-checked:border-primary-700 peer-checked:shadow-md peer-checked:svg:text-white">
                  <svg
                    class="w-4 h-4 shrink-0 text-slate-400 peer-checked:text-white"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
                    />
                  </svg>
                  <span>Keluarga</span>
                </div>
              </label>

              <!-- Pilihan Non-Keluarga -->
              <label class="cursor-pointer">
                <input
                  type="radio"
                  name="tipe_pendaftaran"
                  value="non_keluarga"
                  class="peer sr-only"
                />
                <div class="py-2.5 px-3 rounded-lg flex items-center justify-center gap-2 font-bold text-xs sm:text-sm text-slate-600 transition border border-transparent hover:bg-slate-50 hover:border-slate-200 peer-checked:bg-primary-600 peer-checked:text-white peer-checked:border-primary-700 peer-checked:shadow-md peer-checked:svg:text-white">
                  <svg
                    class="w-4 h-4 shrink-0 text-slate-400 peer-checked:text-white"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                    />
                  </svg>
                  <span class="truncate">Non-Keluarga</span>
                </div>
              </label>
            </div>
            <p class="text-[11px] text-slate-400 mt-1.5">
              Pilih <span class="font-medium text-slate-600">Keluarga</span>{" "}
              untuk ayah, ibu & anak, atau{" "}
              <span class="font-medium text-slate-600">Non-Keluarga</span> untuk
              perorangan/rombongan.
            </p>
          </div>

          <!-- Data Kontak Penanggung Jawab -->
          <div class="pt-4 border-t border-slate-100 space-y-4">
            <div>
              <h3 class="text-sm font-extrabold text-slate-900">
                Kontak Penanggung Jawab
              </h3>
              <p class="text-xs text-slate-500">
                Nomor ini akan menerima invoice pembayaran & link tiket QR
                resmi.
              </p>
            </div>

            <div>
              <label
                for="pic_nama"
                class="block text-xs font-bold text-slate-700 mb-1"
              >
                Nama Lengkap <span class="text-rose-500">*</span>
              </label>
              <input
                type="text"
                id="pic_nama"
                name="pic_nama"
                required
                placeholder="Contoh: Budi Santoso"
                class="w-full border border-slate-300 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-primary-500/20 focus:border-primary-600 outline-none transition"
              />
            </div>

            <div>
              <label
                for="pic_whatsapp"
                class="block text-xs font-bold text-slate-700 mb-1"
              >
                Nomor WhatsApp Aktif <span class="text-rose-500">*</span>
              </label>
              <input
                type="tel"
                id="pic_whatsapp"
                name="pic_whatsapp"
                required
                inputmode="numeric"
                maxlength="15"
                placeholder="Contoh: 081234567890"
                class="w-full border border-slate-300 rounded-xl px-4 py-3 text-sm font-mono focus:ring-2 focus:ring-primary-500/20 focus:border-primary-600 outline-none transition"
              />
              <p class="text-[11px] text-slate-400 mt-1">
                Hanya angka, 10 - 15 digit (untuk invoice & link tiket QR).
              </p>
            </div>

            <div>
              <label
                for="pic_email"
                class="block text-xs font-bold text-slate-700 mb-1"
              >
                Alamat Email{" "}
                <span class="text-slate-400 font-normal">(Opsional)</span>
              </label>
              <input
                type="email"
                id="pic_email"
                name="pic_email"
                placeholder="nama@email.com"
                class="w-full border border-slate-300 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-primary-500/20 focus:border-primary-600 outline-none transition"
              />
            </div>

            <!-- Domisili Asal (Provinsi & Kota/Kabupaten) — bisa diketik bebas -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
              <div>
                <label
                  for="pic_provinsi"
                  class="block text-xs font-bold text-slate-700 mb-1"
                >
                  Provinsi Asal <span class="text-rose-500">*</span>
                </label>
                <input
                  id="pic_provinsi"
                  name="pic_provinsi"
                  required
                  list="listProvinsi"
                  autocomplete="off"
                  placeholder="Ketik atau pilih provinsi..."
                  class="w-full border border-slate-300 rounded-xl px-3.5 py-3 text-xs sm:text-sm bg-white focus:ring-2 focus:ring-primary-500/20 focus:border-primary-600 outline-none transition text-slate-800 font-medium"
                />
                <datalist id="listProvinsi">
                  {LIST_PROVINSI.map((prov) => (
                    <option value={prov} />
                  ))}
                </datalist>
              </div>

              <div>
                <label
                  for="pic_kota"
                  class="block text-xs font-bold text-slate-700 mb-1"
                >
                  Kota / Kabupaten <span class="text-rose-500">*</span>
                </label>
                <input
                  id="pic_kota"
                  name="pic_kota"
                  required
                  list="listKota"
                  autocomplete="off"
                  placeholder="Ketik atau pilih kota/kabupaten..."
                  class="w-full border border-slate-300 rounded-xl px-3.5 py-3 text-xs sm:text-sm bg-white focus:ring-2 focus:ring-primary-500/20 focus:border-primary-600 outline-none transition text-slate-800 font-medium"
                />
                <datalist id="listKota"></datalist>
              </div>
            </div>
          </div>

          <div class="pt-2 flex justify-end">
            <button
              type="button"
              id="btnNextStep1"
              class="px-6 py-3 bg-primary-600 hover:bg-primary-700 text-white font-bold text-xs sm:text-sm rounded-xl transition shadow-xs active:scale-95 cursor-pointer"
            >
              Lanjut ke Biodata Anggota →
            </button>
          </div>
        </div>

        <!-- ======================================================== -->
        <!-- STEP 2: BIODATA DINAMIS SETIAP ANGGOTA                    -->
        <!-- ======================================================== -->
        <div id="stepContent2" class="step-content hidden space-y-6">
          <div>
            <h2 class="text-base font-extrabold text-slate-900 mb-0.5">
              2. Biodata Seluruh Peserta
            </h2>
            <p class="text-xs text-slate-500">
              Lengkapi data diri setiap anggota yang ikut dalam acara.
            </p>
          </div>

          <!-- Container Kartu-kartu Anggota Dinamis -->
          <div id="anggotaContainer" class="space-y-4">
            <!-- Rendered via JS -->
          </div>

          <!-- Tombol Tambah Anggota (Selalu Berada di Bawah Peserta Terakhir) -->
          <div class="pt-1">
            <button
              type="button"
              id="btnAddAnggota"
              class="w-full py-3.5 px-4 bg-primary-50 hover:bg-primary-100 text-primary-700 border-2 border-dashed border-primary-300 hover:border-primary-400 rounded-2xl text-xs sm:text-sm font-bold flex items-center justify-center gap-2 transition active:scale-[0.99] cursor-pointer shadow-xs"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
              </svg>
              <span>+ Tambah Anggota / Peserta Baru</span>
            </button>
          </div>

          <!-- Alert Ketentuan Kategori Usia & Biaya -->
          <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-950 text-xs flex items-start gap-3">
            <svg
              class="w-5 h-5 shrink-0 text-emerald-600 mt-0.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              />
            </svg>
            <div class="space-y-1">
              <span class="font-bold block">Ketentuan Kategori Usia &amp; Biaya:</span>
              <ul class="text-[11px] text-emerald-900 space-y-1 leading-relaxed">
                <li>• <b>Anak Usia 1 - 5 Tahun:</b> <span class="font-bold text-emerald-700">GRATIS</span> (tidak dikenakan biaya &amp; tidak mendapatkan fasilitas).</li>
                <li>• <b>Anak Usia 6 - 10 Tahun:</b> <span class="font-bold text-slate-900">Rp 100.000 / anak</span> (tetap mendapatkan fasilitas sebagaimana peserta pada umumnya).</li>
                <li>• <b>Usia 11 Tahun ke Atas / Dewasa:</b> <span class="font-bold text-slate-900">Rp 200.000 / orang</span> (fasilitas paket lengkap).</li>
              </ul>
            </div>
          </div>

          <!-- Notice Khusus Kategori Keluarga Minimal 2 Orang -->
          <div
            id="noticeMinKeluarga"
            class="hidden p-4 rounded-2xl bg-amber-50 border border-amber-200 text-amber-950 text-xs flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-xs"
          >
            <div class="flex items-start sm:items-center gap-2.5">
              <svg
                class="w-5 h-5 shrink-0 text-amber-600 mt-0.5 sm:mt-0"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                />
              </svg>
              <div>
                <span class="font-extrabold block text-amber-900">
                  Kategori Keluarga Minimal 2 Peserta
                </span>
                <p class="text-[11px] text-amber-800 mt-0.5 leading-relaxed">
                  Pendaftaran <b>Keluarga</b> minimal terdiri dari 2 orang
                  (misal: Ayah &amp; Ibu, atau Orang Tua &amp; Anak). Silakan
                  tambah anggota, atau beralih ke kategori Non-Keluarga jika
                  mendaftar perorangan/sendiri.
                </p>
              </div>
            </div>
            <button
              type="button"
              id="btnSwitchNonKeluarga"
              class="self-start sm:self-center px-3.5 py-2 bg-amber-200 hover:bg-amber-300 text-amber-950 font-bold rounded-xl text-xs transition cursor-pointer shrink-0 active:scale-95 whitespace-nowrap"
            >
              Pindah ke Non-Keluarga →
            </button>
          </div>

          <div class="pt-2 flex items-center justify-between">
            <button
              type="button"
              id="btnPrevStep2"
              class="px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-xl transition"
            >
              ← Kembali
            </button>
            <button
              type="button"
              id="btnNextStep2"
              class="px-6 py-3 bg-primary-600 hover:bg-primary-700 text-white font-bold text-xs sm:text-sm rounded-xl transition shadow-xs active:scale-95 cursor-pointer"
            >
              Lanjut ke Pilihan Paket →
            </button>
          </div>
        </div>

        <!-- ======================================================== -->
        <!-- STEP 3: PAKET WAJIB & SEWA ADD-ON                         -->
        <!-- ======================================================== -->
        <div id="stepContent3" class="step-content hidden space-y-6">
          <div>
            <h2 class="text-base font-extrabold text-slate-900 mb-1">
              3. Paket & Perlengkapan Acara
            </h2>
            <p class="text-xs text-slate-500">
              Pilih fasilitas wajib dan perlengkapan sewa tambahan jika
              diperlukan.
            </p>
          </div>

          <!-- Card Paket Wajib -->
          <div class="p-5 sm:p-6 rounded-2xl bg-gradient-to-br from-primary-900 to-slate-900 text-white space-y-4 shadow-sm">
            <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3">
              <div>
                <span class="inline-block px-2.5 py-0.5 bg-white/20 text-white rounded text-[10px] font-black uppercase tracking-wider mb-1">
                  Paket Pendaftaran Wajib
                </span>
              </div>
              <div class="text-left sm:text-right pt-2 sm:pt-0 border-t sm:border-t-0 border-white/10">
                <span class="text-[10px] text-slate-300 uppercase tracking-wider block">
                  Peserta Terdaftar
                </span>
                <span
                  class="text-sm font-black text-white font-mono"
                  id="txtTotalBerbayarBadge"
                >
                  0 Orang
                </span>
              </div>
            </div>

            <!-- Fasilitas yang Didapat -->
            <div class="pt-3 border-t border-white/10 space-y-2 text-xs">
              <span class="font-bold text-slate-200 block text-[11px] uppercase tracking-wider">
                Fasilitas yang Didapatkan:
              </span>
              <ul class="grid grid-cols-2 gap-2 text-[11px] text-slate-300">
                <li class="flex items-center gap-1.5">
                  <span class="text-emerald-400 font-bold">✓</span>
                  <span>Majelis Ilmu</span>
                </li>
                <li class="flex items-center gap-1.5">
                  <span class="text-emerald-400 font-bold">✓</span>
                  <span>Makan 3x + Air Mineral</span>
                </li>
                <li class="flex items-center gap-1.5">
                  <span class="text-emerald-400 font-bold">✓</span>
                  <span>Berkumpul Bersama</span>
                </li>
                <li class="flex items-center gap-1.5">
                  <span class="text-emerald-400 font-bold">✓</span>
                  <span>BBQ & Sosis Bakar</span>
                </li>
                <li class="flex items-center gap-1.5">
                  <span class="text-emerald-400 font-bold">✓</span>
                  <span>Teman-Teman Shalih</span>
                </li>
                <li class="flex items-center gap-1.5">
                  <span class="text-emerald-400 font-bold">✓</span>
                  <span>Snack</span>
                </li>
                <li class="flex items-center gap-1.5">
                  <span class="text-emerald-400 font-bold">✓</span>
                  <span>Games Edukatif & Seru</span>
                </li>
                <li class="flex items-center gap-1.5">
                  <span class="text-emerald-400 font-bold">✓</span>
                  <span>Kopi & Teh</span>
                </li>
                <li class="flex items-center gap-1.5">
                  <span class="text-emerald-400 font-bold">✓</span>
                  <span>Doorprize Menarik</span>
                </li>
                <li class="flex items-center gap-1.5">
                  <span class="text-emerald-400 font-bold">✓</span>
                  <span>Kamar Mandi</span>
                </li>
                <li class="flex items-center gap-1.5 col-span-2">
                  <span class="text-emerald-400 font-bold">✓</span>
                  <span>Area Parkir</span>
                </li>
              </ul>
            </div>

            <!-- Kalkulasi Subtotal Wajib -->
            <div class="pt-3 border-t border-white/10 flex justify-between items-center text-xs">
              <span class="text-slate-300">Subtotal Biaya Wajib:</span>
              <span
                class="text-base font-black text-amber-300 font-mono"
                id="txtSubtotalWajibStep3"
              >
                Rp 0
              </span>
            </div>
          </div>

          <!-- Pertanyaan Opsi Sewa Add-on -->
          <div class="space-y-3 pt-2">
            <div>
              <h3 class="text-sm font-extrabold text-slate-900">
                Beri tanda pada pilihan Anda
              </h3>
            </div>

            <!-- Info tersorot: bawa tenda sendiri -->
            <div class="flex items-start gap-2.5 p-3 rounded-xl bg-amber-50 border-l-4 border-amber-500 text-amber-900">
              <svg
                class="w-4 h-4 shrink-0 text-amber-600 mt-0.5"
                fill="none"
                viewBox="0 0 24 24"
