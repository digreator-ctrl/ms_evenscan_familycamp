---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Konfirmasi Pembayaran & Tiket Family Camp">
  <section class="py-10 px-4">
    <div class="max-w-2xl mx-auto space-y-6">

      <!-- Loading State -->
      <div id="loadingBox" class="bg-white rounded-3xl p-10 border border-slate-200/80 shadow-xs text-center space-y-4">
        <div class="w-12 h-12 border-4 border-primary-600 border-t-transparent rounded-full animate-spin mx-auto"></div>
        <p class="text-sm font-semibold text-slate-600">Memuat rincian pendaftaran dan pembayaran Anda...</p>
      </div>

      <!-- Error State -->
      <div id="errorBox" class="hidden bg-white rounded-3xl p-8 border border-rose-200 shadow-xs text-center space-y-4">
        <div class="w-16 h-16 bg-rose-50 text-rose-500 rounded-2xl flex items-center justify-center mx-auto text-2xl font-bold">⚠️</div>
        <h2 class="text-lg font-extrabold text-slate-900">Data Tidak Ditemukan</h2>
        <p id="errorMsg" class="text-xs text-slate-500 max-w-md mx-auto">Link pembayaran tidak valid atau telah kedaluwarsa. Silakan periksa kembali tautan yang Anda terima.</p>
        <div class="pt-2">
          <a href="/daftar" class="inline-block px-5 py-2.5 bg-primary-600 hover:bg-primary-700 text-white text-xs font-bold rounded-xl transition">
            Ke Formulir Pendaftaran
          </a>
        </div>
      </div>

      <!-- Content State -->
      <div id="contentBox" class="hidden space-y-6">

        <!-- Status Header Banner -->
        <div id="statusBanner" class="rounded-3xl p-6 sm:p-7 border shadow-xs transition-all">
          <!-- Dinamis via JS -->
        </div>

        <!-- Tombol Simpan Link ke WhatsApp Pribadi -->
        <div class="bg-emerald-50 border border-emerald-200 rounded-2xl p-4 sm:p-5 flex flex-col sm:flex-row items-center justify-between gap-3 text-center sm:text-left">
          <div class="flex items-center gap-3">
            <span class="text-2xl">📱</span>
            <div>
              <h4 class="text-xs font-bold text-emerald-950 uppercase tracking-wider">Simpan Tautan di WhatsApp</h4>
              <p class="text-[11px] text-emerald-700 mt-0.5">Agar tidak hilang jika browser ditutup, simpan tautan pembayaran unik ini ke WhatsApp Anda.</p>
            </div>
          </div>
          <a
            id="btnShareWA"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto shrink-0 px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-extrabold rounded-xl transition shadow-xs flex items-center justify-center gap-2"
          >
            <span>Kirim ke WA Saya</span>
            <span>↗</span>
          </a>
        </div>

        <!-- Rincian Pendaftaran & Anggota -->
        <div class="bg-white rounded-3xl p-6 sm:p-7 border border-slate-200/90 shadow-xs space-y-5">
          <div class="flex items-center justify-between pb-4 border-b border-slate-100">
            <div>
              <span id="badgeTipe" class="inline-block px-2.5 py-1 bg-primary-50 text-primary-700 border border-primary-200 rounded-lg text-[10px] font-black uppercase tracking-wider mb-1">
                Pendaftaran Keluarga
              </span>
              <h3 class="text-base font-extrabold text-slate-900" id="txtPicNama">-</h3>
              <p class="text-xs text-slate-500 font-mono" id="txtPicWa">-</p>
            </div>
            <div class="text-right">
              <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">ID Registrasi</span>
              <span class="text-xs font-bold text-slate-700 font-mono" id="txtGrupId">-</span>
            </div>
          </div>

          <!-- Tabel Anggota -->
          <div>
            <h4 class="text-xs font-bold text-slate-700 uppercase tracking-wider mb-2.5 flex items-center gap-1.5">
              <span>👥</span>
              <span>Daftar Anggota (<span id="txtJmlAnggota">0</span> Peserta)</span>
            </h4>
            <div class="overflow-x-auto rounded-2xl border border-slate-200">
              <table class="w-full text-left text-xs">
                <thead class="bg-slate-50/80 text-slate-500 font-bold border-b border-slate-200 text-[11px] uppercase tracking-wider">
                  <tr>
                    <th class="py-2.5 px-3">No</th>
                    <th class="py-2.5 px-3">Nama</th>
                    <th class="py-2.5 px-3 hidden sm:table-cell">Peran</th>
                    <th class="py-2.5 px-3">Jenis Kelamin</th>
                    <th class="py-2.5 px-3">Usia</th>
                    <th class="py-2.5 px-3 text-right">Tarif</th>
                  </tr>
                </thead>
                <tbody id="tblAnggotaBody" class="divide-y divide-slate-100">
                  <!-- Generated via JS -->
                </tbody>
              </table>
            </div>
          </div>

          <!-- Info Pengenaan Biaya Berdasarkan Usia -->
          <div class="p-4 rounded-2xl bg-amber-50 border border-amber-200 space-y-2">
            <h4 class="text-xs font-bold text-amber-900 uppercase tracking-wider flex items-center gap-1.5">
              <span>ℹ️</span>
              <span>Ketentuan Biaya Berdasarkan Usia</span>
            </h4>
            <ul class="text-[11px] text-amber-900 space-y-1.5 leading-relaxed">
              <li class="flex items-start justify-between gap-2">
                <span>• Anak usia <b>1 - 5 tahun</b></span>
                <span class="font-black text-emerald-700 whitespace-nowrap">GRATIS</span>
              </li>
              <li class="flex items-start justify-between gap-2">
                <span>• Anak usia <b>6 - 10 tahun</b></span>
                <span class="font-black text-amber-800 whitespace-nowrap">Rp 100.000</span>
              </li>
              <li class="flex items-start justify-between gap-2">
                <span>• Usia <b>11 tahun ke atas / Dewasa</b></span>
                <span class="font-black text-slate-900 whitespace-nowrap">Rp 200.000</span>
              </li>
            </ul>
          </div>

          <!-- Rincian Biaya Wajib & Add-on -->
          <div class="pt-4 border-t border-slate-100 space-y-2.5 text-xs">
            <h4 class="text-xs font-bold text-slate-700 uppercase tracking-wider mb-2 flex items-center gap-1.5">
              <span>🧾</span>
              <span>Rincian Paket & Add-on</span>
            </h4>

            <div class="flex justify-between text-slate-600">
              <span>Paket Wajib Family Camp (<span id="txtHitungWajib">0</span> peserta berbayar)</span>
              <span class="font-bold text-slate-800" id="txtSubtotalWajib">Rp 0</span>
            </div>

            <!-- List Add-ons -->
            <div id="listAddons" class="space-y-1.5 pl-3 border-l-2 border-slate-200 my-2">
              <!-- Generated via JS -->
            </div>

            <div class="hidden justify-between text-slate-600" id="rowKodeUnik">
              <span class="flex items-center gap-1">
                <span>Kode Unik Transfer</span>
                <span class="text-[10px] text-amber-600 font-semibold">(Untuk verifikasi otomatis)</span>
              </span>
              <span class="font-bold text-amber-600 font-mono" id="txtKodeUnik">+Rp 0</span>
            </div>

            <!-- Grand Total Highlight Box -->
            <div class="mt-4 p-4 rounded-2xl bg-slate-900 text-white flex flex-col sm:flex-row items-center justify-between gap-3">
              <div>
                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Total Transfer Wajib</span>
                <span class="text-2xl font-black text-amber-400 font-mono tracking-tight" id="txtGrandTotal">Rp 0</span>
                <span class="text-[10px] text-slate-400 block mt-0.5">*Harap transfer sesuai nominal tepat di atas</span>
              </div>
              <button
                type="button"
                id="btnCopyTotal"
                class="w-full sm:w-auto px-4 py-2 bg-white/10 hover:bg-white/20 text-white text-xs font-bold rounded-xl transition border border-white/20 active:scale-95 cursor-pointer"
              >
                Salin Nominal
              </button>
            </div>
          </div>
        </div>

        <!-- Card Instruksi Rekening Pembayaran -->
        <div id="sectionRekening" class="bg-white rounded-3xl p-6 sm:p-7 border border-slate-200/90 shadow-xs space-y-4">
          <div class="flex items-center gap-3 pb-3 border-b border-slate-100">
            <div class="w-10 h-10 rounded-xl bg-primary-50 text-primary-600 flex items-center justify-center font-bold text-lg">
              💳
            </div>
            <div>
              <h3 class="text-sm font-extrabold text-slate-900">Rekening Tujuan Transfer</h3>
              <p class="text-xs text-slate-500">Transfer tepat sesuai nominal tagihan ke rekening panitia resmi berikut</p>
            </div>
          </div>

          <div class="bg-slate-50 rounded-2xl p-4 border border-slate-200/80 space-y-3">
            <div class="flex justify-between items-center">
              <span class="text-xs text-slate-500 font-semibold">Bank Tujuan</span>
              <span class="text-xs font-bold text-slate-800" id="txtNamaBank">BCA Syariah</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-xs text-slate-500 font-semibold">Nomor Rekening</span>
              <div class="flex items-center gap-2">
                <span class="text-sm font-black text-slate-900 font-mono tracking-wide" id="txtNoRek">0680909090</span>
                <button
                  type="button"
                  id="btnCopyRek"
                  class="px-2.5 py-1 bg-white border border-slate-300 rounded-lg text-[10px] font-bold text-slate-700 hover:bg-slate-100 transition active:scale-95 cursor-pointer"
                >
                  Salin
                </button>
              </div>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-xs text-slate-500 font-semibold">Atas Nama</span>
              <span class="text-xs font-bold text-slate-800" id="txtAtasNama">Yayasan Muslim Scene Official</span>
            </div>
          </div>
        </div>

        <!-- Card Upload Bukti Transfer -->
        <div id="sectionUpload" class="bg-white rounded-3xl p-6 sm:p-7 border border-slate-200/90 shadow-xs space-y-4">
          <div class="flex items-center gap-3 pb-3 border-b border-slate-100">
            <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center font-bold text-lg">
              📤
            </div>
            <div>
              <h3 class="text-sm font-extrabold text-slate-900">Unggah Bukti Pembayaran</h3>
              <p class="text-xs text-slate-500">Kirimkan tangkapan layar (screenshot) atau foto struk bukti transfer m-banking / ATM</p>
            </div>
          </div>

          <!-- Existing Proof Info if already uploaded -->
          <div id="existingProofBox" class="hidden p-4 rounded-2xl bg-blue-50 border border-blue-200 text-blue-900 text-xs flex items-center justify-between gap-3">
            <div class="flex items-center gap-2">
              <span class="text-lg">📄</span>
              <div>
                <span class="font-bold block">Bukti transfer telah tersimpan</span>
                <span class="text-[11px] text-blue-700">Anda dapat mengunggah bukti baru jika ingin mengganti file sebelumnya.</span>
              </div>
            </div>
            <a id="linkLihatBukti" href="#" target="_blank" class="shrink-0 px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-[11px] font-bold transition">
              Lihat Bukti
            </a>
          </div>

          <!-- Upload Dropzone Form -->
          <form id="formUploadBukti" class="space-y-4">
            <div
              id="dropzone"
              class="border-2 border-dashed border-slate-300 hover:border-primary-500 bg-slate-50/70 hover:bg-primary-50/30 rounded-2xl p-6 text-center transition cursor-pointer"
            >
              <input type="file" id="inputBukti" accept="image/jpeg,image/png,image/webp" class="hidden" />
              <div id="dropzoneEmpty" class="space-y-2">
                <span class="text-3xl block">🖼️</span>
                <p class="text-xs font-bold text-slate-700">Klik untuk memilih foto bukti transfer</p>
                <p class="text-[11px] text-slate-400">Format: JPG, PNG, atau WEBP (Maksimal 5MB)</p>
              </div>
              <div id="dropzonePreview" class="hidden space-y-3">
                <img id="imgPreview" src="" alt="Preview Bukti" class="max-h-48 rounded-xl mx-auto border border-slate-200 shadow-xs" />
                <p id="txtFileName" class="text-xs font-mono font-bold text-slate-700">-</p>
                <button type="button" id="btnGantiFoto" class="text-xs text-primary-600 hover:underline font-bold">Ganti Foto Lain</button>
              </div>
            </div>

            <div id="uploadAlert" class="hidden p-3.5 rounded-xl text-xs font-medium"></div>

            <button
              type="submit"
              id="btnSubmitBukti"
              disabled
              class="w-full py-3.5 px-6 rounded-xl text-white bg-slate-300 font-bold text-sm transition shadow-xs cursor-not-allowed"
            >
              Kirim Bukti Pembayaran
            </button>
          </form>
        </div>

        <!-- Section Tiket QR Code (Tampil saat status LUNAS) -->
        <div id="sectionTiket" class="hidden space-y-6">
          <div class="bg-gradient-to-br from-emerald-600 to-teal-700 rounded-3xl p-6 sm:p-8 text-white shadow-lg space-y-4">
            <div class="inline-flex items-center gap-1.5 px-3 py-1 bg-white/20 rounded-full text-[11px] font-bold uppercase tracking-wider">
              <span>🎟️</span>
              <span>Tiket Resmi Family Camp</span>
            </div>
            <h2 class="text-xl sm:text-2xl font-black">Selamat Datang di Family Camp!</h2>
            <p class="text-xs sm:text-sm text-emerald-100 leading-relaxed max-w-lg">
              Pembayaran keluarga Anda telah lunas. Di bawah ini adalah tiket QR Code untuk setiap anggota keluarga/peserta. Simpan atau tangkap layar (screenshot) QR Code ini untuk ditunjukkan ke panitia di meja registrasi.
            </p>
          </div>

          <!-- Cards QR Code per Anggota -->
          <div id="listTiketQr" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Generated via JS -->
          </div>
        </div>

      </div>

    </div>
  </section>

  <script>
    const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:8787';

    function initPembayaranPage() {
      const urlParams = new URLSearchParams(window.location.search);
      const token = urlParams.get('token');

      const loadingBox = document.getElementById('loadingBox');
      const errorBox = document.getElementById('errorBox');
      const errorMsg = document.getElementById('errorMsg');
      const contentBox = document.getElementById('contentBox');

      if (!token) {
        if (loadingBox) loadingBox.classList.add('hidden');
        if (errorBox) {
          errorBox.classList.remove('hidden');
          if (errorMsg) errorMsg.textContent = 'Parameter token pembayaran (?token=...) tidak ditemukan di URL.';
        }
        return;
      }

      loadData(token);
    }

    async function loadData(token: string) {
      const loadingBox = document.getElementById('loadingBox');
      const errorBox = document.getElementById('errorBox');
      const errorMsg = document.getElementById('errorMsg');
      const contentBox = document.getElementById('contentBox');

      try {
        const res = await fetch(`${API_URL}/api/peserta/pembayaran/${encodeURIComponent(token)}`);
        const json = await res.json();

        if (!res.ok || !json.data) {
          throw new Error(json.error || 'Data pembayaran tidak ditemukan');
        }

        renderData(json.data, token);
        if (loadingBox) loadingBox.classList.add('hidden');
        if (contentBox) contentBox.classList.remove('hidden');
      } catch (err: any) {
        if (loadingBox) loadingBox.classList.add('hidden');
        if (errorBox) {
          errorBox.classList.remove('hidden');
          if (errorMsg) errorMsg.textContent = err.message || 'Gagal memuat data pembayaran.';
        }
      }
    }

    function renderData(data: any, token: string) {
      const { grup, anggota, addons, bank_info } = data;

      // 1. Render Status Header Banner
      const statusBanner = document.getElementById('statusBanner');
      if (statusBanner) {
        if (grup.status === 'lunas') {
          statusBanner.className = 'rounded-3xl p-6 sm:p-7 border border-emerald-200 bg-emerald-50 text-emerald-900 shadow-xs space-y-2';
          statusBanner.innerHTML = `
            <div class="flex items-center gap-3">
              <span class="text-3xl">✅</span>
              <div>
                <span class="inline-block px-2.5 py-0.5 bg-emerald-200 text-emerald-800 rounded-md text-[10px] font-black uppercase tracking-wider mb-1">Status: LUNAS & TERKONFIRMASI</span>
                <h2 class="text-lg font-black text-emerald-950">Pembayaran Berhasil Dikonfirmasi!</h2>
              </div>
            </div>
            <p class="text-xs text-emerald-700 leading-relaxed">
              Terima kasih! Seluruh tiket dan QR Code untuk keluarga Anda sudah terbit. Silakan gulir ke bawah untuk melihat tiket QR masing-masing anggota.
            </p>
          `;
        } else if (grup.status === 'menunggu_verifikasi') {
          statusBanner.className = 'rounded-3xl p-6 sm:p-7 border border-sky-200 bg-sky-50 text-sky-900 shadow-xs space-y-2';
          statusBanner.innerHTML = `
            <div class="flex items-center gap-3">
              <span class="text-3xl">⏳</span>
              <div>
                <span class="inline-block px-2.5 py-0.5 bg-sky-200 text-sky-800 rounded-md text-[10px] font-black uppercase tracking-wider mb-1">Status: MENUNGGU VERIFIKASI</span>
                <h2 class="text-lg font-black text-sky-950">Bukti Transfer Sedang Diverifikasi Panitia</h2>
              </div>
            </div>
            <p class="text-xs text-sky-700 leading-relaxed">
              Bukti pembayaran Anda telah kami terima pada <b>${grup.paid_at ? new Date(grup.paid_at).toLocaleString('id-ID') : '-'}</b>. Panitia sedang mencocokkan mutasi bank. Begitu disetujui, tiket QR Code otomatis muncul di halaman ini.
            </p>
          `;
        } else if (grup.status === 'ditolak') {
          statusBanner.className = 'rounded-3xl p-6 sm:p-7 border border-rose-200 bg-rose-50 text-rose-900 shadow-xs space-y-2';
          statusBanner.innerHTML = `
            <div class="flex items-center gap-3">
              <span class="text-3xl">❌</span>
              <div>
                <span class="inline-block px-2.5 py-0.5 bg-rose-200 text-rose-800 rounded-md text-[10px] font-black uppercase tracking-wider mb-1">Status: PEMBAYARAN DITOLAK</span>
                <h2 class="text-lg font-black text-rose-950">Verifikasi Pembayaran Ditolak</h2>
              </div>
            </div>
            <p class="text-xs text-rose-700 leading-relaxed">
              Catatan panitia: <b>"${grup.alasan_tolak || 'Bukti transfer tidak valid atau nominal tidak sesuai'}"</b>. Silakan periksa kembali dan unggah ulang bukti transfer yang benar di bawah.
            </p>
          `;
        } else {
          // 'menunggu_pembayaran'
          statusBanner.className = 'rounded-3xl p-6 sm:p-7 border border-amber-200 bg-amber-50 text-amber-950 shadow-xs space-y-2';
          statusBanner.innerHTML = `
            <div class="flex items-center gap-3">
              <span class="text-3xl">🔔</span>
              <div>
                <span class="inline-block px-2.5 py-0.5 bg-amber-200 text-amber-900 rounded-md text-[10px] font-black uppercase tracking-wider mb-1">Langkah Terakhir: Pembayaran</span>
                <h2 class="text-lg font-black text-amber-950">Menunggu Transfer & Bukti Pembayaran</h2>
              </div>
            </div>
            <p class="text-xs text-amber-800 leading-relaxed">
              Silakan transfer tepat sebesar <b class="font-mono text-slate-900">Rp ${grup.grand_total.toLocaleString('id-ID')}</b> ke rekening panitia di bawah, lalu lampirkan foto/screenshot bukti transfer.
            </p>
          `;
        }
      }

      // 2. Share WA Link (menggunakan template wa_undangan_bayar dari backend/admin)
      const btnShareWA = document.getElementById('btnShareWA') as HTMLAnchorElement | null;
      if (btnShareWA) {
        let cleanPhone = (grup.pic_whatsapp || '').replace(/\D/g, '');
        if (cleanPhone.startsWith('0')) cleanPhone = '62' + cleanPhone.slice(1);
        else if (cleanPhone.startsWith('8')) cleanPhone = '62' + cleanPhone;

        const currentUrl = window.location.href;
        const linkStatus = `${window.location.origin}/status?token=${encodeURIComponent(token)}`;
        const namaAcara = data.nama_acara || 'Family Camp';
        const defaultTpl = `بسم الله
السلام عليكم ورحمة الله وبركاته
Halo *{nama_pic}*,

Terima kasih telah mendaftar *{nama_acara}*.

Total tagihan kelompok Anda: *{total}* untuk {jumlah_anggota} peserta.

Silakan lanjutkan pembayaran & simpan tautan berikut agar tidak hilang:
🔗 {link_pembayaran}

Setelah transfer, unggah bukti pembayaran pada tautan di atas.

جزاكم الله خيرا
_Panitia {nama_acara}_`;

        const vars: Record<string, string> = {
          nama_pic: grup.pic_nama || '',
          nama_acara: namaAcara,
          total: `Rp ${Number(grup.grand_total || 0).toLocaleString('id-ID')}`,
          jumlah_anggota: String(anggota.length ?? grup.jumlah_anggota ?? ''),
          nomor_grup: grup.nomor_grup || '',
          link_pembayaran: currentUrl,
          link_status: linkStatus,
          kode_akses: grup.payment_token || token,
        };

        const bodyTpl = data.wa_undangan_body || defaultTpl;
        const rawMsg = bodyTpl.replace(/\{([a-zA-Z0-9_]+)\}/g, (_m: string, key: string) => vars[key] ?? '');
        const msg = rawMsg.replace(/(^|\n)([ \t]*)([\u0600-\u06FF])/g, '$1$2\u200E$3');
        btnShareWA.href = `https://wa.me/${cleanPhone}?text=${encodeURIComponent(msg)}`;
      }

      // 3. Info PIC & Grup
      const badgeTipe = document.getElementById('badgeTipe');
      if (badgeTipe) badgeTipe.textContent = grup.tipe === 'keluarga' ? 'Pendaftaran Keluarga' : 'Pendaftaran Rombongan / Non-Keluarga';

      const txtPicNama = document.getElementById('txtPicNama');
      if (txtPicNama) txtPicNama.textContent = grup.pic_nama;

      const txtPicWa = document.getElementById('txtPicWa');
      if (txtPicWa) txtPicWa.textContent = `WhatsApp: ${grup.pic_whatsapp}${grup.pic_email ? ' | ' + grup.pic_email : ''}`;

      const txtGrupId = document.getElementById('txtGrupId');
      if (txtGrupId) txtGrupId.textContent = grup.id;

      const txtJmlAnggota = document.getElementById('txtJmlAnggota');
      if (txtJmlAnggota) txtJmlAnggota.textContent = anggota.length;

      // 4. Tabel Anggota
      const tblAnggotaBody = document.getElementById('tblAnggotaBody');
      if (tblAnggotaBody) {
        tblAnggotaBody.innerHTML = anggota.map((a: any, idx: number) => {
          const isGratis = Boolean(a.is_gratis);
          return `
            <tr class="hover:bg-slate-50/60 transition">
              <td class="py-2.5 px-3 text-slate-400 font-mono">${idx + 1}</td>
              <td class="py-2.5 px-3 font-bold text-slate-900">${a.nama}</td>
              <td class="py-2.5 px-3 hidden sm:table-cell">
                <span class="inline-block px-2 py-0.5 bg-slate-100 text-slate-700 rounded text-[10px] font-bold">${a.peran}</span>
              </td>
              <td class="py-2.5 px-3 text-slate-600">${a.jenis_kelamin}</td>
              <td class="py-2.5 px-3 text-slate-600">${a.usia ? a.usia + ' th' : '-'}</td>
              <td class="py-2.5 px-3 text-right font-bold ${isGratis ? 'text-emerald-600' : 'text-slate-800'}">
                ${(() => {
                  const u = a.usia != null ? Number(a.usia) : null;
                  if (isGratis) return 'Rp 0';
                  if (u !== null && u >= 6 && u <= 10) return 'Rp 100.000';
                  return 'Rp 200.000';
                })()}
              </td>
            </tr>
          `;
        }).join('');
      }

      // 5. Rincian Biaya
      const anggotaBerbayar = anggota.filter((a: any) => !a.is_gratis).length;
      const txtHitungWajib = document.getElementById('txtHitungWajib');
      if (txtHitungWajib) txtHitungWajib.textContent = anggotaBerbayar;

      const txtSubtotalWajib = document.getElementById('txtSubtotalWajib');
      if (txtSubtotalWajib) txtSubtotalWajib.textContent = `Rp ${grup.biaya_wajib.toLocaleString('id-ID')}`;

      const listAddons = document.getElementById('listAddons');
      if (listAddons) {
        if (addons.length === 0) {
          listAddons.innerHTML = `<span class="text-slate-400 text-[11px] italic">Tidak ada item sewa tambahan.</span>`;
        } else {
          listAddons.innerHTML = addons.map((add: any) => `
            <div class="flex justify-between text-slate-600">
              <span>${add.nama_item} (x${add.qty})</span>
              <span class="font-bold text-slate-800">Rp ${add.subtotal.toLocaleString('id-ID')}</span>
            </div>
          `).join('');
        }
      }

      const rowKodeUnik = document.getElementById('rowKodeUnik');
      const txtKodeUnik = document.getElementById('txtKodeUnik');
      if (rowKodeUnik && txtKodeUnik) {
        if (grup.kode_unik && grup.kode_unik > 0) {
          rowKodeUnik.classList.remove('hidden');
          txtKodeUnik.textContent = `+Rp ${grup.kode_unik}`;
        } else {
          rowKodeUnik.classList.add('hidden');
        }
      }

      const txtGrandTotal = document.getElementById('txtGrandTotal');
      if (txtGrandTotal) txtGrandTotal.textContent = `Rp ${grup.grand_total.toLocaleString('id-ID')}`;

      // Tombol copy total
      const btnCopyTotal = document.getElementById('btnCopyTotal');
      if (btnCopyTotal) {
        btnCopyTotal.onclick = () => {
          navigator.clipboard.writeText(String(grup.grand_total));
          btnCopyTotal.textContent = 'Tersalin! ✓';
          setTimeout(() => (btnCopyTotal.textContent = 'Salin Nominal'), 2000);
        };
      }

      // 6. Bank Info
      const bankNama = bank_info?.bank || 'BCA Syariah';
      const bankNomor = bank_info?.nomor_rekening || '0680909090';
      const bankAtasNama = bank_info?.atas_nama || 'Yayasan Muslim Scene Official';

      const txtNamaBank = document.getElementById('txtNamaBank');
      if (txtNamaBank) txtNamaBank.textContent = bankNama;

      const txtNoRek = document.getElementById('txtNoRek');
      if (txtNoRek) txtNoRek.textContent = bankNomor;

      const txtAtasNama = document.getElementById('txtAtasNama');
      if (txtAtasNama) txtAtasNama.textContent = bankAtasNama;

      const btnCopyRek = document.getElementById('btnCopyRek');
      if (btnCopyRek) {
        btnCopyRek.onclick = () => {
          navigator.clipboard.writeText(bankNomor);
          btnCopyRek.textContent = 'Tersalin! ✓';
          setTimeout(() => (btnCopyRek.textContent = 'Salin'), 2000);
        };
      }

      // 7. Handle Bukti Transfer Upload Box
      const existingProofBox = document.getElementById('existingProofBox');
      const linkLihatBukti = document.getElementById('linkLihatBukti') as HTMLAnchorElement | null;
      if (grup.bukti_url && existingProofBox && linkLihatBukti) {
        existingProofBox.classList.remove('hidden');
        linkLihatBukti.href = `${API_URL}${grup.bukti_url}`;
      }

      // Setup Upload Form
      setupUploadForm(token);

      // 8. Handle Tiket QR jika status Lunas
      const sectionTiket = document.getElementById('sectionTiket');
      const sectionUpload = document.getElementById('sectionUpload');
      const sectionRekening = document.getElementById('sectionRekening');

      if (grup.status === 'lunas') {
        if (sectionTiket) sectionTiket.classList.remove('hidden');
        if (sectionUpload) sectionUpload.classList.add('hidden');
        if (sectionRekening) sectionRekening.classList.add('hidden');

        const listTiketQr = document.getElementById('listTiketQr');
        if (listTiketQr) {
          listTiketQr.innerHTML = anggota.map((a: any) => {
            const qrUrl = a.qr_token ? `${API_URL}/api/peserta/qr/${a.qr_token}` : '';
            return `
              <div class="bg-white rounded-3xl p-6 border border-slate-200/90 shadow-sm text-center space-y-4">
                <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                  <span class="inline-block px-2.5 py-0.5 bg-primary-100 text-primary-800 rounded-md text-[10px] font-black uppercase tracking-wider">${a.peran}</span>
                  <span class="text-xs font-bold ${a.status_hadir === 'hadir' ? 'text-emerald-600' : 'text-slate-400'}">
                    ${a.status_hadir === 'hadir' ? '✓ Sudah Hadir' : '○ Belum Hadir'}
                  </span>
                </div>

                <div>
                  <h4 class="text-base font-extrabold text-slate-900">${a.nama}</h4>
                  <p class="text-xs text-slate-400">${a.jenis_kelamin}${a.usia ? ' • ' + a.usia + ' th' : ''}</p>
                </div>

                ${qrUrl ? `
                  <div class="p-3 bg-slate-50 rounded-2xl border border-slate-200/80 inline-block mx-auto shadow-inner">
                    <img src="${qrUrl}" alt="QR Tiket ${a.nama}" class="w-44 h-44 object-contain mx-auto" />
                  </div>
                  <div>
                    <span class="text-[10px] font-mono font-bold text-slate-400 block mb-2">${a.qr_token}</span>
                    <a
                      href="${qrUrl}?format=png"
                      download="Tiket-${a.nama.replace(/\s+/g, '_')}.png"
                      class="inline-flex items-center gap-1.5 px-4 py-2 bg-primary-600 hover:bg-primary-700 text-white text-xs font-bold rounded-xl transition shadow-xs active:scale-95"
                    >
                      <span>📥 Unduh QR</span>
                    </a>
                  </div>
                ` : `
                  <div class="p-6 bg-slate-50 rounded-2xl border border-slate-200 text-slate-400 text-xs font-semibold">
                    QR Code sedang diproses panitia...
                  </div>
                `}
              </div>
            `;
          }).join('');
        }
      }
    }

    function setupUploadForm(token: string) {
      const dropzone = document.getElementById('dropzone');
      const inputBukti = document.getElementById('inputBukti') as HTMLInputElement | null;
      const dropzoneEmpty = document.getElementById('dropzoneEmpty');
      const dropzonePreview = document.getElementById('dropzonePreview');
      const imgPreview = document.getElementById('imgPreview') as HTMLImageElement | null;
      const txtFileName = document.getElementById('txtFileName');
      const btnGantiFoto = document.getElementById('btnGantiFoto');
      const btnSubmitBukti = document.getElementById('btnSubmitBukti') as HTMLButtonElement | null;
      const formUploadBukti = document.getElementById('formUploadBukti');
      const uploadAlert = document.getElementById('uploadAlert');

      let selectedFile: File | null = null;

      if (!dropzone || !inputBukti) return;

      dropzone.onclick = (e) => {
        if (e.target !== btnGantiFoto) {
          inputBukti.click();
        }
      };

      if (btnGantiFoto) {
        btnGantiFoto.onclick = (e) => {
          e.stopPropagation();
          inputBukti.click();
        };
      }

      inputBukti.onchange = async () => {
        if (inputBukti.files && inputBukti.files[0]) {
          const file = inputBukti.files[0];
          selectedFile = file;

          // Preview
          const reader = new FileReader();
          reader.onload = (re) => {
            if (imgPreview && re.target) imgPreview.src = re.target.result as string;
            if (txtFileName) txtFileName.textContent = file.name;
            if (dropzoneEmpty) dropzoneEmpty.classList.add('hidden');
            if (dropzonePreview) dropzonePreview.classList.remove('hidden');

            if (btnSubmitBukti) {
              btnSubmitBukti.disabled = false;
              btnSubmitBukti.className = 'w-full py-3.5 px-6 rounded-xl text-white bg-primary-600 hover:bg-primary-700 font-bold text-sm transition shadow-md active:scale-95 cursor-pointer';
            }
          };
          reader.readAsDataURL(file);
        }
      };

      if (formUploadBukti) {
        formUploadBukti.onsubmit = async (e) => {
          e.preventDefault();
          if (!selectedFile) return;

          if (btnSubmitBukti) {
            btnSubmitBukti.disabled = true;
            btnSubmitBukti.textContent = 'Mengunggah bukti transfer...';
            btnSubmitBukti.className = 'w-full py-3.5 px-6 rounded-xl text-white bg-slate-400 font-bold text-sm transition cursor-wait';
          }

          if (uploadAlert) uploadAlert.classList.add('hidden');

          try {
            const formData = new FormData();
            formData.append('bukti', selectedFile);

            const res = await fetch(`${API_URL}/api/peserta/pembayaran/${encodeURIComponent(token)}/upload`, {
              method: 'POST',
              body: formData,
            });

            const json = await res.json();
            if (!res.ok) throw new Error(json.error || 'Gagal mengunggah bukti');

            if (uploadAlert) {
              uploadAlert.className = 'p-3.5 rounded-xl text-xs font-bold bg-emerald-50 text-emerald-800 border border-emerald-200 block';
              uploadAlert.textContent = 'Alhamdulillah! Bukti pembayaran berhasil diunggah. Halaman akan diperbarui...';
            }

            setTimeout(() => {
              window.location.reload();
            }, 1200);
          } catch (err: any) {
            if (uploadAlert) {
              uploadAlert.className = 'p-3.5 rounded-xl text-xs font-bold bg-rose-50 text-rose-800 border border-rose-200 block';
              uploadAlert.textContent = err.message || 'Terjadi kesalahan saat mengunggah.';
            }
            if (btnSubmitBukti) {
              btnSubmitBukti.disabled = false;
              btnSubmitBukti.textContent = 'Kirim Bukti Pembayaran';
              btnSubmitBukti.className = 'w-full py-3.5 px-6 rounded-xl text-white bg-primary-600 hover:bg-primary-700 font-bold text-sm transition shadow-md active:scale-95 cursor-pointer';
            }
          }
        };
      }
    }

    document.addEventListener('astro:page-load', initPembayaranPage);
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initPembayaranPage);
    } else {
      initPembayaranPage();
    }
  </script>
</Layout>
