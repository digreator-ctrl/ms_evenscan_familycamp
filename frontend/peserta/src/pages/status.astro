---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Cek Status & Tiket QR - Muslim Scene">
  <section class="py-12 sm:py-16">
    <div class="max-w-2xl mx-auto px-4 space-y-6">
      <!-- Section Header -->
      <div class="text-center">
        <span class="inline-block px-3 py-1 bg-primary-100 text-primary-800 text-xs font-bold rounded-full uppercase tracking-wider mb-2">
          Portal Peserta
        </span>
        <h1 class="text-3xl font-black text-slate-900 tracking-tight">
          Cek Status & Tiket QR
        </h1>
        <p class="text-sm text-slate-500 mt-2 max-w-md mx-auto">
          Masukkan kode akses yang dikirim panitia melalui WhatsApp untuk
          melihat status pendaftaran dan tiket QR seluruh anggota.
        </p>
      </div>

      <!-- Pop-up Toast Alert -->
      <div
        id="toastAlert"
        class="fixed top-6 left-1/2 -translate-x-1/2 z-50 flex items-center gap-3 bg-slate-900/95 text-white px-5 py-3.5 rounded-2xl shadow-2xl border border-slate-700/80 backdrop-blur-md transition-all duration-300 opacity-0 pointer-events-none -translate-y-4 max-w-sm w-[90%]"
        role="alert"
        aria-live="assertive"
      >
        <div class="w-8 h-8 rounded-xl bg-amber-500/20 text-amber-400 flex items-center justify-center shrink-0 text-base font-bold">
          ⚠️
        </div>
        <div class="flex-1">
          <p class="text-xs font-bold text-white" id="toastTitle">
            Kolom Belum Terisi
          </p>
          <p
            class="text-[11px] text-slate-300 mt-0.5 leading-snug"
            id="toastMessage"
          >
            Harap masukkan kode akses tiket Anda.
          </p>
        </div>
      </div>

      <!-- Search Card -->
      <div class="bg-white rounded-2xl shadow-sm border border-slate-200/80 p-5 sm:p-6">
        <form id="formStatus" novalidate class="space-y-4">
          <div>
            <label
              for="inputKode"
              class="block text-xs font-bold text-slate-700 mb-1.5"
            >
              Kode Akses / Token Pembayaran / Nomor WhatsApp PIC
            </label>
            <input
              type="text"
              id="inputKode"
              placeholder="Contoh: ahmad1234 atau 081234567890"
              required
              class="w-full border border-slate-300 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-primary-500/20 focus:border-primary-600 outline-none transition font-mono tracking-wide"
            />
            <p class="text-[11px] text-slate-400 mt-1.5 flex items-center gap-1">
              <span>💡</span>
              <span>
                Gunakan kode akses pada pesan WhatsApp panitia, atau nomor
                WhatsApp PIC yang didaftarkan.
              </span>
            </p>
          </div>

          <button
            type="submit"
            id="btnCari"
            class="w-full bg-primary-600 hover:bg-primary-700 active:scale-[0.99] text-white font-bold px-6 py-3.5 rounded-xl transition duration-150 text-sm shadow-md shadow-primary-600/20 flex items-center justify-center gap-2 cursor-pointer"
          >
            <svg
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.5"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
              />
            </svg>
            <span>Periksa Status & Tiket</span>
          </button>
        </form>
      </div>

      <!-- Loading State -->
      <div id="loading" class="hidden text-center py-10 space-y-3">
        <div class="inline-block animate-spin rounded-full h-8 w-8 border-3 border-primary-600 border-t-transparent"></div>
        <p class="text-sm font-medium text-slate-500">
          Mencari data pendaftaran...
        </p>
      </div>

      <!-- Result: Tidak Ditemukan -->
      <div
        id="resultNotFound"
        class="hidden bg-slate-100/90 border border-slate-200 rounded-3xl p-6 sm:p-8 text-center space-y-3"
      >
        <div class="w-16 h-16 bg-slate-200 text-slate-500 rounded-2xl flex items-center justify-center mx-auto text-2xl font-bold">
          🔍
        </div>
        <h2 class="text-lg font-bold text-slate-800">Data Tidak Ditemukan</h2>
        <p class="text-xs text-slate-500 max-w-xs mx-auto">
          Data pendaftaran dengan kode akses tersebut tidak ditemukan. Pastikan
          kode akses yang dimasukkan sesuai dengan pesan WhatsApp dari panitia.
        </p>
        <div class="pt-2">
          <a
            href="/daftar"
            class="inline-block bg-primary-600 hover:bg-primary-700 text-white font-bold px-5 py-2.5 rounded-xl text-xs transition"
          >
            Daftar Sekarang
          </a>
        </div>
      </div>

      <!-- Result: Beberapa Pendaftaran (pilih salah satu) -->
      <div
        id="resultList"
        class="hidden bg-white border border-slate-200/90 rounded-3xl p-5 sm:p-6 shadow-sm space-y-3"
      >
        <div class="flex items-center gap-2 pb-1">
          <span class="text-xl">👥</span>
          <p class="text-xs font-bold uppercase tracking-wider text-slate-500">
            Ditemukan beberapa pendaftaran dengan nomor ini
          </p>
        </div>
        <div id="listContainer" class="space-y-2"></div>
      </div>

      <!-- Result: Status Grup Family Camp -->
      <div id="resultGrup" class="hidden space-y-4">
        <div class="bg-white border border-slate-200/90 rounded-3xl p-5 sm:p-7 shadow-sm space-y-5">
          <!-- Status Banner -->
          <div id="grupStatusBanner" class="rounded-2xl p-4 border"></div>

          <!-- Info PIC & Grup -->
          <div id="grupInfo" class="space-y-1.5"></div>

          <!-- Daftar Anggota & Tiket QR -->
          <div id="grupAnggota" class="space-y-3"></div>
        </div>
      </div>
    </div>
  </section>

  <script>
    const API_URL = import.meta.env.PUBLIC_API_URL || "http://localhost:8787";

    const SESI_LIST = [
      { id: "checkin", label: "Check-in" },
      { id: "makan_sabtu_siang", label: "Sbt Siang" },
      { id: "makan_sabtu_malam", label: "Sbt Malam" },
      { id: "makan_ahad_pagi", label: "Ahad Pagi" },
    ];

    function initStatusPage() {
      const form = document.getElementById(
        "formStatus",
      ) as HTMLFormElement | null;
      const input = document.getElementById(
        "inputKode",
      ) as HTMLInputElement | null;
      const loading = document.getElementById("loading");
      const notFound = document.getElementById("resultNotFound");
      const resultGrup = document.getElementById("resultGrup");
      const resultList = document.getElementById("resultList");
      const listContainer = document.getElementById("listContainer");
      const grupStatusBanner = document.getElementById("grupStatusBanner");
      const grupInfo = document.getElementById("grupInfo");
      const grupAnggota = document.getElementById("grupAnggota");

      const toast = document.getElementById("toastAlert");
      const toastTitle = document.getElementById("toastTitle");
      const toastMessage = document.getElementById("toastMessage");

      if (!form || !input || !resultGrup) return;

      let toastTimer: ReturnType<typeof setTimeout> | null = null;
      function showToast(message: string, title = "Kolom Wajib Diisi") {
        if (!toast) return;
        if (toastTitle) toastTitle.textContent = title;
        if (toastMessage) toastMessage.textContent = message;
        toast.classList.remove(
          "opacity-0",
          "pointer-events-none",
          "-translate-y-4",
        );
        toast.classList.add("opacity-100", "translate-y-0");
        if (toastTimer) clearTimeout(toastTimer);
        toastTimer = setTimeout(() => {
          toast.classList.remove("opacity-100", "translate-y-0");
          toast.classList.add(
            "opacity-0",
            "pointer-events-none",
            "-translate-y-4",
          );
        }, 3000);
      }

      function hideAll() {
        notFound?.classList.add("hidden");
        resultGrup?.classList.add("hidden");
        resultList?.classList.add("hidden");
      }

      function formatRupiah(n: number): string {
        return "Rp " + (Number(n) || 0).toLocaleString("id-ID");
      }

      function statusLabelOf(status: string): string {
        const map: Record<string, string> = {
          lunas: "Lunas",
          menunggu_verifikasi: "Menunggu Verifikasi",
          menunggu_pembayaran: "Menunggu Pembayaran",
          ditolak: "Ditolak",
          draft: "Draft",
        };
        return map[status] || status;
      }

      function statusToneOf(status: string): string {
        const map: Record<string, string> = {
          lunas: "bg-emerald-100 text-emerald-800",
          menunggu_verifikasi: "bg-sky-100 text-sky-800",
          menunggu_pembayaran: "bg-amber-100 text-amber-800",
          ditolak: "bg-rose-100 text-rose-800",
          draft: "bg-slate-100 text-slate-600",
        };
        return map[status] || "bg-slate-100 text-slate-600";
      }

      function renderGroupList(groups: any[]) {
        if (!listContainer) return;
        listContainer.innerHTML = groups
          .map((g, idx) => {
            return `
              <button type="button" data-idx="${idx}" class="list-item w-full text-left bg-slate-50 hover:bg-slate-100 border border-slate-200 rounded-2xl p-4 transition flex items-center justify-between gap-3 cursor-pointer">
                <div class="min-w-0">
                  <p class="text-xs font-mono font-black text-primary-700">${g.nomor_grup || g.id}</p>
                  <p class="text-sm font-bold text-slate-900 truncate">${g.pic_nama}</p>
                  <p class="text-[11px] text-slate-500">${g.tipe === "keluarga" ? "Keluarga" : "Rombongan"} • ${g.jumlah_anggota} anggota</p>
                </div>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold shrink-0 ${statusToneOf(g.status)}">${statusLabelOf(g.status)}</span>
              </button>
            `;
          })
          .join("");

        listContainer.querySelectorAll(".list-item").forEach((btn) => {
          btn.addEventListener("click", () => {
            const idx = Number((btn as HTMLElement).dataset.idx);
            const g = groups[idx];
            if (g) {
              renderGroup(g);
              resultList?.classList.add("hidden");
              resultGrup?.classList.remove("hidden");
            }
          });
        });
      }

      async function fetchGroup(query: string, byToken: boolean) {
        hideAll();
        loading?.classList.remove("hidden");
        try {
          const res = await fetch(
            `${API_URL}/api/peserta/status-grup?${query}`,
          );
          const json = await res.json().catch(() => ({}));
          if (!res.ok || !json.data || json.data.length === 0) {
            throw new Error(json.error || "Data tidak ditemukan");
          }
          if (!byToken && json.data.length > 1) {
            renderGroupList(json.data);
            resultList?.classList.remove("hidden");
          } else {
            renderGroup(json.data[0]);
            resultGrup?.classList.remove("hidden");
          }
        } catch (err: any) {
          notFound?.classList.remove("hidden");
        } finally {
          loading?.classList.add("hidden");
        }
      }

      function renderGroup(g: any) {
        // 1. Status banner
        if (grupStatusBanner) {
          if (g.status === "lunas") {
            grupStatusBanner.className =
              "rounded-2xl p-4 border border-emerald-200 bg-emerald-50 text-emerald-900";
            grupStatusBanner.innerHTML = `
              <div class="flex items-center gap-3">
                <span class="text-3xl">✅</span>
                <div>
                  <span class="inline-block px-2.5 py-0.5 bg-emerald-200 text-emerald-800 rounded-md text-[10px] font-black uppercase tracking-wider mb-1">Status: LUNAS & TIKET TERBIT</span>
                  <h2 class="text-base font-black text-emerald-950">Pembayaran Berhasil Dikonfirmasi</h2>
                  <p class="text-xs text-emerald-700 mt-0.5">Tiket QR seluruh anggota sudah terbit. Simpan atau screenshot masing-masing QR Code untuk check-in dan jatah makan.</p>
                </div>
              </div>
            `;
          } else if (g.status === "menunggu_verifikasi") {
            grupStatusBanner.className =
              "rounded-2xl p-4 border border-sky-200 bg-sky-50 text-sky-900";
            grupStatusBanner.innerHTML = `
              <div class="flex items-center gap-3">
                <span class="text-3xl">⏳</span>
                <div>
                  <span class="inline-block px-2.5 py-0.5 bg-sky-200 text-sky-800 rounded-md text-[10px] font-black uppercase tracking-wider mb-1">Status: MENUNGGU VERIFIKASI</span>
                  <h2 class="text-base font-black text-sky-950">Bukti Transfer Sedang Diverifikasi</h2>
                  <p class="text-xs text-sky-700 mt-0.5">Panitia sedang memeriksa bukti transfer Anda. Tiket QR akan otomatis muncul di halaman ini setelah disetujui.</p>
                </div>
              </div>
            `;
          } else if (g.status === "ditolak") {
            grupStatusBanner.className =
              "rounded-2xl p-4 border border-rose-200 bg-rose-50 text-rose-900";
            grupStatusBanner.innerHTML = `
              <div class="flex items-center gap-3">
                <span class="text-3xl">❌</span>
                <div>
                  <span class="inline-block px-2.5 py-0.5 bg-rose-200 text-rose-800 rounded-md text-[10px] font-black uppercase tracking-wider mb-1">Status: PEMBAYARAN DITOLAK</span>
                  <h2 class="text-base font-black text-rose-950">Verifikasi Pembayaran Ditolak</h2>
                  <p class="text-xs text-rose-700 mt-0.5">${g.alasan_tolak || "Bukti transfer tidak valid atau nominal tidak sesuai"}</p>
                </div>
              </div>
            `;
          } else {
            grupStatusBanner.className =
              "rounded-2xl p-4 border border-amber-200 bg-amber-50 text-amber-950";
            grupStatusBanner.innerHTML = `
              <div class="flex items-center gap-3">
                <span class="text-3xl">🔔</span>
                <div>
                  <span class="inline-block px-2.5 py-0.5 bg-amber-200 text-amber-900 rounded-md text-[10px] font-black uppercase tracking-wider mb-1">Status: MENUNGGU PEMBAYARAN</span>
                  <h2 class="text-base font-black text-amber-950">Langkah Terakhir: Pembayaran</h2>
                  <p class="text-xs text-amber-800 mt-0.5">Segera transfer sebesar ${formatRupiah(g.grand_total)} lalu unggah bukti transfer untuk menerbitkan tiket QR.</p>
                </div>
              </div>
            `;
          }
        }

        // 2. Info PIC & Grup
        if (grupInfo) {
          const linkPembayaran = g.payment_token
            ? `/pembayaran?token=${encodeURIComponent(g.payment_token)}`
            : "#";
          grupInfo.innerHTML = `
            <div class="flex items-center justify-between">
              <div>
                <span class="inline-block px-2.5 py-1 bg-primary-50 text-primary-700 border border-primary-200 rounded-lg text-[10px] font-black uppercase tracking-wider">
                  ${g.tipe === "keluarga" ? "Pendaftaran Keluarga" : "Rombongan / Non-Keluarga"}
                </span>
                <h3 class="text-lg font-extrabold text-slate-900 mt-1.5">${g.pic_nama}</h3>
                <p class="text-xs text-slate-500 font-mono">${g.nomor_grup || g.id}</p>
              </div>
              <div class="text-right">
                <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider block">Total Anggota</span>
                <span class="text-lg font-black text-slate-800">${g.jumlah_anggota} orang</span>
                <span class="text-[11px] text-slate-500 block">${formatRupiah(g.grand_total)}</span>
              </div>
            </div>
            ${
              g.status === "menunggu_pembayaran"
                ? `
              <a href="${linkPembayaran}" class="mt-3 inline-flex w-full items-center justify-center gap-2 py-3 px-5 bg-primary-600 hover:bg-primary-700 text-white font-bold rounded-xl text-sm transition shadow-md shadow-primary-600/20">
                <span>Buka Halaman Pembayaran & Upload Bukti</span>
                <span>→</span>
              </a>
            `
                : ""
            }
          `;
        }

        // 3. Daftar Anggota & Tiket QR
        if (grupAnggota) {
          grupAnggota.innerHTML = renderAnggota(g);
          if (g.status === "lunas") {
            setupAccordionAndDownloads(g);
          }
        }
      }

      function drawRoundRect(
        ctx: CanvasRenderingContext2D,
        x: number,
        y: number,
        w: number,
        h: number,
        r: number
      ) {
        ctx.beginPath();
        ctx.moveTo(x + r, y);
        ctx.lineTo(x + w - r, y);
        ctx.quadraticCurveTo(x + w, y, x + w, y + r);
        ctx.lineTo(x + w, y + h - r);
        ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
        ctx.lineTo(x + r, y + h);
        ctx.quadraticCurveTo(x, y + h, x, y + h - r);
        ctx.lineTo(x, y + r);
        ctx.quadraticCurveTo(x, y, x + r, y);
        ctx.closePath();
      }

      function generateAndDownloadIdCard(
        anggota: any,
        kodeAkses: string,
        qrUrl: string,
        btn: HTMLElement
      ) {
        if (!qrUrl) {
          showToast("QR Code belum tersedia atau sedang diproses panitia.");
          return;
        }

        const originalHtml = btn.innerHTML;
        btn.innerHTML = `<span class="inline-block animate-spin mr-1">⏳</span><span>Mengunduh...</span>`;
        btn.style.pointerEvents = "none";

        const img = new Image();
        img.crossOrigin = "anonymous";
        const sep = qrUrl.includes("?") ? "&" : "?";
        img.src = `${qrUrl}${sep}cb=${Date.now()}`;

        img.onload = () => {
          try {
            const canvas = document.createElement("canvas");
            canvas.width = 600;
            canvas.height = 920;
            const ctx = canvas.getContext("2d");
            if (!ctx) throw new Error("Canvas context tidak tersedia");

            // 1. Background card putih
            ctx.fillStyle = "#ffffff";
            ctx.fillRect(0, 0, 600, 920);

            // Card outer border
            ctx.strokeStyle = "#e2e8f0";
            ctx.lineWidth = 4;
            ctx.strokeRect(2, 2, 596, 916);

            // 2. Banner Header Navy
            ctx.fillStyle = "#06305d";
            ctx.fillRect(0, 0, 600, 140);

            // Badge Pill "FAMILY CAMP"
            ctx.fillStyle = "#f59e0b";
            drawRoundRect(ctx, 210, 24, 180, 28, 14);
            ctx.fill();

            ctx.fillStyle = "#0f172a";
            ctx.font = "bold 13px system-ui, -apple-system, sans-serif";
            ctx.textAlign = "center";
            ctx.fillText("FAMILY CAMP", 300, 43);

            // Judul ID Card
            ctx.fillStyle = "#ffffff";
            ctx.font = "900 24px system-ui, -apple-system, sans-serif";
            ctx.fillText("ID CARD PESERTA", 300, 95);

            ctx.fillStyle = "#93c5fd";
            ctx.font = "500 13px system-ui, -apple-system, sans-serif";
            ctx.fillText("Muslim Scene EvenScan", 300, 120);

            // 3. QR Code Box
            ctx.fillStyle = "#f8fafc";
            drawRoundRect(ctx, 160, 175, 280, 280, 20);
            ctx.fill();
            ctx.strokeStyle = "#cbd5e1";
            ctx.lineWidth = 2;
            drawRoundRect(ctx, 160, 175, 280, 280, 20);
            ctx.stroke();

            // Gambar QR
            ctx.drawImage(img, 175, 190, 250, 250);

            // 4. Nomor Peserta Pill
            ctx.fillStyle = "#f0f9ff";
            drawRoundRect(ctx, 190, 485, 220, 36, 10);
            ctx.fill();
            ctx.strokeStyle = "#bae6fd";
            ctx.lineWidth = 1.5;
            drawRoundRect(ctx, 190, 485, 220, 36, 10);
            ctx.stroke();

            ctx.fillStyle = "#0284c7";
            ctx.font = "900 18px monospace, system-ui";
            ctx.textAlign = "center";
            ctx.fillText(anggota.nomor_peserta || "-", 300, 509);

            // 5. Nama Peserta
            ctx.fillStyle = "#0f172a";
            const nama = anggota.nama || "Peserta";
            if (nama.length > 25) {
              ctx.font = "bold 20px system-ui, -apple-system, sans-serif";
            } else {
              ctx.font = "bold 26px system-ui, -apple-system, sans-serif";
            }
            ctx.fillText(nama, 300, 560);

            // 6. Detail Peran / Usia
            const details = [
              anggota.peran || "Peserta",
              anggota.jenis_kelamin || "",
              anggota.usia != null ? `${anggota.usia} th` : "",
              anggota.kategori_usia_label || "",
            ]
              .filter(Boolean)
              .join(" • ");

            ctx.fillStyle = "#64748b";
            ctx.font = "500 14px system-ui, -apple-system, sans-serif";
            ctx.fillText(details, 300, 592);

            // 7. Box Kode Akses (Highlighted Amber untuk Input Manual Panitia)
            ctx.fillStyle = "#fef3c7";
            drawRoundRect(ctx, 50, 630, 500, 130, 18);
            ctx.fill();
            ctx.strokeStyle = "#f59e0b";
            ctx.lineWidth = 2.5;
            drawRoundRect(ctx, 50, 630, 500, 130, 18);
            ctx.stroke();

            ctx.fillStyle = "#92400e";
            ctx.font = "bold 13px system-ui, -apple-system, sans-serif";
            ctx.fillText("KODE AKSES MANUAL (PANITIA):", 300, 662);

            ctx.fillStyle = "#78350f";
            ctx.font = "900 32px monospace, system-ui";
            ctx.fillText(kodeAkses || "-", 300, 706);

            ctx.fillStyle = "#b45309";
            ctx.font = "500 12px system-ui, -apple-system, sans-serif";
            ctx.fillText(
              "Sebutkan kode ini ke panitia jika QR scanner terkendala di lokasi",
              300,
              738
            );

            // 8. Footer Card
            ctx.strokeStyle = "#e2e8f0";
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(60, 790);
            ctx.lineTo(540, 790);
            ctx.stroke();

            ctx.fillStyle = "#64748b";
            ctx.font = "500 12px system-ui, -apple-system, sans-serif";
            ctx.fillText(
              "Tunjukkan ID Card ini saat check-in & pengambilan konsumsi",
              300,
              825
            );

            ctx.fillStyle = "#94a3b8";
            ctx.font = "bold 11px system-ui, -apple-system, sans-serif";
            ctx.fillText("MUSLIM SCENE OFFICIAL • EVENT REGISTRATION", 300, 855);

            // Trigger Download
            const link = document.createElement("a");
            const safeName = (anggota.nama || "peserta").replace(
              /[^a-zA-Z0-9_-]/g,
              "_"
            );
            const safeNo = (anggota.nomor_peserta || "ID").replace(
              /[^a-zA-Z0-9_-]/g,
              "_"
            );
            link.download = `IDCard-${safeNo}-${safeName}.png`;
            link.href = canvas.toDataURL("image/png");
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            showToast(`ID Card ${anggota.nama} berhasil diunduh!`, "Berhasil");
          } catch (e: any) {
            console.error("Gagal generate ID card canvas:", e);
            showToast("ID Card gagal dibuat. Silakan coba unduh kembali.", "Gagal Mengunduh");
          } finally {
            btn.innerHTML = originalHtml;
            btn.style.pointerEvents = "";
          }
        };

        img.onerror = () => {
          btn.innerHTML = originalHtml;
          btn.style.pointerEvents = "";
          showToast(
            "Gagal memuat QR Code. Silakan periksa koneksi internet.",
            "Gagal Mengunduh"
          );
        };
      }

      function setupAccordionAndDownloads(g: any) {
        const container = document.getElementById("grupAnggota");
        if (!container) return;

        const anggotaList = Array.isArray(g.anggota) ? g.anggota : [];
        const kodeAkses = g.payment_token || "";

        // 1. Accordion Toggle
        container
          .querySelectorAll(".anggota-accordion-card")
          .forEach((card) => {
            const header = card.querySelector(".accordion-header");
            const body = card.querySelector(".accordion-body");
            const chevron = card.querySelector(".chevron-icon");

            if (header && body) {
              header.addEventListener("click", (e) => {
                // Abaikan jika user mengklik tombol unduh
                if ((e.target as HTMLElement).closest(".btn-unduh-idcard")) return;

                const isHidden = body.classList.contains("hidden");
                if (isHidden) {
                  body.classList.remove("hidden");
                  chevron?.classList.add("rotate-180");
                } else {
                  body.classList.add("hidden");
                  chevron?.classList.remove("rotate-180");
                }
              });
            }
          });

        // 2. Tombol Unduh ID Card (Header Accordion)
        const handleDownload = (btn: HTMLElement) => {
          const idx = parseInt(btn.getAttribute("data-index") || "0", 10);
          const anggota = anggotaList[idx];
          if (!anggota) return;
          const qrUrl = anggota.qr_token
            ? `${API_URL}/api/peserta/qr/${anggota.qr_token}`
            : "";
          generateAndDownloadIdCard(anggota, kodeAkses, qrUrl, btn);
        };

        container.querySelectorAll(".btn-unduh-idcard").forEach((btn) => {
          btn.addEventListener("click", (e) => {
            e.stopPropagation();
            handleDownload(btn as HTMLElement);
          });
        });
      }

      function renderAnggota(g: any): string {
        const anggota = Array.isArray(g.anggota) ? g.anggota : [];
        if (anggota.length === 0) return "";

        const heading = `<p class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Daftar Anggota & Tiket QR</p>`;

        if (g.status !== "lunas") {
          // Belum lunas: tampilkan daftar nama saja tanpa QR
          const rows = anggota
            .map(
              (a: any) => `
              <div class="p-3 bg-slate-50 rounded-xl border border-slate-200">
                <div class="flex items-center justify-between gap-2">
                  <div class="min-w-0">
                    <p class="text-xs font-mono font-black text-primary-700">${a.nomor_peserta || "-"}</p>
                    <p class="text-sm font-bold text-slate-900 truncate">${a.nama}</p>
                    <p class="text-[11px] text-slate-500">${a.peran || ""} • ${a.jenis_kelamin || ""}${a.usia != null ? " • " + a.usia + " th" : ""}</p>
                  </div>
                  <span class="text-[10px] font-bold text-slate-400 shrink-0">QR menunggu verifikasi</span>
                </div>
              </div>
            `,
            )
            .join("");
          return heading + `<div class="space-y-2">${rows}</div>`;
        }

        const kodeAkses = g.payment_token || "";

        // Lunas: tampilkan accordion card per anggota
        const rows = anggota
          .map((a: any, idx: number) => {
            const scan = a.scan_sesi || {};
            const noJatah =
              (a.is_gratis === 1 || a.is_gratis === true) &&
              !(a.makan_dicover === 1 || a.makan_dicover === true);
            const qrUrl = a.qr_token
              ? `${API_URL}/api/peserta/qr/${a.qr_token}`
              : "";

            const sesiBadges = SESI_LIST.map((s) => {
              if (s.id !== "checkin" && noJatah) {
                return `<span class="px-1.5 py-0.5 rounded text-[9px] font-semibold bg-slate-100 text-slate-400" title="Tanpa jatah makan">${s.label} —</span>`;
              }
              const done = !!scan[s.id];
              return `<span class="px-1.5 py-0.5 rounded text-[9px] font-semibold ${done ? "bg-emerald-100 text-emerald-700" : "bg-slate-100 text-slate-400"}">${done ? "✓" : "○"} ${s.label}</span>`;
            }).join(" ");

            const detailsText = [
              a.peran || "Peserta",
              a.jenis_kelamin || "",
              a.usia != null ? `${a.usia} th` : "",
              a.kategori_usia_label || "",
            ]
              .filter(Boolean)
              .join(" • ");

            return `
              <div class="anggota-accordion-card rounded-2xl border border-slate-200 bg-white shadow-xs overflow-hidden transition" data-index="${idx}">
                <!-- Header Ringkas (Accordion Toggle Bar) -->
                <div class="accordion-header px-4 py-3 sm:py-3.5 flex items-center justify-between gap-3 cursor-pointer select-none hover:bg-slate-50/80 transition">
                  <!-- Info Kiri: Nomor & Nama Peserta -->
                  <div class="min-w-0 flex items-center gap-2.5 sm:gap-3 flex-1">
                    <span class="w-6 h-6 sm:w-7 sm:h-7 rounded-lg bg-primary-100 text-primary-800 font-mono font-black text-xs flex items-center justify-center shrink-0">
                      ${idx + 1}
                    </span>
                    <div class="min-w-0">
                      <span class="text-xs font-mono font-black text-primary-700 block leading-tight">
                        ${a.nomor_peserta || "-"}
                      </span>
                      <span class="text-sm font-bold text-slate-900 block truncate leading-tight mt-0.5">
                        ${a.nama}
                      </span>
                    </div>
                    ${a.status_hadir === "hadir" ? '<span class="hidden sm:inline-block px-2 py-0.5 rounded-full bg-blue-100 text-blue-800 text-[10px] font-bold shrink-0">✓ Hadir</span>' : ""}
                  </div>

                  <!-- Tombol Kanan: Unduh ID Card & Panah Accordion -->
                  <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
                    <button
                      type="button"
                      class="btn-unduh-idcard inline-flex items-center gap-1.5 px-3 py-1.5 bg-primary-600 hover:bg-primary-700 text-white text-xs font-bold rounded-xl transition shadow-2xs active:scale-95 cursor-pointer"
                      data-index="${idx}"
                      title="Unduh ID Card Lengkap (QR + Kode Akses)"
                    >
                      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                      </svg>
                      <span class="hidden sm:inline">Unduh ID Card</span>
                      <span class="sm:hidden">Unduh</span>
                    </button>

                    <button
                      type="button"
                      class="btn-toggle-arrow w-8 h-8 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center transition cursor-pointer"
                      aria-label="Tampilkan / Sembunyikan ID Card"
                    >
                      <svg class="w-4 h-4 transition-transform duration-200 chevron-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                      </svg>
                    </button>
                  </div>
                </div>

                <!-- Accordion Body: Tampilan ID Card Fisik yang Persis dengan Hasil Unduhan -->
                <div class="accordion-body hidden border-t border-slate-100 p-4 sm:p-5 bg-slate-50/70">
                  ${
                    qrUrl
                      ? `
                    <div class="idcard-box max-w-[320px] mx-auto bg-white rounded-2xl border-2 border-slate-200 overflow-hidden shadow-md text-center">
                      <!-- Header Kartu -->
                      <div class="bg-[#06305d] text-white py-3 px-4">
                        <span class="inline-block px-2.5 py-0.5 bg-amber-400 text-slate-900 rounded-full text-[9px] font-black uppercase tracking-wider mb-1">
                          FAMILY CAMP
                        </span>
                        <h3 class="text-xs font-black tracking-wider text-white">ID CARD PESERTA</h3>
                        <p class="text-[9px] text-sky-200 font-medium">Muslim Scene EvenScan</p>
                      </div>

                      <!-- Konten Kartu -->
                      <div class="p-4 space-y-3">
                        <!-- QR Code Box -->
                        <div class="p-2.5 bg-slate-50 rounded-xl border border-slate-200 inline-block shadow-2xs">
                          <img src="${qrUrl}" alt="QR ${a.nama}" class="w-36 h-36 object-contain mx-auto" />
                        </div>

                        <!-- Data Peserta -->
                        <div>
                          <span class="inline-block px-2.5 py-0.5 bg-primary-50 text-primary-700 font-mono font-black text-xs rounded-md border border-primary-200">
                            ${a.nomor_peserta || "-"}
                          </span>
                          <h4 class="text-base font-extrabold text-slate-900 mt-1.5 leading-tight">${a.nama}</h4>
                          <p class="text-[11px] text-slate-500 mt-0.5 font-medium">${detailsText}</p>
                        </div>

                        <!-- Box Kode Akses (Untuk Input Manual Panitia) -->
                        <div class="p-2.5 rounded-xl bg-amber-50 border border-amber-200 text-amber-950">
                          <span class="text-[9px] font-extrabold text-amber-800 uppercase tracking-wider block">
                            KODE AKSES MANUAL (PANITIA)
                          </span>
                          <span class="text-base font-black font-mono text-amber-950 tracking-wider block mt-0.5">
                            ${kodeAkses || "-"}
                          </span>
                          <span class="text-[9px] text-amber-800/80 block mt-0.5 leading-tight">
                            Gunakan jika scan QR terkendala di lokasi
                          </span>
                        </div>

                        <!-- Sesi Badges -->
                        <div class="pt-2 border-t border-slate-100 space-y-1.5">
                          <div class="flex flex-wrap justify-center gap-1">${sesiBadges}</div>
                          ${noJatah ? '<p class="text-[10px] text-amber-700 font-medium">🍼 Anak usia 1-5 th gratis (tanpa jatah makan)</p>' : '<p class="text-[10px] text-slate-400">QR berlaku untuk check-in & pengambilan konsumsi</p>'}
                        </div>
                      </div>
                    </div>
                  `
                      : `
                    <div class="text-center py-6 text-slate-400 text-xs font-medium">
                      QR Code sedang diproses panitia...
                    </div>
                  `
                  }
                </div>
              </div>
            `;
          })
          .join("");

        return heading + `<div class="space-y-2.5">${rows}</div>`;
      }

      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const val = input.value.trim();
        if (!val) {
          showToast(
            "Masukkan kode akses / token pembayaran / nomor WhatsApp PIC Anda.",
          );
          input.focus();
          return;
        }

        const isPhone = /^[0-9+\s-]+$/.test(val);
        const isToken = !isPhone;
        const query = isToken
          ? `token=${encodeURIComponent(val)}`
          : `wa=${encodeURIComponent(val)}`;

        const newUrl = new URL(window.location.href);
        newUrl.search = "";
        newUrl.searchParams.set(isToken ? "token" : "wa", val);
        window.history.pushState({}, "", newUrl.toString());

        fetchGroup(query, isToken);
      });

      // Auto-search dari parameter URL
      const params = new URLSearchParams(window.location.search);
      const tokenParam = params.get("token");
      const waParam = params.get("wa");
      if (tokenParam) {
        input.value = tokenParam;
        fetchGroup(`token=${encodeURIComponent(tokenParam)}`, true);
      } else if (waParam) {
        input.value = waParam;
        fetchGroup(`wa=${encodeURIComponent(waParam)}`, false);
      }
    }

    document.addEventListener("astro:page-load", initStatusPage);
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initStatusPage);
    } else {
      initStatusPage();
    }
  </script>
</Layout>
